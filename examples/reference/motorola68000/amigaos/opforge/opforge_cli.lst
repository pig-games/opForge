----                             1858  
----                             1859  ; The default demo program currently uses only the same first five character
----                             1860  ; classes consumed by vm_char_class_matches in tokenizer_runtime_utils.rs.
----    EQU 0001                 1861  TK_CLASS_WHITESPACE             = 1
----    EQU 0002                 1862  TK_CLASS_IDENTIFIER_START       = 2
----    EQU 0003                 1863  TK_CLASS_IDENTIFIER_CONTINUE    = 3
----    EQU 0004                 1864  TK_CLASS_DIGIT                  = 4
----    EQU 0005                 1865  TK_CLASS_QUOTE                  = 5
----                             1866  
----                             1867  ; Program-counter labels for demoProgram. These offsets intentionally match the
----                             1868  ; little-endian jump targets emitted by the Rust builder default loop.
----    EQU 0000                 1869  DEMO_PC_READ_CHAR               = 0
----    EQU 0024                 1870  DEMO_PC_SCAN_SYMBOL             = 36
----    EQU 002A                 1871  DEMO_PC_SKIP_WHITESPACE         = 42
----    EQU 0030                 1872  DEMO_PC_SCAN_IDENTIFIER         = 48
----    EQU 0036                 1873  DEMO_PC_SCAN_NUMBER             = 54
----    EQU 003C                 1874  DEMO_PC_SCAN_STRING             = 60
----    EQU 0042                 1875  DEMO_PC_FINISH                  = 66
----                             1876  
----    EQU 0014                 1877  TOKEN_RECORD_SIZE               = 20
----    EQU 0400                 1878  SOURCE_BUFFER_CAPACITY          = 1024
----    EQU 0040                 1879  TOKEN_BUFFER_CAPACITY           = 64
----    EQU 0400                 1880  SCRATCH_BUFFER_CAPACITY         = 1024
----    EQU 0800                 1881  TOKVM_DEFAULT_MAX_STEPS_PER_LINE = 2048
----                             1882  
----                             1883  ; The fixed capacities above intentionally match the AmigaOS host harness so the
----                             1884  ; native VM and the CLI/report layer agree on how much source, token, and scratch
----                             1885  ; state can be exchanged without any additional negotiation structure.
----                             1886  
----                             1887  ; tokvm_run_68000 local frame layout.
----                             1888  ;
----                             1889  ; Call ABI:
----                             1890  ; - A0 / D0: source buffer pointer and source byte length
----                             1891  ; - A1 / D1: token buffer pointer and token capacity in records
----                             1892  ; - A2 / D2: scratch buffer pointer and scratch capacity in bytes
----                             1893  ; - A3 / D3: tokenizer bytecode pointer and program length in bytes
----                             1894  ;
----                             1895  ; Return ABI:
----                             1896  ; - D0: TK_STATUS_*
----                             1897  ; - D1: emitted token count
----                             1898  ; - D2: final source cursor
----                             1899  ; - D3: scratch bytes committed into lexemeScratch
----    EQU 0000                 1900  LOCAL_CURRENT_BYTE              = 0
----    EQU 0004                 1901  LOCAL_PENDING_KIND              = 4
----    EQU 0008                 1902  LOCAL_PENDING_START             = 8
----    EQU 000C                 1903  LOCAL_PENDING_END               = 12
----    EQU 0010                 1904  LOCAL_PENDING_LEX_LEN           = 16
----    EQU 0014                 1905  LOCAL_TEMP_U32                  = 20
----    EQU 0018                 1906  LOCAL_PROGRAM_COUNTER           = 24
----    EQU 001C                 1907  LOCAL_STEP_COUNT                = 28
----    EQU 0020                 1908  LOCAL_STEP_LIMIT                = 32
----    EQU 0024                 1909  LOCAL_SIZE                      = 36
----                             1910  
