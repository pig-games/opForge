----                             2438    ; [section code]
----                             2439  ; ---------------------------------------------------------------------------  ; [section code]
----                             2440  ; Native token record staging and commit.  ; [section code]
----                             2441  ;  ; [section code]
----                             2442  ; Each committed record is 20 bytes in tokenBuffer:  ; [section code]
----                             2443  ; - word 0: token kind code  ; [section code]
----                             2444  ; - long 4: 1-based start column  ; [section code]
----                             2445  ; - long 8: 1-based end column  ; [section code]
----                             2446  ; - long 12: lexemeScratch offset  ; [section code]
----                             2447  ; - long 16: lexeme length in bytes  ; [section code]
----                             2448  ;  ; [section code]
----                             2449  ; This is the compact native surface that the asm tests decode back into the  ; [section code]
----                             2450  ; OPFORGE-TOKVM 1 report format.  ; [section code]
----                             2451  ; ---------------------------------------------------------------------------  ; [section code]
----                             2452    ; [section code]
----                             2453  tokvmCommitPendingToken  ; [section code]
10BE    B2 85                    2454          CMP.L D5, D1  ; token_count < token_capacity  ; [section code]
10C0    64 00 00 56              2455          BCC tokvmPendingTokenOverflow  ; [section code]
10C4    20 03                    2456          MOVE.L D3, D0  ; scratch_used + pending_len must stay within scratch_capacity  ; [section code]
10C6    D0 AA 00 10              2457          ADD.L LOCAL_PENDING_LEX_LEN(A2), D0  ; [section code]
10CA    B0 86                    2458          CMP.L D6, D0  ; [section code]
10CC    62 00 00 52              2459          BHI tokvmPendingLexemeOverflow  ; [section code]
10D0    20 01                    2460          MOVE.L D1, D0  ; compute record_index * TOKEN_RECORD_SIZE without a MUL dependency  ; [section code]
10D2    D0 80                    2461          ADD.L D0, D0  ; *2  ; [section code]
10D4    20 40                    2462          MOVEA.L D0, A0  ; [section code]
10D6    D0 80                    2463          ADD.L D0, D0  ; *4  ; [section code]
10D8    D0 80                    2464          ADD.L D0, D0  ; *8  ; [section code]
10DA    D0 80                    2465          ADD.L D0, D0  ; *16  ; [section code]
10DC    D1 C0                    2466          ADDA.L D0, A0  ; *18  ; [section code]
10DE    20 01                    2467          MOVE.L D1, D0  ; [section code]
10E0    D0 80                    2468          ADD.L D0, D0  ; +2 => *20 byte stride  ; [section code]
10E2    D1 C0                    2469          ADDA.L D0, A0  ; [section code]
10E4    22 4D                    2470          MOVEA.L A5, A1  ; [section code]
10E6    D3 C8                    2471          ADDA.L A0, A1  ; [section code]
10E8    32 AA 00 04              2472          MOVE.W LOCAL_PENDING_KIND(A2), (A1)  ; field 0: token kind code  ; [section code]
10EC    42 69 00 02              2473          CLR.W 2(A1)  ; [section code]
10F0    20 2A 00 08              2474          MOVE.L LOCAL_PENDING_START(A2), D0  ; field 4: 1-based start column  ; [section code]
10F4    52 80                    2475          ADDQ.L #1, D0  ; [section code]
10F6    23 40 00 04              2476          MOVE.L D0, 4(A1)  ; [section code]
10FA    20 2A 00 0C              2477          MOVE.L LOCAL_PENDING_END(A2), D0  ; field 8: 1-based end column  ; [section code]
10FE    52 80                    2478          ADDQ.L #1, D0  ; [section code]
1100    23 40 00 08              2479          MOVE.L D0, 8(A1)  ; [section code]
1104    23 43 00 0C              2480          MOVE.L D3, 12(A1)  ; field 12: lexeme offset into scratch  ; [section code]
1108    23 6A 00 10 00 10        2481          MOVE.L LOCAL_PENDING_LEX_LEN(A2), 16(A1)  ; field 16: lexeme length in bytes  ; [section code]
110E    52 81                    2482          ADDQ.L #1, D1  ; [section code]
1110    D6 AA 00 10              2483          ADD.L LOCAL_PENDING_LEX_LEN(A2), D3  ; [section code]
1114    70 00                    2484          MOVEQ #TK_STATUS_SUCCESS, D0  ; [section code]
1116    4E 75                    2485          RTS  ; [section code]
----                             2486    ; [section code]
----                             2487  ; Overflow exits report the start column of the token that could not be fully  ; [section code]
----                             2488  ; materialized. This matches the Rust-side behavior of attributing capacity  ; [section code]
----                             2489  ; failures to the token currently being scanned rather than the following byte.  ; [section code]
----                             2490  tokvmPendingTokenOverflow  ; [section code]
1118    24 2A 00 08              2491          MOVE.L LOCAL_PENDING_START(A2), D2  ; [section code]
111C    70 02                    2492          MOVEQ #TK_STATUS_TOKEN_OVERFLOW, D0  ; [section code]
111E    4E 75                    2493          RTS  ; [section code]
----                             2494    ; [section code]
----                             2495  tokvmPendingLexemeOverflow  ; [section code]
1120    24 2A 00 08              2496          MOVE.L LOCAL_PENDING_START(A2), D2  ; [section code]
1124    70 03                    2497          MOVEQ #TK_STATUS_LEXEME_OVERFLOW, D0  ; [section code]
1126    4E 75                    2498          RTS  ; [section code]
----                             2499    ; [section code]
----                             2500  ; Stage a fixed lexeme literal from the static data table into scratch.  ; [section code]
----                             2501  ; This is used for punctuation and operator tokens whose lexeme spelling is  ; [section code]
----                             2502  ; known upfront and does not need to be copied from the source buffer.  ; [section code]
----                             2503  tokvmStageFixedLexeme  ; [section code]
1128    25 40 00 10              2504          MOVE.L D0, LOCAL_PENDING_LEX_LEN(A2)  ; fixed operator/punctuation lexeme length from the inline template string  ; [section code]
112C    20 03                    2505          MOVE.L D3, D0  ; [section code]
112E    D0 AA 00 10              2506          ADD.L LOCAL_PENDING_LEX_LEN(A2), D0  ; [section code]
1132    B0 86                    2507          CMP.L D6, D0  ; [section code]
1134    62 00 FF EA              2508          BHI tokvmPendingLexemeOverflow  ; [section code]
1138    22 4E                    2509          MOVEA.L A6, A1  ; [section code]
113A    D3 C3                    2510          ADDA.L D3, A1  ; [section code]
113C    20 2A 00 10              2511          MOVE.L LOCAL_PENDING_LEX_LEN(A2), D0  ; [section code]
----                             2512  tokvmStageFixedLexemeLoop  ; [section code]
1140    4A 80                    2513          TST.L D0  ; [section code]
1142    67 00 00 0A              2514          BEQ tokvmStageFixedLexemeDone  ; [section code]
1146    12 D8                    2515          MOVE.B (A0)+, (A1)+  ; copy the canonical lexeme bytes that Rust would expose in PortableToken text/raw  ; [section code]
1148    53 80                    2516          SUBQ.L #1, D0  ; [section code]
114A    60 00 FF F4              2517          BRA tokvmStageFixedLexemeLoop  ; [section code]
----                             2518    ; [section code]
----                             2519  tokvmStageFixedLexemeDone  ; [section code]
114E    70 00                    2520          MOVEQ #TK_STATUS_SUCCESS, D0  ; [section code]
1150    4E 75                    2521          RTS  ; [section code]
----                             2522    ; [section code]
----                             2523  ; ---------------------------------------------------------------------------  ; [section code]
----                             2524  ; Scanner helpers.  ; [section code]
----                             2525  ;  ; [section code]
----                             2526  ; These are the native counterparts of the Rust tokenizer helper routines in  ; [section code]
----                             2527  ; tokenizer_runtime_utils.rs. Each helper advances D2 as the live source cursor,  ; [section code]
----                             2528  ; populates LOCAL_PENDING_* metadata, stages lexeme bytes into the scratch  ; [section code]
----                             2529  ; buffer, then commits a token record.  ; [section code]
----                             2530  ; ---------------------------------------------------------------------------  ; [section code]
----                             2531    ; [section code]
