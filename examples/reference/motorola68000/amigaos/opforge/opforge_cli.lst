----                             1936          .section code, kind=code  ; [section code]
----                             1937    ; [section code]
----                             1938  ; ---------------------------------------------------------------------------  ; [section code]
----                             1939  ; Native tokenizer VM interpreter.  ; [section code]
----                             1940  ;  ; [section code]
----                             1941  ; This interpreter executes the tokenizer bytecode against one line-buffer-backed  ; [section code]
----                             1942  ; input stream. Its control flow mirrors the Rust tokenizer VM loop in  ; [section code]
----                             1943  ; crates/opforge-vm/src/runtime_model_core.rs:  ; [section code]
----                             1944  ; - validate arguments and stream constraints  ; [section code]
----                             1945  ; - keep source cursor in D2 and program counter in A0  ; [section code]
----                             1946  ; - decode opcodes from the bytecode stream in A3..A3+D7  ; [section code]
----                             1947  ; - dispatch scan/predicate helpers that mirror tokenizer_runtime_utils.rs  ; [section code]
----                             1948  ; - emit compact native token records into the caller-provided token buffer  ; [section code]
----                             1949  ; ---------------------------------------------------------------------------  ; [section code]
----                             1950    ; [section code]
----                             1951  tokvm_set_step_budget_68000  ; [section code]
