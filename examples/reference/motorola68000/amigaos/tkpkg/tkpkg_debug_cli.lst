----                             2444    ; [section code]
----                             2445  ; ---------------------------------------------------------------------------  ; [section code]
----                             2446  ; Native token record staging and commit.  ; [section code]
----                             2447  ;  ; [section code]
----                             2448  ; Each committed record is 20 bytes in tokenBuffer:  ; [section code]
----                             2449  ; - word 0: token kind code  ; [section code]
----                             2450  ; - long 4: 1-based start column  ; [section code]
----                             2451  ; - long 8: 1-based end column  ; [section code]
----                             2452  ; - long 12: lexemeScratch offset  ; [section code]
----                             2453  ; - long 16: lexeme length in bytes  ; [section code]
----                             2454  ;  ; [section code]
----                             2455  ; This is the compact native surface that the asm tests decode back into the  ; [section code]
----                             2456  ; OPFORGE-TOKVM 1 report format.  ; [section code]
----                             2457  ; ---------------------------------------------------------------------------  ; [section code]
----                             2458    ; [section code]
----                             2459  tokvmCommitPendingToken  ; [section code]
10BE    B2 85                    2460          CMP.L D5, D1  ; token_count < token_capacity  ; [section code]
10C0    64 00 00 56              2461          BCC tokvmPendingTokenOverflow  ; [section code]
10C4    20 03                    2462          MOVE.L D3, D0  ; scratch_used + pending_len must stay within scratch_capacity  ; [section code]
10C6    D0 AA 00 10              2463          ADD.L LOCAL_PENDING_LEX_LEN(A2), D0  ; [section code]
10CA    B0 86                    2464          CMP.L D6, D0  ; [section code]
10CC    62 00 00 52              2465          BHI tokvmPendingLexemeOverflow  ; [section code]
10D0    20 01                    2466          MOVE.L D1, D0  ; compute record_index * TOKEN_RECORD_SIZE without a MUL dependency  ; [section code]
10D2    D0 80                    2467          ADD.L D0, D0  ; *2  ; [section code]
10D4    20 40                    2468          MOVEA.L D0, A0  ; [section code]
10D6    D0 80                    2469          ADD.L D0, D0  ; *4  ; [section code]
10D8    D0 80                    2470          ADD.L D0, D0  ; *8  ; [section code]
10DA    D0 80                    2471          ADD.L D0, D0  ; *16  ; [section code]
10DC    D1 C0                    2472          ADDA.L D0, A0  ; *18  ; [section code]
10DE    20 01                    2473          MOVE.L D1, D0  ; [section code]
10E0    D0 80                    2474          ADD.L D0, D0  ; +2 => *20 byte stride  ; [section code]
10E2    D1 C0                    2475          ADDA.L D0, A0  ; [section code]
10E4    22 4D                    2476          MOVEA.L A5, A1  ; [section code]
10E6    D3 C8                    2477          ADDA.L A0, A1  ; [section code]
10E8    32 AA 00 04              2478          MOVE.W LOCAL_PENDING_KIND(A2), (A1)  ; field 0: token kind code  ; [section code]
10EC    42 69 00 02              2479          CLR.W 2(A1)  ; [section code]
10F0    20 2A 00 08              2480          MOVE.L LOCAL_PENDING_START(A2), D0  ; field 4: 1-based start column  ; [section code]
10F4    52 80                    2481          ADDQ.L #1, D0  ; [section code]
10F6    23 40 00 04              2482          MOVE.L D0, 4(A1)  ; [section code]
10FA    20 2A 00 0C              2483          MOVE.L LOCAL_PENDING_END(A2), D0  ; field 8: 1-based end column  ; [section code]
10FE    52 80                    2484          ADDQ.L #1, D0  ; [section code]
1100    23 40 00 08              2485          MOVE.L D0, 8(A1)  ; [section code]
1104    23 43 00 0C              2486          MOVE.L D3, 12(A1)  ; field 12: lexeme offset into scratch  ; [section code]
1108    23 6A 00 10 00 10        2487          MOVE.L LOCAL_PENDING_LEX_LEN(A2), 16(A1)  ; field 16: lexeme length in bytes  ; [section code]
110E    52 81                    2488          ADDQ.L #1, D1  ; [section code]
1110    D6 AA 00 10              2489          ADD.L LOCAL_PENDING_LEX_LEN(A2), D3  ; [section code]
1114    70 00                    2490          MOVEQ #TK_STATUS_SUCCESS, D0  ; [section code]
1116    4E 75                    2491          RTS  ; [section code]
----                             2492    ; [section code]
----                             2493  ; Overflow exits report the start column of the token that could not be fully  ; [section code]
----                             2494  ; materialized. This matches the Rust-side behavior of attributing capacity  ; [section code]
----                             2495  ; failures to the token currently being scanned rather than the following byte.  ; [section code]
----                             2496  tokvmPendingTokenOverflow  ; [section code]
1118    24 2A 00 08              2497          MOVE.L LOCAL_PENDING_START(A2), D2  ; [section code]
111C    70 02                    2498          MOVEQ #TK_STATUS_TOKEN_OVERFLOW, D0  ; [section code]
111E    4E 75                    2499          RTS  ; [section code]
----                             2500    ; [section code]
