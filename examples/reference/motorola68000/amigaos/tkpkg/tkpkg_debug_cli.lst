1310    64 00 00 56              2758          BCC tokvmPendingTokenOverflow  ; [section code]
1314    20 03                    2759          MOVE.L D3, D0  ; scratch_used + pending_len must stay within scratch_capacity  ; [section code]
1316    D0 AA 00 10              2760          ADD.L LOCAL_PENDING_LEX_LEN(A2), D0  ; [section code]
