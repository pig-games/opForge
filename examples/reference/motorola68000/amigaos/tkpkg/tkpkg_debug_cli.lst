----                             3457  ; The emit* helpers encode the same little-endian jump-target format produced by  ; [section data]
----                             3458  ; Rust's default_family_tokenizer_vm_program_bytes(). Keep demoProgram and the  ; [section data]
----                             3459  ; DEMO_PC_* offsets together so the control-flow map stays readable.  ; [section data]
----                             3460    ; [section data]
----                             3461    ; [section data]
----                             3462    ; [section data]
----                             3463    ; [section data]
----                             3464  ; Default tokenizer VM loop for this native example.  ; [section data]
----                             3465  ; This intentionally mirrors crates/opforge-vm/src/builder.rs:  ; [section data]
----                             3466  ; - ReadChar  ; [section data]
----                             3467  ; - if EOL -> End  ; [section data]
----                             3468  ; - if whitespace -> Advance and loop  ; [section data]
----                             3469  ; - if '.' or symbol-leading punctuation -> ScanSymbol  ; [section data]
----                             3470  ; - if identifier-start -> ScanIdentifier  ; [section data]
----                             3471  ; - if digit -> ScanNumber  ; [section data]
----                             3472  ; - if quote -> ScanString  ; [section data]
----                             3473  ;  ; [section data]
----                             3474  ; The bytecode below is the readable assembler mirror of builder.rs  ; [section data]
----                             3475  ; default_family_tokenizer_vm_program_bytes(): read char, branch by class, then loop.  ; [section data]
----                             3476  demoProgram  ; [section data]
----                             3477  demoReadChar  ; [section data]
0278    01                       3478          .byte TK_OPCODE_READ_CHAR  ; [section data]
----                             3479          .block  ; [section data]
----                             3480          ; Macros keep the demo bytecode readable without obscuring the exact byte  ; [section data]
----                             3481          ; sequence that the Rust builder would emit.  ; [section data]
0279    08                       3482          .byte TK_OPCODE_JUMP_IF_EOL  ; [section data]
----                             3483          .block  ; [section data]
----                             3484          ; Keep jump targets readable in source while still emitting the same  ; [section data]
----                             3485          ; little-endian u32 layout as builder.rs and the Rust VM loader expect.  ; [section data]
027A    42                       3486          .byte (DEMO_PC_FINISH) & $ff  ; [section data]
027B    00                       3487          .byte ((DEMO_PC_FINISH) >> 8) & $ff  ; [section data]
027C    00                       3488          .byte ((DEMO_PC_FINISH) >> 16) & $ff  ; [section data]
027D    00                       3489          .byte ((DEMO_PC_FINISH) >> 24) & $ff  ; [section data]
----                             3490          .endblock  ; [section data]
----                             3491          .endblock  ; [section data]
----                             3492          .block  ; [section data]
