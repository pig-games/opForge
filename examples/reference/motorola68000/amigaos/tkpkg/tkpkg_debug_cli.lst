----                             1849  
----                             1850  ; The default demo program currently uses only the same first five character
----                             1851  ; classes consumed by vm_char_class_matches in tokenizer_runtime_utils.rs.
----    EQU 0001                 1852  TK_CLASS_WHITESPACE             = 1
----    EQU 0002                 1853  TK_CLASS_IDENTIFIER_START       = 2
----    EQU 0003                 1854  TK_CLASS_IDENTIFIER_CONTINUE    = 3
----    EQU 0004                 1855  TK_CLASS_DIGIT                  = 4
----    EQU 0005                 1856  TK_CLASS_QUOTE                  = 5
----                             1857  
----                             1858  ; Program-counter labels for demoProgram. These offsets intentionally match the
----                             1859  ; little-endian jump targets emitted by the Rust builder default loop.
----    EQU 0000                 1860  DEMO_PC_READ_CHAR               = 0
----    EQU 0024                 1861  DEMO_PC_SCAN_SYMBOL             = 36
----    EQU 002A                 1862  DEMO_PC_SKIP_WHITESPACE         = 42
----    EQU 0030                 1863  DEMO_PC_SCAN_IDENTIFIER         = 48
----    EQU 0036                 1864  DEMO_PC_SCAN_NUMBER             = 54
----    EQU 003C                 1865  DEMO_PC_SCAN_STRING             = 60
----    EQU 0042                 1866  DEMO_PC_FINISH                  = 66
----                             1867  
----    EQU 0014                 1868  TOKEN_RECORD_SIZE               = 20
----    EQU 0400                 1869  SOURCE_BUFFER_CAPACITY          = 1024
----    EQU 0040                 1870  TOKEN_BUFFER_CAPACITY           = 64
----    EQU 0400                 1871  SCRATCH_BUFFER_CAPACITY         = 1024
----    EQU 0800                 1872  TOKVM_DEFAULT_MAX_STEPS_PER_LINE = 2048
----                             1873  
----                             1874  ; The fixed capacities above intentionally match the AmigaOS host harness so the
----                             1875  ; native VM and the CLI/report layer agree on how much source, token, and scratch
----                             1876  ; state can be exchanged without any additional negotiation structure.
----                             1877  
----                             1878  ; tokvm_run_68000 local frame layout.
----                             1879  ;
----                             1880  ; Call ABI:
----                             1881  ; - A0 / D0: source buffer pointer and source byte length
----                             1882  ; - A1 / D1: token buffer pointer and token capacity in records
----                             1883  ; - A2 / D2: scratch buffer pointer and scratch capacity in bytes
----                             1884  ; - A3 / D3: tokenizer bytecode pointer and program length in bytes
----                             1885  ;
----                             1886  ; Return ABI:
----                             1887  ; - D0: TK_STATUS_*
----                             1888  ; - D1: emitted token count
----                             1889  ; - D2: final source cursor
----                             1890  ; - D3: scratch bytes committed into lexemeScratch
----    EQU 0000                 1891  LOCAL_CURRENT_BYTE              = 0
----    EQU 0004                 1892  LOCAL_PENDING_KIND              = 4
----    EQU 0008                 1893  LOCAL_PENDING_START             = 8
----    EQU 000C                 1894  LOCAL_PENDING_END               = 12
----    EQU 0010                 1895  LOCAL_PENDING_LEX_LEN           = 16
----    EQU 0014                 1896  LOCAL_TEMP_U32                  = 20
----    EQU 0018                 1897  LOCAL_PROGRAM_COUNTER           = 24
----    EQU 001C                 1898  LOCAL_STEP_COUNT                = 28
----    EQU 0020                 1899  LOCAL_STEP_LIMIT                = 32
----    EQU 0024                 1900  LOCAL_SIZE                      = 36
