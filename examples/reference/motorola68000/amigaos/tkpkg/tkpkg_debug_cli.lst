----    EQU 2000                 5973  DEBUG_CLI_MANIFEST_BUFFER_CAPACITY = 8192
----    EQU 0FFC                 5974  DEBUG_CLI_MAX_LINE_BYTES        = LAST_ERROR_BUFFER_CAPACITY - 4
----    EQU 0001                 5975  DEBUG_CLI_FILE_MODE_SINGLE      = 1
----    EQU 0002                 5976  DEBUG_CLI_FILE_MODE_MANIFEST    = 2
