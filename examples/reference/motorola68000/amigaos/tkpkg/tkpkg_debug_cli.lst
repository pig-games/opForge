----                             5549  ; Thin AmigaOS CLI smoke wrapper for the package-backed tkpkg runtime.
----                             5550  ;
----                             5551  ; This slice exercises init, load_package, set_pipeline, tokenize_line, and
----                             5552  ; last_error without folding CLI/report concerns into the core runtime modules.
----                             5553  
----                             5554          .module main
----                             5555          .cpu 68020
----                             5556          .use tkpkg.amigaos.abi (ENTRY_ORD_INIT, ENTRY_ORD_LOAD_PACKAGE)
