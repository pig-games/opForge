----                             2528          ; Identifier scan is the native mirror of vm_scan_identifier_token():  ; [section code]
----                             2529          ; walk identifier-continue bytes, lowercase ASCII letters for the demo  ; [section code]
----                             2530          ; policy, then emit one identifier record backed by scratch bytes.  ; [section code]
10EC    25 42 00 08              2531          MOVE.L D2, LOCAL_PENDING_START(A2)  ; [section code]
10F0    42 AA 00 10              2532          CLR.L LOCAL_PENDING_LEX_LEN(A2)  ; [section code]
10F4    20 4E                    2533          MOVEA.L A6, A0  ; [section code]
10F6    D1 C3                    2534          ADDA.L D3, A0  ; [section code]
