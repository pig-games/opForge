----                             2433  ; ---------------------------------------------------------------------------  ; [section code]
----                             2434  ; Native token record staging and commit.  ; [section code]
----                             2435  ;  ; [section code]
----                             2436  ; Each committed record is 20 bytes in tokenBuffer:  ; [section code]
----                             2437  ; - word 0: token kind code  ; [section code]
----                             2438  ; - long 4: 1-based start column  ; [section code]
----                             2439  ; - long 8: 1-based end column  ; [section code]
----                             2440  ; - long 12: lexemeScratch offset  ; [section code]
----                             2441  ; - long 16: lexeme length in bytes  ; [section code]
----                             2442  ;  ; [section code]
----                             2443  ; This is the compact native surface that the asm tests decode back into the  ; [section code]
----                             2444  ; OPFORGE-TOKVM 1 report format.  ; [section code]
----                             2445  ; ---------------------------------------------------------------------------  ; [section code]
----                             2446    ; [section code]
----                             2447  tokvmCommitPendingToken  ; [section code]
1056    B2 85                    2448          CMP.L D5, D1  ; token_count < token_capacity  ; [section code]
1058    64 00 00 56              2449          BCC tokvmPendingTokenOverflow  ; [section code]
105C    20 03                    2450          MOVE.L D3, D0  ; scratch_used + pending_len must stay within scratch_capacity  ; [section code]
105E    D0 AA 00 10              2451          ADD.L LOCAL_PENDING_LEX_LEN(A2), D0  ; [section code]
1062    B0 86                    2452          CMP.L D6, D0  ; [section code]
1064    62 00 00 52              2453          BHI tokvmPendingLexemeOverflow  ; [section code]
1068    20 01                    2454          MOVE.L D1, D0  ; compute record_index * TOKEN_RECORD_SIZE without a MUL dependency  ; [section code]
106A    D0 80                    2455          ADD.L D0, D0  ; *2  ; [section code]
106C    20 40                    2456          MOVEA.L D0, A0  ; [section code]
106E    D0 80                    2457          ADD.L D0, D0  ; *4  ; [section code]
1070    D0 80                    2458          ADD.L D0, D0  ; *8  ; [section code]
1072    D0 80                    2459          ADD.L D0, D0  ; *16  ; [section code]
1074    D1 C0                    2460          ADDA.L D0, A0  ; *18  ; [section code]
1076    20 01                    2461          MOVE.L D1, D0  ; [section code]
1078    D0 80                    2462          ADD.L D0, D0  ; +2 => *20 byte stride  ; [section code]
107A    D1 C0                    2463          ADDA.L D0, A0  ; [section code]
107C    22 4D                    2464          MOVEA.L A5, A1  ; [section code]
107E    D3 C8                    2465          ADDA.L A0, A1  ; [section code]
1080    32 AA 00 04              2466          MOVE.W LOCAL_PENDING_KIND(A2), (A1)  ; field 0: token kind code  ; [section code]
1084    42 69 00 02              2467          CLR.W 2(A1)  ; [section code]
1088    20 2A 00 08              2468          MOVE.L LOCAL_PENDING_START(A2), D0  ; field 4: 1-based start column  ; [section code]
108C    52 80                    2469          ADDQ.L #1, D0  ; [section code]
108E    23 40 00 04              2470          MOVE.L D0, 4(A1)  ; [section code]
1092    20 2A 00 0C              2471          MOVE.L LOCAL_PENDING_END(A2), D0  ; field 8: 1-based end column  ; [section code]
1096    52 80                    2472          ADDQ.L #1, D0  ; [section code]
1098    23 40 00 08              2473          MOVE.L D0, 8(A1)  ; [section code]
109C    23 43 00 0C              2474          MOVE.L D3, 12(A1)  ; field 12: lexeme offset into scratch  ; [section code]
10A0    23 6A 00 10 00 10        2475          MOVE.L LOCAL_PENDING_LEX_LEN(A2), 16(A1)  ; field 16: lexeme length in bytes  ; [section code]
10A6    52 81                    2476          ADDQ.L #1, D1  ; [section code]
10A8    D6 AA 00 10              2477          ADD.L LOCAL_PENDING_LEX_LEN(A2), D3  ; [section code]
10AC    70 00                    2478          MOVEQ #TK_STATUS_SUCCESS, D0  ; [section code]
10AE    4E 75                    2479          RTS  ; [section code]
