----                             1857  
----                             1858  ; The default demo program currently uses only the same first five character
----                             1859  ; classes consumed by vm_char_class_matches in tokenizer_runtime_utils.rs.
----    EQU 0001                 1860  TK_CLASS_WHITESPACE             = 1
----    EQU 0002                 1861  TK_CLASS_IDENTIFIER_START       = 2
----    EQU 0003                 1862  TK_CLASS_IDENTIFIER_CONTINUE    = 3
----    EQU 0004                 1863  TK_CLASS_DIGIT                  = 4
----    EQU 0005                 1864  TK_CLASS_QUOTE                  = 5
----                             1865  
----                             1866  ; Program-counter labels for demoProgram. These offsets intentionally match the
----                             1867  ; little-endian jump targets emitted by the Rust builder default loop.
----    EQU 0000                 1868  DEMO_PC_READ_CHAR               = 0
----    EQU 0024                 1869  DEMO_PC_SCAN_SYMBOL             = 36
----    EQU 002A                 1870  DEMO_PC_SKIP_WHITESPACE         = 42
----    EQU 0030                 1871  DEMO_PC_SCAN_IDENTIFIER         = 48
----    EQU 0036                 1872  DEMO_PC_SCAN_NUMBER             = 54
----    EQU 003C                 1873  DEMO_PC_SCAN_STRING             = 60
----    EQU 0042                 1874  DEMO_PC_FINISH                  = 66
----                             1875  
----    EQU 0014                 1876  TOKEN_RECORD_SIZE               = 20
----    EQU 0400                 1877  SOURCE_BUFFER_CAPACITY          = 1024
----    EQU 0040                 1878  TOKEN_BUFFER_CAPACITY           = 64
----    EQU 0400                 1879  SCRATCH_BUFFER_CAPACITY         = 1024
----    EQU 0800                 1880  TOKVM_DEFAULT_MAX_STEPS_PER_LINE = 2048
----                             1881  
----                             1882  ; The fixed capacities above intentionally match the AmigaOS host harness so the
----                             1883  ; native VM and the CLI/report layer agree on how much source, token, and scratch
----                             1884  ; state can be exchanged without any additional negotiation structure.
----                             1885  
----                             1886  ; tokvm_run_68000 local frame layout.
----                             1887  ;
----                             1888  ; Call ABI:
----                             1889  ; - A0 / D0: source buffer pointer and source byte length
----                             1890  ; - A1 / D1: token buffer pointer and token capacity in records
----                             1891  ; - A2 / D2: scratch buffer pointer and scratch capacity in bytes
----                             1892  ; - A3 / D3: tokenizer bytecode pointer and program length in bytes
----                             1893  ;
----                             1894  ; Return ABI:
----                             1895  ; - D0: TK_STATUS_*
----                             1896  ; - D1: emitted token count
----                             1897  ; - D2: final source cursor
----                             1898  ; - D3: scratch bytes committed into lexemeScratch
----    EQU 0000                 1899  LOCAL_CURRENT_BYTE              = 0
----    EQU 0004                 1900  LOCAL_PENDING_KIND              = 4
----    EQU 0008                 1901  LOCAL_PENDING_START             = 8
----    EQU 000C                 1902  LOCAL_PENDING_END               = 12
----    EQU 0010                 1903  LOCAL_PENDING_LEX_LEN           = 16
----    EQU 0014                 1904  LOCAL_TEMP_U32                  = 20
----    EQU 0018                 1905  LOCAL_PROGRAM_COUNTER           = 24
----    EQU 001C                 1906  LOCAL_STEP_COUNT                = 28
----    EQU 0020                 1907  LOCAL_STEP_LIMIT                = 32
----    EQU 0024                 1908  LOCAL_SIZE                      = 36
----                             1909  
