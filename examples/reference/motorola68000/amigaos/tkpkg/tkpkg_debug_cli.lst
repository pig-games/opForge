131C    20 01                    2761          MOVE.L D1, D0  ; compute record_index * TOKEN_RECORD_SIZE without a MUL dependency  ; [section code]
131E    D0 80                    2762          ADD.L D0, D0  ; *2  ; [section code]
1320    20 40                    2763          MOVEA.L D0, A0  ; [section code]
1322    D0 80                    2764          ADD.L D0, D0  ; *4  ; [section code]
1324    D0 80                    2765          ADD.L D0, D0  ; *8  ; [section code]
1326    D0 80                    2766          ADD.L D0, D0  ; *16  ; [section code]
1328    D1 C0                    2767          ADDA.L D0, A0  ; *18  ; [section code]
132A    20 01                    2768          MOVE.L D1, D0  ; [section code]
132C    D0 80                    2769          ADD.L D0, D0  ; +2 => *20 byte stride  ; [section code]
132E    D1 C0                    2770          ADDA.L D0, A0  ; [section code]
1330    22 4D                    2771          MOVEA.L A5, A1  ; [section code]
