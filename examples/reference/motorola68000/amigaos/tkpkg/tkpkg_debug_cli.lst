----                             2430  ; ---------------------------------------------------------------------------  ; [section code]
----                             2431  ; Native token record staging and commit.  ; [section code]
----                             2432  ;  ; [section code]
----                             2433  ; Each committed record is 20 bytes in tokenBuffer:  ; [section code]
----                             2434  ; - word 0: token kind code  ; [section code]
----                             2435  ; - long 4: 1-based start column  ; [section code]
----                             2436  ; - long 8: 1-based end column  ; [section code]
----                             2437  ; - long 12: lexemeScratch offset  ; [section code]
----                             2438  ; - long 16: lexeme length in bytes  ; [section code]
----                             2439  ;  ; [section code]
----                             2440  ; This is the compact native surface that the asm tests decode back into the  ; [section code]
----                             2441  ; OPFORGE-TOKVM 1 report format.  ; [section code]
----                             2442  ; ---------------------------------------------------------------------------  ; [section code]
----                             2443    ; [section code]
----                             2444  tokvmCommitPendingToken  ; [section code]
1058    B2 85                    2445          CMP.L D5, D1  ; token_count < token_capacity  ; [section code]
105A    64 00 00 56              2446          BCC tokvmPendingTokenOverflow  ; [section code]
105E    20 03                    2447          MOVE.L D3, D0  ; scratch_used + pending_len must stay within scratch_capacity  ; [section code]
1060    D0 AA 00 10              2448          ADD.L LOCAL_PENDING_LEX_LEN(A2), D0  ; [section code]
1064    B0 86                    2449          CMP.L D6, D0  ; [section code]
1066    62 00 00 52              2450          BHI tokvmPendingLexemeOverflow  ; [section code]
106A    20 01                    2451          MOVE.L D1, D0  ; compute record_index * TOKEN_RECORD_SIZE without a MUL dependency  ; [section code]
106C    D0 80                    2452          ADD.L D0, D0  ; *2  ; [section code]
106E    20 40                    2453          MOVEA.L D0, A0  ; [section code]
1070    D0 80                    2454          ADD.L D0, D0  ; *4  ; [section code]
1072    D0 80                    2455          ADD.L D0, D0  ; *8  ; [section code]
1074    D0 80                    2456          ADD.L D0, D0  ; *16  ; [section code]
1076    D1 C0                    2457          ADDA.L D0, A0  ; *18  ; [section code]
1078    20 01                    2458          MOVE.L D1, D0  ; [section code]
107A    D0 80                    2459          ADD.L D0, D0  ; +2 => *20 byte stride  ; [section code]
107C    D1 C0                    2460          ADDA.L D0, A0  ; [section code]
107E    22 4D                    2461          MOVEA.L A5, A1  ; [section code]
1080    D3 C8                    2462          ADDA.L A0, A1  ; [section code]
1082    32 AA 00 04              2463          MOVE.W LOCAL_PENDING_KIND(A2), (A1)  ; field 0: token kind code  ; [section code]
1086    42 69 00 02              2464          CLR.W 2(A1)  ; [section code]
108A    20 2A 00 08              2465          MOVE.L LOCAL_PENDING_START(A2), D0  ; field 4: 1-based start column  ; [section code]
108E    52 80                    2466          ADDQ.L #1, D0  ; [section code]
1090    23 40 00 04              2467          MOVE.L D0, 4(A1)  ; [section code]
1094    20 2A 00 0C              2468          MOVE.L LOCAL_PENDING_END(A2), D0  ; field 8: 1-based end column  ; [section code]
1098    52 80                    2469          ADDQ.L #1, D0  ; [section code]
109A    23 40 00 08              2470          MOVE.L D0, 8(A1)  ; [section code]
109E    23 43 00 0C              2471          MOVE.L D3, 12(A1)  ; field 12: lexeme offset into scratch  ; [section code]
10A2    23 6A 00 10 00 10        2472          MOVE.L LOCAL_PENDING_LEX_LEN(A2), 16(A1)  ; field 16: lexeme length in bytes  ; [section code]
10A8    52 81                    2473          ADDQ.L #1, D1  ; [section code]
10AA    D6 AA 00 10              2474          ADD.L LOCAL_PENDING_LEX_LEN(A2), D3  ; [section code]
