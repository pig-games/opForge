----                             2237          .section code, kind=code  ; [section code]
----                             2238    ; [section code]
----                             2239  ; ---------------------------------------------------------------------------  ; [section code]
----                             2240  ; Native tokenizer VM interpreter.  ; [section code]
----                             2241  ;  ; [section code]
----                             2242  ; This interpreter executes the tokenizer bytecode against one line-buffer-backed  ; [section code]
----                             2243  ; input stream. Its control flow mirrors the Rust tokenizer VM loop in  ; [section code]
----                             2244  ; crates/opforge-vm/src/runtime_model_core.rs:  ; [section code]
----                             2245  ; - validate arguments and stream constraints  ; [section code]
----                             2246  ; - keep source cursor in D2 and program counter in A0  ; [section code]
----                             2247  ; - decode opcodes from the bytecode stream in A3..A3+D7  ; [section code]
----                             2248  ; - dispatch scan/predicate helpers that mirror tokenizer_runtime_utils.rs  ; [section code]
----                             2249  ; - emit compact native token records into the caller-provided token buffer  ; [section code]
----                             2250  ; ---------------------------------------------------------------------------  ; [section code]
----                             2251    ; [section code]
----                             2252  tokvm_set_step_budget_68000  ; [section code]
