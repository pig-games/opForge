----                             2213          .section code, kind=code  ; [section code]
----                             2214    ; [section code]
----                             2215  ; ---------------------------------------------------------------------------  ; [section code]
----                             2216  ; Native tokenizer VM interpreter.  ; [section code]
----                             2217  ;  ; [section code]
----                             2218  ; This interpreter executes the tokenizer bytecode against one line-buffer-backed  ; [section code]
----                             2219  ; input stream. Its control flow mirrors the Rust tokenizer VM loop in  ; [section code]
----                             2220  ; crates/opforge-vm/src/runtime_model_core.rs:  ; [section code]
----                             2221  ; - validate arguments and stream constraints  ; [section code]
----                             2222  ; - keep source cursor in D2 and program counter in A0  ; [section code]
----                             2223  ; - decode opcodes from the bytecode stream in A3..A3+D7  ; [section code]
----                             2224  ; - dispatch scan/predicate helpers that mirror tokenizer_runtime_utils.rs  ; [section code]
----                             2225  ; - emit compact native token records into the caller-provided token buffer  ; [section code]
----                             2226  ; ---------------------------------------------------------------------------  ; [section code]
----                             2227    ; [section code]
----                             2228  tokvm_set_step_budget_68000  ; [section code]
0DFC    4A 80                    2229          TST.L D0  ; [section code]
0DFE    6E 06                    2230          BGT.S tokvmSetStepBudgetStore  ; [section code]
0E00    20 3C 00 00 08 00        2231          MOVE.L #TOKVM_DEFAULT_MAX_STEPS_PER_LINE, D0  ; [section code]
----                             2232  tokvmSetStepBudgetStore  ; [section code]
0E06    23 C0 00 00 02 4D        2233          MOVE.L D0, tokvmStepBudget  ; [section code]
0E0C    4E 75                    2234          RTS  ; [section code]
----                             2235    ; [section code]
----                             2236  tokvm_set_program_state_table_68000  ; [section code]
0E0E    4A 80                    2237          TST.L D0  ; [section code]
0E10    6E 0A                    2238          BGT.S tokvmSetProgramStateStore  ; [section code]
0E12    41 F9 00 00 02 51        2239          LEA demoStateEntryOffsets, A0  ; [section code]
0E18    70 01                    2240          MOVEQ #1, D0  ; [section code]
0E1A    72 00                    2241          MOVEQ #0, D1  ; [section code]
----                             2242  tokvmSetProgramStateStore  ; [section code]
0E1C    23 C8 00 00 02 55        2243          MOVE.L A0, tokvmProgramStateTablePtr  ; [section code]
0E22    23 C0 00 00 02 59        2244          MOVE.L D0, tokvmProgramStateCount  ; [section code]
0E28    33 C1 00 00 02 5D        2245          MOVE.W D1, tokvmProgramStartState  ; [section code]
0E2E    4E 75                    2246          RTS  ; [section code]
----                             2247    ; [section code]
----                             2248  tokvm_read_last_failure_68000  ; [section code]
0E30    70 00                    2249          MOVEQ #0, D0  ; [section code]
0E32    30 39 00 00 02 5F        2250          MOVE.W tokvmLastFailureKind, D0  ; [section code]
0E38    72 00                    2251          MOVEQ #0, D1  ; [section code]
0E3A    32 39 00 00 02 61        2252          MOVE.W tokvmLastFailureOperand, D1  ; [section code]
0E40    4E 75                    2253          RTS  ; [section code]
