130C    64 00 00 56              2756          BCC tokvmPendingTokenOverflow  ; [section code]
1310    20 03                    2757          MOVE.L D3, D0  ; scratch_used + pending_len must stay within scratch_capacity  ; [section code]
1312    D0 AA 00 10              2758          ADD.L LOCAL_PENDING_LEX_LEN(A2), D0  ; [section code]
1316    B0 86                    2759          CMP.L D6, D0  ; [section code]
