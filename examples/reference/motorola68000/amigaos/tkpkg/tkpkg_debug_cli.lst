----                             2434  ; ---------------------------------------------------------------------------  ; [section code]
----                             2435  ; Native token record staging and commit.  ; [section code]
----                             2436  ;  ; [section code]
----                             2437  ; Each committed record is 20 bytes in tokenBuffer:  ; [section code]
----                             2438  ; - word 0: token kind code  ; [section code]
----                             2439  ; - long 4: 1-based start column  ; [section code]
----                             2440  ; - long 8: 1-based end column  ; [section code]
----                             2441  ; - long 12: lexemeScratch offset  ; [section code]
----                             2442  ; - long 16: lexeme length in bytes  ; [section code]
----                             2443  ;  ; [section code]
----                             2444  ; This is the compact native surface that the asm tests decode back into the  ; [section code]
----                             2445  ; OPFORGE-TOKVM 1 report format.  ; [section code]
----                             2446  ; ---------------------------------------------------------------------------  ; [section code]
----                             2447    ; [section code]
----                             2448  tokvmCommitPendingToken  ; [section code]
1058    B2 85                    2449          CMP.L D5, D1  ; token_count < token_capacity  ; [section code]
105A    64 00 00 56              2450          BCC tokvmPendingTokenOverflow  ; [section code]
105E    20 03                    2451          MOVE.L D3, D0  ; scratch_used + pending_len must stay within scratch_capacity  ; [section code]
1060    D0 AA 00 10              2452          ADD.L LOCAL_PENDING_LEX_LEN(A2), D0  ; [section code]
1064    B0 86                    2453          CMP.L D6, D0  ; [section code]
1066    62 00 00 52              2454          BHI tokvmPendingLexemeOverflow  ; [section code]
106A    20 01                    2455          MOVE.L D1, D0  ; compute record_index * TOKEN_RECORD_SIZE without a MUL dependency  ; [section code]
106C    D0 80                    2456          ADD.L D0, D0  ; *2  ; [section code]
106E    20 40                    2457          MOVEA.L D0, A0  ; [section code]
1070    D0 80                    2458          ADD.L D0, D0  ; *4  ; [section code]
1072    D0 80                    2459          ADD.L D0, D0  ; *8  ; [section code]
1074    D0 80                    2460          ADD.L D0, D0  ; *16  ; [section code]
1076    D1 C0                    2461          ADDA.L D0, A0  ; *18  ; [section code]
1078    20 01                    2462          MOVE.L D1, D0  ; [section code]
107A    D0 80                    2463          ADD.L D0, D0  ; +2 => *20 byte stride  ; [section code]
107C    D1 C0                    2464          ADDA.L D0, A0  ; [section code]
107E    22 4D                    2465          MOVEA.L A5, A1  ; [section code]
1080    D3 C8                    2466          ADDA.L A0, A1  ; [section code]
1082    32 AA 00 04              2467          MOVE.W LOCAL_PENDING_KIND(A2), (A1)  ; field 0: token kind code  ; [section code]
1086    42 69 00 02              2468          CLR.W 2(A1)  ; [section code]
108A    20 2A 00 08              2469          MOVE.L LOCAL_PENDING_START(A2), D0  ; field 4: 1-based start column  ; [section code]
108E    52 80                    2470          ADDQ.L #1, D0  ; [section code]
1090    23 40 00 04              2471          MOVE.L D0, 4(A1)  ; [section code]
1094    20 2A 00 0C              2472          MOVE.L LOCAL_PENDING_END(A2), D0  ; field 8: 1-based end column  ; [section code]
1098    52 80                    2473          ADDQ.L #1, D0  ; [section code]
109A    23 40 00 08              2474          MOVE.L D0, 8(A1)  ; [section code]
109E    23 43 00 0C              2475          MOVE.L D3, 12(A1)  ; field 12: lexeme offset into scratch  ; [section code]
10A2    23 6A 00 10 00 10        2476          MOVE.L LOCAL_PENDING_LEX_LEN(A2), 16(A1)  ; field 16: lexeme length in bytes  ; [section code]
10A8    52 81                    2477          ADDQ.L #1, D1  ; [section code]
10AA    D6 AA 00 10              2478          ADD.L LOCAL_PENDING_LEX_LEN(A2), D3  ; [section code]
10AE    70 00                    2479          MOVEQ #TK_STATUS_SUCCESS, D0  ; [section code]
10B0    4E 75                    2480          RTS  ; [section code]
