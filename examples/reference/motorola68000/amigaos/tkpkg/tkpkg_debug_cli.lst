----                             1781  ; Positive VM statuses mirror the native tokenization result contract.
----    EQU 0000                 1782  TK_STATUS_SUCCESS               = 0
----    EQU 0001                 1783  TK_STATUS_NEWLINE_UNSUPPORTED   = 1
----    EQU 0002                 1784  TK_STATUS_TOKEN_OVERFLOW        = 2
----    EQU 0003                 1785  TK_STATUS_LEXEME_OVERFLOW       = 3
----    EQU 0004                 1786  TK_STATUS_VM_FAILURE            = 4
----    EQU 0005                 1787  TK_STATUS_INVALID_ARGUMENT      = 5
----    EQU 0006                 1788  TK_STATUS_INVALID_PROGRAM       = 6
----    EQU 0007                 1789  TK_STATUS_STEP_LIMIT_EXCEEDED   = 7
----                             1790  
----    EQU 0000                 1791  TK_VM_FAILURE_KIND_NONE         = 0
----    EQU 0001                 1792  TK_VM_FAILURE_KIND_FAIL         = 1
----    EQU 0002                 1793  TK_VM_FAILURE_KIND_EMIT_DIAG    = 2
----                             1794  
