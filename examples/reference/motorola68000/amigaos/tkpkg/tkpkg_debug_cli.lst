1334    32 AA 00 04              2773          MOVE.W LOCAL_PENDING_KIND(A2), (A1)  ; field 0: token kind code  ; [section code]
1338    42 69 00 02              2774          CLR.W 2(A1)  ; [section code]
133C    20 2A 00 08              2775          MOVE.L LOCAL_PENDING_START(A2), D0  ; field 4: 1-based start column  ; [section code]
1340    52 80                    2776          ADDQ.L #1, D0  ; [section code]
1342    23 40 00 04              2777          MOVE.L D0, 4(A1)  ; [section code]
1346    20 2A 00 0C              2778          MOVE.L LOCAL_PENDING_END(A2), D0  ; field 8: 1-based end column  ; [section code]
134A    52 80                    2779          ADDQ.L #1, D0  ; [section code]
134C    23 40 00 08              2780          MOVE.L D0, 8(A1)  ; [section code]
