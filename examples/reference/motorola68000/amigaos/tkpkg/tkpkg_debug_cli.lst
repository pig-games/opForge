----                             2825  ; Scanner helpers.  ; [section code]
----                             2826  ;  ; [section code]
----                             2827  ; These are the native counterparts of the Rust tokenizer helper routines in  ; [section code]
----                             2828  ; tokenizer_runtime_utils.rs. Each helper advances D2 as the live source cursor,  ; [section code]
----                             2829  ; populates LOCAL_PENDING_* metadata, stages lexeme bytes into the scratch  ; [section code]
----                             2830  ; buffer, then commits a token record.  ; [section code]
----                             2831  ; ---------------------------------------------------------------------------  ; [section code]
----                             2832    ; [section code]
----                             2833  tokvmScanIdentifierToken  ; [section code]
----                             2834          ; Identifier scan is the native mirror of vm_scan_identifier_token():  ; [section code]
----                             2835          ; walk identifier-continue bytes, lowercase ASCII letters for the demo  ; [section code]
----                             2836          ; policy, then emit one identifier record backed by scratch bytes.  ; [section code]
