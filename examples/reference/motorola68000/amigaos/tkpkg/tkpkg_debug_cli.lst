----                             5943  ; Thin AmigaOS CLI smoke wrapper for the package-backed tkpkg runtime.
----                             5944  ;
----                             5945  ; This slice exercises init, load_package, set_pipeline, tokenize_line, and
----                             5946  ; last_error without folding CLI/report concerns into the core runtime modules.
----                             5947  
----                             5948          .module main
----                             5949          .cpu 68020
----                             5950          .use tkpkg.amigaos.abi (ENTRY_ORD_INIT, ENTRY_ORD_LOAD_PACKAGE)
----                             5951          .use tkpkg.amigaos.abi (ENTRY_ORD_SET_PIPELINE, ENTRY_ORD_TOKENIZE_LINE)
----                             5952          .use tkpkg.amigaos.abi (ENTRY_ORD_LAST_ERROR, TOKENIZE_LINE_SAMPLE_LINE_NUM)
----                             5953          .use tkpkg.amigaos.abi (CB_INPUT_PTR, CB_INPUT_LEN, CB_OUTPUT_LEN, CB_STATUS_CODE)
----                             5954          .use tkpkg.amigaos.buffers (controlBlockV1, lastErrorBuffer, packageStorage)
----                             5955          .use tkpkg.amigaos.buffers (LAST_ERROR_BUFFER_PTR_V1, LAST_ERROR_BUFFER_CAPACITY)
----                             5956          .use tkpkg.amigaos.service (tkpkg_service_dispatch_v1)
----                             5957  
