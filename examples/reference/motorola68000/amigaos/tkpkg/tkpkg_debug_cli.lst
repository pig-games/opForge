----                             1931          .section code, kind=code  ; [section code]
----                             1932    ; [section code]
----                             1933  ; ---------------------------------------------------------------------------  ; [section code]
----                             1934  ; Native tokenizer VM interpreter.  ; [section code]
----                             1935  ;  ; [section code]
----                             1936  ; This interpreter executes the tokenizer bytecode against one line-buffer-backed  ; [section code]
----                             1937  ; input stream. Its control flow mirrors the Rust tokenizer VM loop in  ; [section code]
----                             1938  ; crates/opforge-vm/src/runtime_model_core.rs:  ; [section code]
----                             1939  ; - validate arguments and stream constraints  ; [section code]
----                             1940  ; - keep source cursor in D2 and program counter in A0  ; [section code]
----                             1941  ; - decode opcodes from the bytecode stream in A3..A3+D7  ; [section code]
----                             1942  ; - dispatch scan/predicate helpers that mirror tokenizer_runtime_utils.rs  ; [section code]
----                             1943  ; - emit compact native token records into the caller-provided token buffer  ; [section code]
----                             1944  ; ---------------------------------------------------------------------------  ; [section code]
----                             1945    ; [section code]
----                             1946  tokvm_set_step_budget_68000  ; [section code]
0B72    4A 80                    1947          TST.L D0  ; [section code]
0B74    6E 06                    1948          BGT.S tokvmSetStepBudgetStore  ; [section code]
0B76    20 3C 00 00 08 00        1949          MOVE.L #TOKVM_DEFAULT_MAX_STEPS_PER_LINE, D0  ; [section code]
----                             1950  tokvmSetStepBudgetStore  ; [section code]
0B7C    23 C0 00 00 02 4D        1951          MOVE.L D0, tokvmStepBudget  ; [section code]
0B82    4E 75                    1952          RTS  ; [section code]
----                             1953    ; [section code]
----                             1954  tokvm_set_program_state_table_68000  ; [section code]
0B84    4A 80                    1955          TST.L D0  ; [section code]
