1338    32 AA 00 04              2775          MOVE.W LOCAL_PENDING_KIND(A2), (A1)  ; field 0: token kind code  ; [section code]
133C    42 69 00 02              2776          CLR.W 2(A1)  ; [section code]
1340    20 2A 00 08              2777          MOVE.L LOCAL_PENDING_START(A2), D0  ; field 4: 1-based start column  ; [section code]
1344    52 80                    2778          ADDQ.L #1, D0  ; [section code]
1346    23 40 00 04              2779          MOVE.L D0, 4(A1)  ; [section code]
134A    20 2A 00 0C              2780          MOVE.L LOCAL_PENDING_END(A2), D0  ; field 8: 1-based end column  ; [section code]
134E    52 80                    2781          ADDQ.L #1, D0  ; [section code]
