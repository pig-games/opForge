----                             3334    ; [section data]
----                             3335  ; Default tokenizer VM loop for this native example.  ; [section data]
----                             3336  ; This intentionally mirrors crates/opforge-vm/src/builder.rs:  ; [section data]
----                             3337  ; - ReadChar  ; [section data]
----                             3338  ; - if EOL -> End  ; [section data]
----                             3339  ; - if whitespace -> Advance and loop  ; [section data]
----                             3340  ; - if '.' or symbol-leading punctuation -> ScanSymbol  ; [section data]
----                             3341  ; - if identifier-start -> ScanIdentifier  ; [section data]
----                             3342  ; - if digit -> ScanNumber  ; [section data]
----                             3343  ; - if quote -> ScanString  ; [section data]
----                             3344  ;  ; [section data]
----                             3345  ; The bytecode below is the readable assembler mirror of builder.rs  ; [section data]
----                             3346  ; default_family_tokenizer_vm_program_bytes(): read char, branch by class, then loop.  ; [section data]
