----                             2742  ; ---------------------------------------------------------------------------  ; [section code]
----                             2743  ; Native token record staging and commit.  ; [section code]
----                             2744  ;  ; [section code]
----                             2745  ; Each committed record is 20 bytes in tokenBuffer:  ; [section code]
----                             2746  ; - word 0: token kind code  ; [section code]
----                             2747  ; - long 4: 1-based start column  ; [section code]
----                             2748  ; - long 8: 1-based end column  ; [section code]
----                             2749  ; - long 12: lexemeScratch offset  ; [section code]
----                             2750  ; - long 16: lexeme length in bytes  ; [section code]
----                             2751  ;  ; [section code]
----                             2752  ; This is the compact native surface that the asm tests decode back into the  ; [section code]
----                             2753  ; OPFORGE-TOKVM 1 report format.  ; [section code]
----                             2754  ; ---------------------------------------------------------------------------  ; [section code]
----                             2755    ; [section code]
