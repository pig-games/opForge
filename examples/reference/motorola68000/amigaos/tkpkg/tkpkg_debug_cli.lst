----                             1778  
----                             1779  ; Positive VM statuses mirror the native tokenization result contract.
----    EQU 0000                 1780  TK_STATUS_SUCCESS               = 0
----    EQU 0001                 1781  TK_STATUS_NEWLINE_UNSUPPORTED   = 1
----    EQU 0002                 1782  TK_STATUS_TOKEN_OVERFLOW        = 2
----    EQU 0003                 1783  TK_STATUS_LEXEME_OVERFLOW       = 3
----    EQU 0004                 1784  TK_STATUS_VM_FAILURE            = 4
----    EQU 0005                 1785  TK_STATUS_INVALID_ARGUMENT      = 5
----    EQU 0006                 1786  TK_STATUS_INVALID_PROGRAM       = 6
----    EQU 0007                 1787  TK_STATUS_STEP_LIMIT_EXCEEDED   = 7
----                             1788  
----    EQU 0000                 1789  TK_VM_FAILURE_KIND_NONE         = 0
----    EQU 0001                 1790  TK_VM_FAILURE_KIND_FAIL         = 1
----    EQU 0002                 1791  TK_VM_FAILURE_KIND_EMIT_DIAG    = 2
----                             1792  
----                             1793  ; Opcode values intentionally match crate::package::TokenizerVmOpcode in
----                             1794  ; crates/opforge-package/src/package.rs.
----    EQU 0000                 1795  TK_OPCODE_END                   = 0
----    EQU 0001                 1796  TK_OPCODE_READ_CHAR             = 1
----    EQU 0002                 1797  TK_OPCODE_ADVANCE               = 2
----    EQU 0003                 1798  TK_OPCODE_START_LEXEME          = 3
----    EQU 0004                 1799  TK_OPCODE_PUSH_CHAR             = 4
----    EQU 0005                 1800  TK_OPCODE_EMIT_TOKEN            = 5
----    EQU 0006                 1801  TK_OPCODE_SET_STATE             = 6
----    EQU 0007                 1802  TK_OPCODE_JUMP                  = 7
----    EQU 0008                 1803  TK_OPCODE_JUMP_IF_EOL           = 8
----    EQU 0009                 1804  TK_OPCODE_JUMP_IF_BYTE_EQ       = 9
----    EQU 000A                 1805  TK_OPCODE_JUMP_IF_CLASS         = 10
----    EQU 000B                 1806  TK_OPCODE_FAIL                  = 11
----    EQU 000C                 1807  TK_OPCODE_EMIT_DIAG             = 12
----    EQU 000E                 1808  TK_OPCODE_SCAN_CORE             = 14
----    EQU 000F                 1809  TK_OPCODE_SCAN_IDENTIFIER       = 15
----    EQU 0010                 1810  TK_OPCODE_SCAN_NUMBER           = 16
----    EQU 0011                 1811  TK_OPCODE_SCAN_STRING           = 17
----    EQU 0012                 1812  TK_OPCODE_SCAN_SYMBOL           = 18
----                             1813  
