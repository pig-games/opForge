----                             1777  ; Positive VM statuses mirror the native tokenization result contract.
----    EQU 0000                 1778  TK_STATUS_SUCCESS               = 0
----    EQU 0001                 1779  TK_STATUS_NEWLINE_UNSUPPORTED   = 1
----    EQU 0002                 1780  TK_STATUS_TOKEN_OVERFLOW        = 2
----    EQU 0003                 1781  TK_STATUS_LEXEME_OVERFLOW       = 3
----    EQU 0004                 1782  TK_STATUS_VM_FAILURE            = 4
----    EQU 0005                 1783  TK_STATUS_INVALID_ARGUMENT      = 5
----    EQU 0006                 1784  TK_STATUS_INVALID_PROGRAM       = 6
----    EQU 0007                 1785  TK_STATUS_STEP_LIMIT_EXCEEDED   = 7
----                             1786  
----    EQU 0000                 1787  TK_VM_FAILURE_KIND_NONE         = 0
----    EQU 0001                 1788  TK_VM_FAILURE_KIND_FAIL         = 1
----    EQU 0002                 1789  TK_VM_FAILURE_KIND_EMIT_DIAG    = 2
----                             1790  
