----                             1853  
----                             1854  ; The default demo program currently uses only the same first five character
----                             1855  ; classes consumed by vm_char_class_matches in tokenizer_runtime_utils.rs.
----    EQU 0001                 1856  TK_CLASS_WHITESPACE             = 1
----    EQU 0002                 1857  TK_CLASS_IDENTIFIER_START       = 2
----    EQU 0003                 1858  TK_CLASS_IDENTIFIER_CONTINUE    = 3
----    EQU 0004                 1859  TK_CLASS_DIGIT                  = 4
----    EQU 0005                 1860  TK_CLASS_QUOTE                  = 5
----                             1861  
----                             1862  ; Program-counter labels for demoProgram. These offsets intentionally match the
----                             1863  ; little-endian jump targets emitted by the Rust builder default loop.
----    EQU 0000                 1864  DEMO_PC_READ_CHAR               = 0
----    EQU 0024                 1865  DEMO_PC_SCAN_SYMBOL             = 36
----    EQU 002A                 1866  DEMO_PC_SKIP_WHITESPACE         = 42
----    EQU 0030                 1867  DEMO_PC_SCAN_IDENTIFIER         = 48
----    EQU 0036                 1868  DEMO_PC_SCAN_NUMBER             = 54
----    EQU 003C                 1869  DEMO_PC_SCAN_STRING             = 60
----    EQU 0042                 1870  DEMO_PC_FINISH                  = 66
----                             1871  
----    EQU 0014                 1872  TOKEN_RECORD_SIZE               = 20
----    EQU 0400                 1873  SOURCE_BUFFER_CAPACITY          = 1024
----    EQU 0040                 1874  TOKEN_BUFFER_CAPACITY           = 64
----    EQU 0400                 1875  SCRATCH_BUFFER_CAPACITY         = 1024
----    EQU 0800                 1876  TOKVM_DEFAULT_MAX_STEPS_PER_LINE = 2048
----                             1877  
----                             1878  ; The fixed capacities above intentionally match the AmigaOS host harness so the
----                             1879  ; native VM and the CLI/report layer agree on how much source, token, and scratch
----                             1880  ; state can be exchanged without any additional negotiation structure.
----                             1881  
----                             1882  ; tokvm_run_68000 local frame layout.
----                             1883  ;
----                             1884  ; Call ABI:
----                             1885  ; - A0 / D0: source buffer pointer and source byte length
----                             1886  ; - A1 / D1: token buffer pointer and token capacity in records
----                             1887  ; - A2 / D2: scratch buffer pointer and scratch capacity in bytes
----                             1888  ; - A3 / D3: tokenizer bytecode pointer and program length in bytes
----                             1889  ;
----                             1890  ; Return ABI:
----                             1891  ; - D0: TK_STATUS_*
----                             1892  ; - D1: emitted token count
----                             1893  ; - D2: final source cursor
----                             1894  ; - D3: scratch bytes committed into lexemeScratch
----    EQU 0000                 1895  LOCAL_CURRENT_BYTE              = 0
----    EQU 0004                 1896  LOCAL_PENDING_KIND              = 4
----    EQU 0008                 1897  LOCAL_PENDING_START             = 8
----    EQU 000C                 1898  LOCAL_PENDING_END               = 12
----    EQU 0010                 1899  LOCAL_PENDING_LEX_LEN           = 16
----    EQU 0014                 1900  LOCAL_TEMP_U32                  = 20
----    EQU 0018                 1901  LOCAL_PROGRAM_COUNTER           = 24
----    EQU 001C                 1902  LOCAL_STEP_COUNT                = 28
----    EQU 0020                 1903  LOCAL_STEP_LIMIT                = 32
----    EQU 0024                 1904  LOCAL_SIZE                      = 36
----                             1905  
