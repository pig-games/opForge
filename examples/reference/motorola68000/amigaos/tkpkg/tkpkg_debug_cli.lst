----                             1788  ; Positive VM statuses mirror the native tokenization result contract.
----    EQU 0000                 1789  TK_STATUS_SUCCESS               = 0
----    EQU 0001                 1790  TK_STATUS_NEWLINE_UNSUPPORTED   = 1
----    EQU 0002                 1791  TK_STATUS_TOKEN_OVERFLOW        = 2
----    EQU 0003                 1792  TK_STATUS_LEXEME_OVERFLOW       = 3
----    EQU 0004                 1793  TK_STATUS_VM_FAILURE            = 4
----    EQU 0005                 1794  TK_STATUS_INVALID_ARGUMENT      = 5
----    EQU 0006                 1795  TK_STATUS_INVALID_PROGRAM       = 6
----    EQU 0007                 1796  TK_STATUS_STEP_LIMIT_EXCEEDED   = 7
----                             1797  
----    EQU 0000                 1798  TK_VM_FAILURE_KIND_NONE         = 0
----    EQU 0001                 1799  TK_VM_FAILURE_KIND_FAIL         = 1
----    EQU 0002                 1800  TK_VM_FAILURE_KIND_EMIT_DIAG    = 2
----                             1801  
