----                             2059  ; Positive VM statuses mirror the native tokenization result contract.
----    EQU 0000                 2060  TK_STATUS_SUCCESS               = 0
----    EQU 0001                 2061  TK_STATUS_NEWLINE_UNSUPPORTED   = 1
----    EQU 0002                 2062  TK_STATUS_TOKEN_OVERFLOW        = 2
----    EQU 0003                 2063  TK_STATUS_LEXEME_OVERFLOW       = 3
----    EQU 0004                 2064  TK_STATUS_VM_FAILURE            = 4
----    EQU 0005                 2065  TK_STATUS_INVALID_ARGUMENT      = 5
----    EQU 0006                 2066  TK_STATUS_INVALID_PROGRAM       = 6
----    EQU 0007                 2067  TK_STATUS_STEP_LIMIT_EXCEEDED   = 7
----                             2068  
----    EQU 0000                 2069  TK_VM_FAILURE_KIND_NONE         = 0
----    EQU 0001                 2070  TK_VM_FAILURE_KIND_FAIL         = 1
----    EQU 0002                 2071  TK_VM_FAILURE_KIND_EMIT_DIAG    = 2
