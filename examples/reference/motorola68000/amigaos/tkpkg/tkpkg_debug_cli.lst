----    EQU 0004                 2079  TK_OPCODE_PUSH_CHAR             = 4
----    EQU 0005                 2080  TK_OPCODE_EMIT_TOKEN            = 5
----    EQU 0006                 2081  TK_OPCODE_SET_STATE             = 6
----    EQU 0007                 2082  TK_OPCODE_JUMP                  = 7
----    EQU 0008                 2083  TK_OPCODE_JUMP_IF_EOL           = 8
----    EQU 0009                 2084  TK_OPCODE_JUMP_IF_BYTE_EQ       = 9
----    EQU 000A                 2085  TK_OPCODE_JUMP_IF_CLASS         = 10
----    EQU 000B                 2086  TK_OPCODE_FAIL                  = 11
----    EQU 000C                 2087  TK_OPCODE_EMIT_DIAG             = 12
----    EQU 000E                 2088  TK_OPCODE_SCAN_CORE             = 14
----    EQU 000F                 2089  TK_OPCODE_SCAN_IDENTIFIER       = 15
