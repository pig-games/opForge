----                             1931  
----                             1932          .section code, kind=code  ; [section code]
----                             1933    ; [section code]
----                             1934  ; ---------------------------------------------------------------------------  ; [section code]
----                             1935  ; Native tokenizer VM interpreter.  ; [section code]
----                             1936  ;  ; [section code]
----                             1937  ; This interpreter executes the tokenizer bytecode against one line-buffer-backed  ; [section code]
----                             1938  ; input stream. Its control flow mirrors the Rust tokenizer VM loop in  ; [section code]
----                             1939  ; crates/opforge-vm/src/runtime_model_core.rs:  ; [section code]
----                             1940  ; - validate arguments and stream constraints  ; [section code]
----                             1941  ; - keep source cursor in D2 and program counter in A0  ; [section code]
----                             1942  ; - decode opcodes from the bytecode stream in A3..A3+D7  ; [section code]
----                             1943  ; - dispatch scan/predicate helpers that mirror tokenizer_runtime_utils.rs  ; [section code]
----                             1944  ; - emit compact native token records into the caller-provided token buffer  ; [section code]
----                             1945  ; ---------------------------------------------------------------------------  ; [section code]
----                             1946    ; [section code]
----                             1947  tokvm_set_step_budget_68000  ; [section code]
0BD6    4A 80                    1948          TST.L D0  ; [section code]
0BD8    6E 06                    1949          BGT.S tokvmSetStepBudgetStore  ; [section code]
0BDA    20 3C 00 00 08 00        1950          MOVE.L #TOKVM_DEFAULT_MAX_STEPS_PER_LINE, D0  ; [section code]
