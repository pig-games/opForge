----                             2238  
----                             2239          .section code, kind=code  ; [section code]
----                             2240    ; [section code]
----                             2241  ; ---------------------------------------------------------------------------  ; [section code]
----                             2242  ; Native tokenizer VM interpreter.  ; [section code]
----                             2243  ;  ; [section code]
----                             2244  ; This interpreter executes the tokenizer bytecode against one line-buffer-backed  ; [section code]
----                             2245  ; input stream. Its control flow mirrors the Rust tokenizer VM loop in  ; [section code]
----                             2246  ; crates/opforge-vm/src/runtime_model_core.rs:  ; [section code]
----                             2247  ; - validate arguments and stream constraints  ; [section code]
----                             2248  ; - keep source cursor in D2 and program counter in A0  ; [section code]
----                             2249  ; - decode opcodes from the bytecode stream in A3..A3+D7  ; [section code]
----                             2250  ; - dispatch scan/predicate helpers that mirror tokenizer_runtime_utils.rs  ; [section code]
----                             2251  ; - emit compact native token records into the caller-provided token buffer  ; [section code]
----                             2252  ; ---------------------------------------------------------------------------  ; [section code]
----                             2253    ; [section code]
