----    EQU 0013                 1834  TK_KIND_OP_MINUS                = 19
----    EQU 0014                 1835  TK_KIND_OP_MULTIPLY             = 20
----    EQU 0015                 1836  TK_KIND_OP_CARET                = 21
----    EQU 0016                 1837  TK_KIND_OP_DIVIDE               = 22
----    EQU 0017                 1838  TK_KIND_OP_MOD                  = 23
----    EQU 0018                 1839  TK_KIND_OP_SHL                  = 24
