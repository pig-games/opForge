----                             2437    ; [section code]
----                             2438  ; ---------------------------------------------------------------------------  ; [section code]
----                             2439  ; Native token record staging and commit.  ; [section code]
----                             2440  ;  ; [section code]
----                             2441  ; Each committed record is 20 bytes in tokenBuffer:  ; [section code]
----                             2442  ; - word 0: token kind code  ; [section code]
----                             2443  ; - long 4: 1-based start column  ; [section code]
----                             2444  ; - long 8: 1-based end column  ; [section code]
----                             2445  ; - long 12: lexemeScratch offset  ; [section code]
----                             2446  ; - long 16: lexeme length in bytes  ; [section code]
----                             2447  ;  ; [section code]
----                             2448  ; This is the compact native surface that the asm tests decode back into the  ; [section code]
----                             2449  ; OPFORGE-TOKVM 1 report format.  ; [section code]
----                             2450  ; ---------------------------------------------------------------------------  ; [section code]
----                             2451    ; [section code]
----                             2452  tokvmCommitPendingToken  ; [section code]
1070    B2 85                    2453          CMP.L D5, D1  ; token_count < token_capacity  ; [section code]
1072    64 00 00 56              2454          BCC tokvmPendingTokenOverflow  ; [section code]
1076    20 03                    2455          MOVE.L D3, D0  ; scratch_used + pending_len must stay within scratch_capacity  ; [section code]
1078    D0 AA 00 10              2456          ADD.L LOCAL_PENDING_LEX_LEN(A2), D0  ; [section code]
107C    B0 86                    2457          CMP.L D6, D0  ; [section code]
107E    62 00 00 52              2458          BHI tokvmPendingLexemeOverflow  ; [section code]
1082    20 01                    2459          MOVE.L D1, D0  ; compute record_index * TOKEN_RECORD_SIZE without a MUL dependency  ; [section code]
1084    D0 80                    2460          ADD.L D0, D0  ; *2  ; [section code]
1086    20 40                    2461          MOVEA.L D0, A0  ; [section code]
1088    D0 80                    2462          ADD.L D0, D0  ; *4  ; [section code]
108A    D0 80                    2463          ADD.L D0, D0  ; *8  ; [section code]
108C    D0 80                    2464          ADD.L D0, D0  ; *16  ; [section code]
108E    D1 C0                    2465          ADDA.L D0, A0  ; *18  ; [section code]
1090    20 01                    2466          MOVE.L D1, D0  ; [section code]
1092    D0 80                    2467          ADD.L D0, D0  ; +2 => *20 byte stride  ; [section code]
1094    D1 C0                    2468          ADDA.L D0, A0  ; [section code]
1096    22 4D                    2469          MOVEA.L A5, A1  ; [section code]
1098    D3 C8                    2470          ADDA.L A0, A1  ; [section code]
109A    32 AA 00 04              2471          MOVE.W LOCAL_PENDING_KIND(A2), (A1)  ; field 0: token kind code  ; [section code]
109E    42 69 00 02              2472          CLR.W 2(A1)  ; [section code]
10A2    20 2A 00 08              2473          MOVE.L LOCAL_PENDING_START(A2), D0  ; field 4: 1-based start column  ; [section code]
10A6    52 80                    2474          ADDQ.L #1, D0  ; [section code]
10A8    23 40 00 04              2475          MOVE.L D0, 4(A1)  ; [section code]
10AC    20 2A 00 0C              2476          MOVE.L LOCAL_PENDING_END(A2), D0  ; field 8: 1-based end column  ; [section code]
10B0    52 80                    2477          ADDQ.L #1, D0  ; [section code]
10B2    23 40 00 08              2478          MOVE.L D0, 8(A1)  ; [section code]
10B6    23 43 00 0C              2479          MOVE.L D3, 12(A1)  ; field 12: lexeme offset into scratch  ; [section code]
10BA    23 6A 00 10 00 10        2480          MOVE.L LOCAL_PENDING_LEX_LEN(A2), 16(A1)  ; field 16: lexeme length in bytes  ; [section code]
10C0    52 81                    2481          ADDQ.L #1, D1  ; [section code]
10C2    D6 AA 00 10              2482          ADD.L LOCAL_PENDING_LEX_LEN(A2), D3  ; [section code]
10C6    70 00                    2483          MOVEQ #TK_STATUS_SUCCESS, D0  ; [section code]
10C8    4E 75                    2484          RTS  ; [section code]
