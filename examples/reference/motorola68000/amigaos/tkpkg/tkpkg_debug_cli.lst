----                             2516    ; [section code]
----                             2517  ; ---------------------------------------------------------------------------  ; [section code]
----                             2518  ; Scanner helpers.  ; [section code]
----                             2519  ;  ; [section code]
----                             2520  ; These are the native counterparts of the Rust tokenizer helper routines in  ; [section code]
----                             2521  ; tokenizer_runtime_utils.rs. Each helper advances D2 as the live source cursor,  ; [section code]
----                             2522  ; populates LOCAL_PENDING_* metadata, stages lexeme bytes into the scratch  ; [section code]
----                             2523  ; buffer, then commits a token record.  ; [section code]
----                             2524  ; ---------------------------------------------------------------------------  ; [section code]
----                             2525    ; [section code]
----                             2526  tokvmScanIdentifierToken  ; [section code]
----                             2527          ; Identifier scan is the native mirror of vm_scan_identifier_token():  ; [section code]
----                             2528          ; walk identifier-continue bytes, lowercase ASCII letters for the demo  ; [section code]
----                             2529          ; policy, then emit one identifier record backed by scratch bytes.  ; [section code]
10EA    25 42 00 08              2530          MOVE.L D2, LOCAL_PENDING_START(A2)  ; [section code]
10EE    42 AA 00 10              2531          CLR.L LOCAL_PENDING_LEX_LEN(A2)  ; [section code]
10F2    20 4E                    2532          MOVEA.L A6, A0  ; [section code]
10F4    D1 C3                    2533          ADDA.L D3, A0  ; [section code]
----                             2534    ; [section code]
----                             2535  tokvmScanIdentifierLoop  ; [section code]
