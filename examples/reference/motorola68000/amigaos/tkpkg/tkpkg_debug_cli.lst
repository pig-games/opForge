027B    00                       3502          .byte ((DEMO_PC_FINISH) >> 8) & $ff  ; [section data]
027C    00                       3503          .byte ((DEMO_PC_FINISH) >> 16) & $ff  ; [section data]
027D    00                       3504          .byte ((DEMO_PC_FINISH) >> 24) & $ff  ; [section data]
