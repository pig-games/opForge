----                             2135  
----                             2136  ; The default demo program currently uses only the same first five character
----                             2137  ; classes consumed by vm_char_class_matches in tokenizer_runtime_utils.rs.
----    EQU 0001                 2138  TK_CLASS_WHITESPACE             = 1
----    EQU 0002                 2139  TK_CLASS_IDENTIFIER_START       = 2
----    EQU 0003                 2140  TK_CLASS_IDENTIFIER_CONTINUE    = 3
----    EQU 0004                 2141  TK_CLASS_DIGIT                  = 4
----    EQU 0005                 2142  TK_CLASS_QUOTE                  = 5
----                             2143  
----                             2144  ; Program-counter labels for demoProgram. These offsets intentionally match the
----                             2145  ; little-endian jump targets emitted by the Rust builder default loop.
----    EQU 0000                 2146  DEMO_PC_READ_CHAR               = 0
----    EQU 0024                 2147  DEMO_PC_SCAN_SYMBOL             = 36
----    EQU 002A                 2148  DEMO_PC_SKIP_WHITESPACE         = 42
----    EQU 0030                 2149  DEMO_PC_SCAN_IDENTIFIER         = 48
----    EQU 0036                 2150  DEMO_PC_SCAN_NUMBER             = 54
----    EQU 003C                 2151  DEMO_PC_SCAN_STRING             = 60
----    EQU 0042                 2152  DEMO_PC_FINISH                  = 66
----                             2153  
----    EQU 0014                 2154  TOKEN_RECORD_SIZE               = 20
----    EQU 0400                 2155  SOURCE_BUFFER_CAPACITY          = 1024
----    EQU 0040                 2156  TOKEN_BUFFER_CAPACITY           = 64
----    EQU 0400                 2157  SCRATCH_BUFFER_CAPACITY         = 1024
----    EQU 0800                 2158  TOKVM_DEFAULT_MAX_STEPS_PER_LINE = 2048
----                             2159  
----                             2160  ; The fixed capacities above intentionally match the AmigaOS host harness so the
----                             2161  ; native VM and the CLI/report layer agree on how much source, token, and scratch
----                             2162  ; state can be exchanged without any additional negotiation structure.
----                             2163  
----                             2164  ; tokvm_run_68000 local frame layout.
----                             2165  ;
----                             2166  ; Call ABI:
----                             2167  ; - A0 / D0: source buffer pointer and source byte length
----                             2168  ; - A1 / D1: token buffer pointer and token capacity in records
----                             2169  ; - A2 / D2: scratch buffer pointer and scratch capacity in bytes
----                             2170  ; - A3 / D3: tokenizer bytecode pointer and program length in bytes
----                             2171  ;
----                             2172  ; Return ABI:
----                             2173  ; - D0: TK_STATUS_*
----                             2174  ; - D1: emitted token count
----                             2175  ; - D2: final source cursor
----                             2176  ; - D3: scratch bytes committed into lexemeScratch
----    EQU 0000                 2177  LOCAL_CURRENT_BYTE              = 0
----    EQU 0004                 2178  LOCAL_PENDING_KIND              = 4
----    EQU 0008                 2179  LOCAL_PENDING_START             = 8
----    EQU 000C                 2180  LOCAL_PENDING_END               = 12
----    EQU 0010                 2181  LOCAL_PENDING_LEX_LEN           = 16
----    EQU 0014                 2182  LOCAL_TEMP_U32                  = 20
----    EQU 0018                 2183  LOCAL_PROGRAM_COUNTER           = 24
----    EQU 001C                 2184  LOCAL_STEP_COUNT                = 28
----    EQU 0020                 2185  LOCAL_STEP_LIMIT                = 32
----    EQU 0024                 2186  LOCAL_SIZE                      = 36
