----                             2519  ; Scanner helpers.  ; [section code]
----                             2520  ;  ; [section code]
----                             2521  ; These are the native counterparts of the Rust tokenizer helper routines in  ; [section code]
----                             2522  ; tokenizer_runtime_utils.rs. Each helper advances D2 as the live source cursor,  ; [section code]
----                             2523  ; populates LOCAL_PENDING_* metadata, stages lexeme bytes into the scratch  ; [section code]
----                             2524  ; buffer, then commits a token record.  ; [section code]
----                             2525  ; ---------------------------------------------------------------------------  ; [section code]
----                             2526    ; [section code]
