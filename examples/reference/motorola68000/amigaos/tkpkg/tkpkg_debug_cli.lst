----                             3460  ; The emit* helpers encode the same little-endian jump-target format produced by  ; [section data]
----                             3461  ; Rust's default_family_tokenizer_vm_program_bytes(). Keep demoProgram and the  ; [section data]
----                             3462  ; DEMO_PC_* offsets together so the control-flow map stays readable.  ; [section data]
----                             3463    ; [section data]
----                             3464    ; [section data]
----                             3465    ; [section data]
----                             3466    ; [section data]
----                             3467  ; Default tokenizer VM loop for this native example.  ; [section data]
----                             3468  ; This intentionally mirrors crates/opforge-vm/src/builder.rs:  ; [section data]
----                             3469  ; - ReadChar  ; [section data]
----                             3470  ; - if EOL -> End  ; [section data]
----                             3471  ; - if whitespace -> Advance and loop  ; [section data]
----                             3472  ; - if '.' or symbol-leading punctuation -> ScanSymbol  ; [section data]
----                             3473  ; - if identifier-start -> ScanIdentifier  ; [section data]
----                             3474  ; - if digit -> ScanNumber  ; [section data]
----                             3475  ; - if quote -> ScanString  ; [section data]
----                             3476  ;  ; [section data]
----                             3477  ; The bytecode below is the readable assembler mirror of builder.rs  ; [section data]
----                             3478  ; default_family_tokenizer_vm_program_bytes(): read char, branch by class, then loop.  ; [section data]
----                             3479  demoProgram  ; [section data]
----                             3480  demoReadChar  ; [section data]
0278    01                       3481          .byte TK_OPCODE_READ_CHAR  ; [section data]
----                             3482          .block  ; [section data]
----                             3483          ; Macros keep the demo bytecode readable without obscuring the exact byte  ; [section data]
----                             3484          ; sequence that the Rust builder would emit.  ; [section data]
0279    08                       3485          .byte TK_OPCODE_JUMP_IF_EOL  ; [section data]
----                             3486          .block  ; [section data]
----                             3487          ; Keep jump targets readable in source while still emitting the same  ; [section data]
----                             3488          ; little-endian u32 layout as builder.rs and the Rust VM loader expect.  ; [section data]
