----                             3774  ; Default tokenizer VM loop for this native example.  ; [section data]
----                             3775  ; This intentionally mirrors crates/opforge-vm/src/builder.rs:  ; [section data]
----                             3776  ; - ReadChar  ; [section data]
----                             3777  ; - if EOL -> End  ; [section data]
----                             3778  ; - if whitespace -> Advance and loop  ; [section data]
----                             3779  ; - if '.' or symbol-leading punctuation -> ScanSymbol  ; [section data]
----                             3780  ; - if identifier-start -> ScanIdentifier  ; [section data]
----                             3781  ; - if digit -> ScanNumber  ; [section data]
----                             3782  ; - if quote -> ScanString  ; [section data]
----                             3783  ;  ; [section data]
----                             3784  ; The bytecode below is the readable assembler mirror of builder.rs  ; [section data]
----                             3785  ; default_family_tokenizer_vm_program_bytes(): read char, branch by class, then loop.  ; [section data]
----                             3786  demoProgram  ; [section data]
----                             3787  demoReadChar  ; [section data]
029C    01                       3788          .byte TK_OPCODE_READ_CHAR  ; [section data]
----                             3789          .block  ; [section data]
----                             3790          ; Macros keep the demo bytecode readable without obscuring the exact byte  ; [section data]
----                             3791          ; sequence that the Rust builder would emit.  ; [section data]
