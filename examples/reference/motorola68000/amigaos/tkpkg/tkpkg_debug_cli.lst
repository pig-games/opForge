----                             3478    ; [section data]
----                             3479  ; Default tokenizer VM loop for this native example.  ; [section data]
----                             3480  ; This intentionally mirrors crates/opforge-vm/src/builder.rs:  ; [section data]
----                             3481  ; - ReadChar  ; [section data]
----                             3482  ; - if EOL -> End  ; [section data]
----                             3483  ; - if whitespace -> Advance and loop  ; [section data]
----                             3484  ; - if '.' or symbol-leading punctuation -> ScanSymbol  ; [section data]
----                             3485  ; - if identifier-start -> ScanIdentifier  ; [section data]
----                             3486  ; - if digit -> ScanNumber  ; [section data]
----                             3487  ; - if quote -> ScanString  ; [section data]
----                             3488  ;  ; [section data]
----                             3489  ; The bytecode below is the readable assembler mirror of builder.rs  ; [section data]
----                             3490  ; default_family_tokenizer_vm_program_bytes(): read char, branch by class, then loop.  ; [section data]
----                             3491  demoProgram  ; [section data]
----                             3492  demoReadChar  ; [section data]
0278    01                       3493          .byte TK_OPCODE_READ_CHAR  ; [section data]
----                             3494          .block  ; [section data]
----                             3495          ; Macros keep the demo bytecode readable without obscuring the exact byte  ; [section data]
----                             3496          ; sequence that the Rust builder would emit.  ; [section data]
0279    08                       3497          .byte TK_OPCODE_JUMP_IF_EOL  ; [section data]
----                             3498          .block  ; [section data]
----                             3499          ; Keep jump targets readable in source while still emitting the same  ; [section data]
----                             3500          ; little-endian u32 layout as builder.rs and the Rust VM loader expect.  ; [section data]
