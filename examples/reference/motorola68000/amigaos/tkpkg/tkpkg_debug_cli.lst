----                             1941  
----                             1942          .section code, kind=code  ; [section code]
----                             1943    ; [section code]
----                             1944  ; ---------------------------------------------------------------------------  ; [section code]
----                             1945  ; Native tokenizer VM interpreter.  ; [section code]
----                             1946  ;  ; [section code]
----                             1947  ; This interpreter executes the tokenizer bytecode against one line-buffer-backed  ; [section code]
----                             1948  ; input stream. Its control flow mirrors the Rust tokenizer VM loop in  ; [section code]
----                             1949  ; crates/opforge-vm/src/runtime_model_core.rs:  ; [section code]
----                             1950  ; - validate arguments and stream constraints  ; [section code]
----                             1951  ; - keep source cursor in D2 and program counter in A0  ; [section code]
----                             1952  ; - decode opcodes from the bytecode stream in A3..A3+D7  ; [section code]
----                             1953  ; - dispatch scan/predicate helpers that mirror tokenizer_runtime_utils.rs  ; [section code]
----                             1954  ; - emit compact native token records into the caller-provided token buffer  ; [section code]
----                             1955  ; ---------------------------------------------------------------------------  ; [section code]
----                             1956    ; [section code]
