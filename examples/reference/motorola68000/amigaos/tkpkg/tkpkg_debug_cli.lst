----                             2523  ; Scanner helpers.  ; [section code]
----                             2524  ;  ; [section code]
----                             2525  ; These are the native counterparts of the Rust tokenizer helper routines in  ; [section code]
----                             2526  ; tokenizer_runtime_utils.rs. Each helper advances D2 as the live source cursor,  ; [section code]
----                             2527  ; populates LOCAL_PENDING_* metadata, stages lexeme bytes into the scratch  ; [section code]
----                             2528  ; buffer, then commits a token record.  ; [section code]
----                             2529  ; ---------------------------------------------------------------------------  ; [section code]
----                             2530    ; [section code]
