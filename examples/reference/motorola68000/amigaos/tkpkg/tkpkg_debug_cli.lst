1124    70 03                    2503          MOVEQ #TK_STATUS_LEXEME_OVERFLOW, D0  ; [section code]
1126    4E 75                    2504          RTS  ; [section code]
----                             2505    ; [section code]
----                             2506  ; Stage a fixed lexeme literal from the static data table into scratch.  ; [section code]
----                             2507  ; This is used for punctuation and operator tokens whose lexeme spelling is  ; [section code]
----                             2508  ; known upfront and does not need to be copied from the source buffer.  ; [section code]
----                             2509  tokvmStageFixedLexeme  ; [section code]
1128    25 40 00 10              2510          MOVE.L D0, LOCAL_PENDING_LEX_LEN(A2)  ; fixed operator/punctuation lexeme length from the inline template string  ; [section code]
112C    20 03                    2511          MOVE.L D3, D0  ; [section code]
112E    D0 AA 00 10              2512          ADD.L LOCAL_PENDING_LEX_LEN(A2), D0  ; [section code]
1132    B0 86                    2513          CMP.L D6, D0  ; [section code]
1134    62 00 FF EA              2514          BHI tokvmPendingLexemeOverflow  ; [section code]
1138    22 4E                    2515          MOVEA.L A6, A1  ; [section code]
113A    D3 C3                    2516          ADDA.L D3, A1  ; [section code]
113C    20 2A 00 10              2517          MOVE.L LOCAL_PENDING_LEX_LEN(A2), D0  ; [section code]
----                             2518  tokvmStageFixedLexemeLoop  ; [section code]
1140    4A 80                    2519          TST.L D0  ; [section code]
1142    67 00 00 0A              2520          BEQ tokvmStageFixedLexemeDone  ; [section code]
1146    12 D8                    2521          MOVE.B (A0)+, (A1)+  ; copy the canonical lexeme bytes that Rust would expose in PortableToken text/raw  ; [section code]
1148    53 80                    2522          SUBQ.L #1, D0  ; [section code]
114A    60 00 FF F4              2523          BRA tokvmStageFixedLexemeLoop  ; [section code]
----                             2524    ; [section code]
----                             2525  tokvmStageFixedLexemeDone  ; [section code]
114E    70 00                    2526          MOVEQ #TK_STATUS_SUCCESS, D0  ; [section code]
1150    4E 75                    2527          RTS  ; [section code]
