----                             1934  
----                             1935          .section code, kind=code  ; [section code]
----                             1936    ; [section code]
----                             1937  ; ---------------------------------------------------------------------------  ; [section code]
----                             1938  ; Native tokenizer VM interpreter.  ; [section code]
----                             1939  ;  ; [section code]
----                             1940  ; This interpreter executes the tokenizer bytecode against one line-buffer-backed  ; [section code]
----                             1941  ; input stream. Its control flow mirrors the Rust tokenizer VM loop in  ; [section code]
----                             1942  ; crates/opforge-vm/src/runtime_model_core.rs:  ; [section code]
----                             1943  ; - validate arguments and stream constraints  ; [section code]
----                             1944  ; - keep source cursor in D2 and program counter in A0  ; [section code]
----                             1945  ; - decode opcodes from the bytecode stream in A3..A3+D7  ; [section code]
----                             1946  ; - dispatch scan/predicate helpers that mirror tokenizer_runtime_utils.rs  ; [section code]
----                             1947  ; - emit compact native token records into the caller-provided token buffer  ; [section code]
----                             1948  ; ---------------------------------------------------------------------------  ; [section code]
----                             1949    ; [section code]
----                             1950  tokvm_set_step_budget_68000  ; [section code]
0B8A    4A 80                    1951          TST.L D0  ; [section code]
0B8C    6E 06                    1952          BGT.S tokvmSetStepBudgetStore  ; [section code]
0B8E    20 3C 00 00 08 00        1953          MOVE.L #TOKVM_DEFAULT_MAX_STEPS_PER_LINE, D0  ; [section code]
----                             1954  tokvmSetStepBudgetStore  ; [section code]
0B94    23 C0 00 00 02 4D        1955          MOVE.L D0, tokvmStepBudget  ; [section code]
0B9A    4E 75                    1956          RTS  ; [section code]
