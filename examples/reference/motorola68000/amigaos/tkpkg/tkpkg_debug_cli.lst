----                             2431  ; ---------------------------------------------------------------------------  ; [section code]
----                             2432  ; Native token record staging and commit.  ; [section code]
----                             2433  ;  ; [section code]
----                             2434  ; Each committed record is 20 bytes in tokenBuffer:  ; [section code]
----                             2435  ; - word 0: token kind code  ; [section code]
----                             2436  ; - long 4: 1-based start column  ; [section code]
----                             2437  ; - long 8: 1-based end column  ; [section code]
----                             2438  ; - long 12: lexemeScratch offset  ; [section code]
----                             2439  ; - long 16: lexeme length in bytes  ; [section code]
----                             2440  ;  ; [section code]
----                             2441  ; This is the compact native surface that the asm tests decode back into the  ; [section code]
----                             2442  ; OPFORGE-TOKVM 1 report format.  ; [section code]
----                             2443  ; ---------------------------------------------------------------------------  ; [section code]
----                             2444    ; [section code]
----                             2445  tokvmCommitPendingToken  ; [section code]
10AA    B2 85                    2446          CMP.L D5, D1  ; token_count < token_capacity  ; [section code]
10AC    64 00 00 56              2447          BCC tokvmPendingTokenOverflow  ; [section code]
10B0    20 03                    2448          MOVE.L D3, D0  ; scratch_used + pending_len must stay within scratch_capacity  ; [section code]
10B2    D0 AA 00 10              2449          ADD.L LOCAL_PENDING_LEX_LEN(A2), D0  ; [section code]
10B6    B0 86                    2450          CMP.L D6, D0  ; [section code]
10B8    62 00 00 52              2451          BHI tokvmPendingLexemeOverflow  ; [section code]
10BC    20 01                    2452          MOVE.L D1, D0  ; compute record_index * TOKEN_RECORD_SIZE without a MUL dependency  ; [section code]
10BE    D0 80                    2453          ADD.L D0, D0  ; *2  ; [section code]
10C0    20 40                    2454          MOVEA.L D0, A0  ; [section code]
10C2    D0 80                    2455          ADD.L D0, D0  ; *4  ; [section code]
10C4    D0 80                    2456          ADD.L D0, D0  ; *8  ; [section code]
10C6    D0 80                    2457          ADD.L D0, D0  ; *16  ; [section code]
10C8    D1 C0                    2458          ADDA.L D0, A0  ; *18  ; [section code]
10CA    20 01                    2459          MOVE.L D1, D0  ; [section code]
10CC    D0 80                    2460          ADD.L D0, D0  ; +2 => *20 byte stride  ; [section code]
10CE    D1 C0                    2461          ADDA.L D0, A0  ; [section code]
10D0    22 4D                    2462          MOVEA.L A5, A1  ; [section code]
10D2    D3 C8                    2463          ADDA.L A0, A1  ; [section code]
10D4    32 AA 00 04              2464          MOVE.W LOCAL_PENDING_KIND(A2), (A1)  ; field 0: token kind code  ; [section code]
10D8    42 69 00 02              2465          CLR.W 2(A1)  ; [section code]
10DC    20 2A 00 08              2466          MOVE.L LOCAL_PENDING_START(A2), D0  ; field 4: 1-based start column  ; [section code]
10E0    52 80                    2467          ADDQ.L #1, D0  ; [section code]
10E2    23 40 00 04              2468          MOVE.L D0, 4(A1)  ; [section code]
10E6    20 2A 00 0C              2469          MOVE.L LOCAL_PENDING_END(A2), D0  ; field 8: 1-based end column  ; [section code]
10EA    52 80                    2470          ADDQ.L #1, D0  ; [section code]
10EC    23 40 00 08              2471          MOVE.L D0, 8(A1)  ; [section code]
10F0    23 43 00 0C              2472          MOVE.L D3, 12(A1)  ; field 12: lexeme offset into scratch  ; [section code]
10F4    23 6A 00 10 00 10        2473          MOVE.L LOCAL_PENDING_LEX_LEN(A2), 16(A1)  ; field 16: lexeme length in bytes  ; [section code]
10FA    52 81                    2474          ADDQ.L #1, D1  ; [section code]
10FC    D6 AA 00 10              2475          ADD.L LOCAL_PENDING_LEX_LEN(A2), D3  ; [section code]
