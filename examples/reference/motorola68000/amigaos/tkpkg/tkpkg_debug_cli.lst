----                             2717  ; Native token record staging and commit.  ; [section code]
----                             2718  ;  ; [section code]
----                             2719  ; Each committed record is 20 bytes in tokenBuffer:  ; [section code]
----                             2720  ; - word 0: token kind code  ; [section code]
----                             2721  ; - long 4: 1-based start column  ; [section code]
----                             2722  ; - long 8: 1-based end column  ; [section code]
----                             2723  ; - long 12: lexemeScratch offset  ; [section code]
----                             2724  ; - long 16: lexeme length in bytes  ; [section code]
----                             2725  ;  ; [section code]
----                             2726  ; This is the compact native surface that the asm tests decode back into the  ; [section code]
