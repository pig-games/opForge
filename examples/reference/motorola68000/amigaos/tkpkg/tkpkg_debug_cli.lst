----                             1930          .section code, kind=code  ; [section code]
----                             1931    ; [section code]
----                             1932  ; ---------------------------------------------------------------------------  ; [section code]
----                             1933  ; Native tokenizer VM interpreter.  ; [section code]
----                             1934  ;  ; [section code]
----                             1935  ; This interpreter executes the tokenizer bytecode against one line-buffer-backed  ; [section code]
----                             1936  ; input stream. Its control flow mirrors the Rust tokenizer VM loop in  ; [section code]
----                             1937  ; crates/opforge-vm/src/runtime_model_core.rs:  ; [section code]
----                             1938  ; - validate arguments and stream constraints  ; [section code]
----                             1939  ; - keep source cursor in D2 and program counter in A0  ; [section code]
----                             1940  ; - decode opcodes from the bytecode stream in A3..A3+D7  ; [section code]
----                             1941  ; - dispatch scan/predicate helpers that mirror tokenizer_runtime_utils.rs  ; [section code]
----                             1942  ; - emit compact native token records into the caller-provided token buffer  ; [section code]
----                             1943  ; ---------------------------------------------------------------------------  ; [section code]
----                             1944    ; [section code]
----                             1945  tokvm_set_step_budget_68000  ; [section code]
0B70    4A 80                    1946          TST.L D0  ; [section code]
0B72    6E 06                    1947          BGT.S tokvmSetStepBudgetStore  ; [section code]
0B74    20 3C 00 00 08 00        1948          MOVE.L #TOKVM_DEFAULT_MAX_STEPS_PER_LINE, D0  ; [section code]
----                             1949  tokvmSetStepBudgetStore  ; [section code]
0B7A    23 C0 00 00 02 4D        1950          MOVE.L D0, tokvmStepBudget  ; [section code]
0B80    4E 75                    1951          RTS  ; [section code]
----                             1952    ; [section code]
----                             1953  tokvm_set_program_state_table_68000  ; [section code]
0B82    4A 80                    1954          TST.L D0  ; [section code]
0B84    6E 0A                    1955          BGT.S tokvmSetProgramStateStore  ; [section code]
0B86    41 F9 00 00 02 51        1956          LEA demoStateEntryOffsets, A0  ; [section code]
