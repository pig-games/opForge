----    EQU 0007                 1822  TK_KIND_DOT                     = 7
----    EQU 0008                 1823  TK_KIND_HASH                    = 8
----    EQU 0009                 1824  TK_KIND_QUESTION                = 9
----    EQU 000A                 1825  TK_KIND_OPEN_BRACKET            = 10
----    EQU 000B                 1826  TK_KIND_CLOSE_BRACKET           = 11
----    EQU 000C                 1827  TK_KIND_OPEN_BRACE              = 12
----    EQU 000D                 1828  TK_KIND_CLOSE_BRACE             = 13
----    EQU 000E                 1829  TK_KIND_OPEN_PAREN              = 14
----    EQU 000F                 1830  TK_KIND_CLOSE_PAREN             = 15
