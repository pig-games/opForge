----    EQU 0100                 5379  PATH_BUFFER_CAPACITY            = 256
----    EQU 1000                 5380  DEBUG_CLI_SOURCE_BUFFER_CAPACITY = 4096
----    EQU 01FC                 5381  DEBUG_CLI_MAX_LINE_BYTES        = LAST_ERROR_BUFFER_CAPACITY - 4
----                             5382  
