----                             2516  ; Scanner helpers.  ; [section code]
----                             2517  ;  ; [section code]
----                             2518  ; These are the native counterparts of the Rust tokenizer helper routines in  ; [section code]
----                             2519  ; tokenizer_runtime_utils.rs. Each helper advances D2 as the live source cursor,  ; [section code]
----                             2520  ; populates LOCAL_PENDING_* metadata, stages lexeme bytes into the scratch  ; [section code]
----                             2521  ; buffer, then commits a token record.  ; [section code]
----                             2522  ; ---------------------------------------------------------------------------  ; [section code]
----                             2523    ; [section code]
