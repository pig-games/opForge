----                             1864  
----                             1865  ; The default demo program currently uses only the same first five character
----                             1866  ; classes consumed by vm_char_class_matches in tokenizer_runtime_utils.rs.
----    EQU 0001                 1867  TK_CLASS_WHITESPACE             = 1
----    EQU 0002                 1868  TK_CLASS_IDENTIFIER_START       = 2
----    EQU 0003                 1869  TK_CLASS_IDENTIFIER_CONTINUE    = 3
----    EQU 0004                 1870  TK_CLASS_DIGIT                  = 4
----    EQU 0005                 1871  TK_CLASS_QUOTE                  = 5
----                             1872  
----                             1873  ; Program-counter labels for demoProgram. These offsets intentionally match the
----                             1874  ; little-endian jump targets emitted by the Rust builder default loop.
----    EQU 0000                 1875  DEMO_PC_READ_CHAR               = 0
----    EQU 0024                 1876  DEMO_PC_SCAN_SYMBOL             = 36
----    EQU 002A                 1877  DEMO_PC_SKIP_WHITESPACE         = 42
----    EQU 0030                 1878  DEMO_PC_SCAN_IDENTIFIER         = 48
----    EQU 0036                 1879  DEMO_PC_SCAN_NUMBER             = 54
----    EQU 003C                 1880  DEMO_PC_SCAN_STRING             = 60
----    EQU 0042                 1881  DEMO_PC_FINISH                  = 66
----                             1882  
----    EQU 0014                 1883  TOKEN_RECORD_SIZE               = 20
----    EQU 0400                 1884  SOURCE_BUFFER_CAPACITY          = 1024
----    EQU 0040                 1885  TOKEN_BUFFER_CAPACITY           = 64
----    EQU 0400                 1886  SCRATCH_BUFFER_CAPACITY         = 1024
----    EQU 0800                 1887  TOKVM_DEFAULT_MAX_STEPS_PER_LINE = 2048
----                             1888  
----                             1889  ; The fixed capacities above intentionally match the AmigaOS host harness so the
----                             1890  ; native VM and the CLI/report layer agree on how much source, token, and scratch
----                             1891  ; state can be exchanged without any additional negotiation structure.
----                             1892  
----                             1893  ; tokvm_run_68000 local frame layout.
----                             1894  ;
----                             1895  ; Call ABI:
----                             1896  ; - A0 / D0: source buffer pointer and source byte length
----                             1897  ; - A1 / D1: token buffer pointer and token capacity in records
----                             1898  ; - A2 / D2: scratch buffer pointer and scratch capacity in bytes
----                             1899  ; - A3 / D3: tokenizer bytecode pointer and program length in bytes
----                             1900  ;
----                             1901  ; Return ABI:
----                             1902  ; - D0: TK_STATUS_*
----                             1903  ; - D1: emitted token count
----                             1904  ; - D2: final source cursor
----                             1905  ; - D3: scratch bytes committed into lexemeScratch
----    EQU 0000                 1906  LOCAL_CURRENT_BYTE              = 0
----    EQU 0004                 1907  LOCAL_PENDING_KIND              = 4
----    EQU 0008                 1908  LOCAL_PENDING_START             = 8
----    EQU 000C                 1909  LOCAL_PENDING_END               = 12
----    EQU 0010                 1910  LOCAL_PENDING_LEX_LEN           = 16
----    EQU 0014                 1911  LOCAL_TEMP_U32                  = 20
----    EQU 0018                 1912  LOCAL_PROGRAM_COUNTER           = 24
----    EQU 001C                 1913  LOCAL_STEP_COUNT                = 28
----    EQU 0020                 1914  LOCAL_STEP_LIMIT                = 32
----    EQU 0024                 1915  LOCAL_SIZE                      = 36
----                             1916  
