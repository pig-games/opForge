----                             1927          .section code, kind=code  ; [section code]
----                             1928    ; [section code]
----                             1929  ; ---------------------------------------------------------------------------  ; [section code]
----                             1930  ; Native tokenizer VM interpreter.  ; [section code]
----                             1931  ;  ; [section code]
----                             1932  ; This interpreter executes the tokenizer bytecode against one line-buffer-backed  ; [section code]
----                             1933  ; input stream. Its control flow mirrors the Rust tokenizer VM loop in  ; [section code]
----                             1934  ; crates/opforge-vm/src/runtime_model_core.rs:  ; [section code]
----                             1935  ; - validate arguments and stream constraints  ; [section code]
----                             1936  ; - keep source cursor in D2 and program counter in A0  ; [section code]
----                             1937  ; - decode opcodes from the bytecode stream in A3..A3+D7  ; [section code]
----                             1938  ; - dispatch scan/predicate helpers that mirror tokenizer_runtime_utils.rs  ; [section code]
----                             1939  ; - emit compact native token records into the caller-provided token buffer  ; [section code]
----                             1940  ; ---------------------------------------------------------------------------  ; [section code]
----                             1941    ; [section code]
----                             1942  tokvm_set_step_budget_68000  ; [section code]
0B72    4A 80                    1943          TST.L D0  ; [section code]
0B74    6E 06                    1944          BGT.S tokvmSetStepBudgetStore  ; [section code]
0B76    20 3C 00 00 08 00        1945          MOVE.L #TOKVM_DEFAULT_MAX_STEPS_PER_LINE, D0  ; [section code]
----                             1946  tokvmSetStepBudgetStore  ; [section code]
0B7C    23 C0 00 00 02 4D        1947          MOVE.L D0, tokvmStepBudget  ; [section code]
0B82    4E 75                    1948          RTS  ; [section code]
----                             1949    ; [section code]
----                             1950  tokvm_set_program_state_table_68000  ; [section code]
0B84    4A 80                    1951          TST.L D0  ; [section code]
0B86    6E 0A                    1952          BGT.S tokvmSetProgramStateStore  ; [section code]
0B88    41 F9 00 00 02 51        1953          LEA demoStateEntryOffsets, A0  ; [section code]
0B8E    70 01                    1954          MOVEQ #1, D0  ; [section code]
0B90    72 00                    1955          MOVEQ #0, D1  ; [section code]
----                             1956  tokvmSetProgramStateStore  ; [section code]
