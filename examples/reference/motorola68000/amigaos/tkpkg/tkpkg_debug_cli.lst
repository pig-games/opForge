----                             2529  ; ---------------------------------------------------------------------------  ; [section code]
----                             2530  ; Scanner helpers.  ; [section code]
----                             2531  ;  ; [section code]
----                             2532  ; These are the native counterparts of the Rust tokenizer helper routines in  ; [section code]
----                             2533  ; tokenizer_runtime_utils.rs. Each helper advances D2 as the live source cursor,  ; [section code]
----                             2534  ; populates LOCAL_PENDING_* metadata, stages lexeme bytes into the scratch  ; [section code]
----                             2535  ; buffer, then commits a token record.  ; [section code]
