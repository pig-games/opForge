----    EQU 0001                 1805  TK_OPCODE_READ_CHAR             = 1
----    EQU 0002                 1806  TK_OPCODE_ADVANCE               = 2
----    EQU 0003                 1807  TK_OPCODE_START_LEXEME          = 3
----    EQU 0004                 1808  TK_OPCODE_PUSH_CHAR             = 4
----    EQU 0005                 1809  TK_OPCODE_EMIT_TOKEN            = 5
----    EQU 0006                 1810  TK_OPCODE_SET_STATE             = 6
----    EQU 0007                 1811  TK_OPCODE_JUMP                  = 7
----    EQU 0008                 1812  TK_OPCODE_JUMP_IF_EOL           = 8
----    EQU 0009                 1813  TK_OPCODE_JUMP_IF_BYTE_EQ       = 9
----    EQU 000A                 1814  TK_OPCODE_JUMP_IF_CLASS         = 10
----    EQU 000B                 1815  TK_OPCODE_FAIL                  = 11
----    EQU 000C                 1816  TK_OPCODE_EMIT_DIAG             = 12
----    EQU 000E                 1817  TK_OPCODE_SCAN_CORE             = 14
----    EQU 000F                 1818  TK_OPCODE_SCAN_IDENTIFIER       = 15
