----                             5351  ; Thin AmigaOS CLI smoke wrapper for the package-backed tkpkg runtime.
----                             5352  ;
----                             5353  ; This slice exercises init, load_package, set_pipeline, tokenize_line, and
----                             5354  ; last_error without folding CLI/report concerns into the core runtime modules.
----                             5355  
----                             5356          .module main
----                             5357          .cpu 68020
----                             5358          .use tkpkg.amigaos.abi (ENTRY_ORD_INIT, ENTRY_ORD_LOAD_PACKAGE)
----                             5359          .use tkpkg.amigaos.abi (ENTRY_ORD_SET_PIPELINE, ENTRY_ORD_TOKENIZE_LINE)
----                             5360          .use tkpkg.amigaos.abi (ENTRY_ORD_LAST_ERROR, TOKENIZE_LINE_SAMPLE_LINE_NUM)
----                             5361          .use tkpkg.amigaos.abi (CB_INPUT_PTR, CB_INPUT_LEN, CB_OUTPUT_LEN, CB_STATUS_CODE)
----                             5362          .use tkpkg.amigaos.buffers (controlBlockV1, lastErrorBuffer, packageStorage)
----                             5363          .use tkpkg.amigaos.buffers (LAST_ERROR_BUFFER_PTR_V1, LAST_ERROR_BUFFER_CAPACITY)
----                             5364          .use tkpkg.amigaos.service (tkpkg_service_dispatch_v1)
----                             5365  
