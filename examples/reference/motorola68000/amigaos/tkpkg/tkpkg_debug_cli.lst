----                             2159  
----                             2160  ; The default demo program currently uses only the same first five character
----                             2161  ; classes consumed by vm_char_class_matches in tokenizer_runtime_utils.rs.
----    EQU 0001                 2162  TK_CLASS_WHITESPACE             = 1
----    EQU 0002                 2163  TK_CLASS_IDENTIFIER_START       = 2
----    EQU 0003                 2164  TK_CLASS_IDENTIFIER_CONTINUE    = 3
----    EQU 0004                 2165  TK_CLASS_DIGIT                  = 4
----    EQU 0005                 2166  TK_CLASS_QUOTE                  = 5
----                             2167  
----                             2168  ; Program-counter labels for demoProgram. These offsets intentionally match the
----                             2169  ; little-endian jump targets emitted by the Rust builder default loop.
----    EQU 0000                 2170  DEMO_PC_READ_CHAR               = 0
----    EQU 0024                 2171  DEMO_PC_SCAN_SYMBOL             = 36
----    EQU 002A                 2172  DEMO_PC_SKIP_WHITESPACE         = 42
----    EQU 0030                 2173  DEMO_PC_SCAN_IDENTIFIER         = 48
----    EQU 0036                 2174  DEMO_PC_SCAN_NUMBER             = 54
----    EQU 003C                 2175  DEMO_PC_SCAN_STRING             = 60
----    EQU 0042                 2176  DEMO_PC_FINISH                  = 66
----                             2177  
----    EQU 0014                 2178  TOKEN_RECORD_SIZE               = 20
----    EQU 0400                 2179  SOURCE_BUFFER_CAPACITY          = 1024
----    EQU 0040                 2180  TOKEN_BUFFER_CAPACITY           = 64
----    EQU 0400                 2181  SCRATCH_BUFFER_CAPACITY         = 1024
----    EQU 0800                 2182  TOKVM_DEFAULT_MAX_STEPS_PER_LINE = 2048
----                             2183  
----                             2184  ; The fixed capacities above intentionally match the AmigaOS host harness so the
----                             2185  ; native VM and the CLI/report layer agree on how much source, token, and scratch
----                             2186  ; state can be exchanged without any additional negotiation structure.
----                             2187  
----                             2188  ; tokvm_run_68000 local frame layout.
----                             2189  ;
----                             2190  ; Call ABI:
----                             2191  ; - A0 / D0: source buffer pointer and source byte length
----                             2192  ; - A1 / D1: token buffer pointer and token capacity in records
----                             2193  ; - A2 / D2: scratch buffer pointer and scratch capacity in bytes
----                             2194  ; - A3 / D3: tokenizer bytecode pointer and program length in bytes
----                             2195  ;
----                             2196  ; Return ABI:
----                             2197  ; - D0: TK_STATUS_*
----                             2198  ; - D1: emitted token count
----                             2199  ; - D2: final source cursor
----                             2200  ; - D3: scratch bytes committed into lexemeScratch
----    EQU 0000                 2201  LOCAL_CURRENT_BYTE              = 0
----    EQU 0004                 2202  LOCAL_PENDING_KIND              = 4
----    EQU 0008                 2203  LOCAL_PENDING_START             = 8
----    EQU 000C                 2204  LOCAL_PENDING_END               = 12
----    EQU 0010                 2205  LOCAL_PENDING_LEX_LEN           = 16
----    EQU 0014                 2206  LOCAL_TEMP_U32                  = 20
----    EQU 0018                 2207  LOCAL_PROGRAM_COUNTER           = 24
----    EQU 001C                 2208  LOCAL_STEP_COUNT                = 28
----    EQU 0020                 2209  LOCAL_STEP_LIMIT                = 32
----    EQU 0024                 2210  LOCAL_SIZE                      = 36
