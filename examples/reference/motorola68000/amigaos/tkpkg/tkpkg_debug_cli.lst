----                             1854  
----                             1855  ; The default demo program currently uses only the same first five character
----                             1856  ; classes consumed by vm_char_class_matches in tokenizer_runtime_utils.rs.
----    EQU 0001                 1857  TK_CLASS_WHITESPACE             = 1
----    EQU 0002                 1858  TK_CLASS_IDENTIFIER_START       = 2
----    EQU 0003                 1859  TK_CLASS_IDENTIFIER_CONTINUE    = 3
----    EQU 0004                 1860  TK_CLASS_DIGIT                  = 4
----    EQU 0005                 1861  TK_CLASS_QUOTE                  = 5
----                             1862  
----                             1863  ; Program-counter labels for demoProgram. These offsets intentionally match the
----                             1864  ; little-endian jump targets emitted by the Rust builder default loop.
----    EQU 0000                 1865  DEMO_PC_READ_CHAR               = 0
----    EQU 0024                 1866  DEMO_PC_SCAN_SYMBOL             = 36
----    EQU 002A                 1867  DEMO_PC_SKIP_WHITESPACE         = 42
----    EQU 0030                 1868  DEMO_PC_SCAN_IDENTIFIER         = 48
----    EQU 0036                 1869  DEMO_PC_SCAN_NUMBER             = 54
----    EQU 003C                 1870  DEMO_PC_SCAN_STRING             = 60
----    EQU 0042                 1871  DEMO_PC_FINISH                  = 66
----                             1872  
----    EQU 0014                 1873  TOKEN_RECORD_SIZE               = 20
----    EQU 0400                 1874  SOURCE_BUFFER_CAPACITY          = 1024
----    EQU 0040                 1875  TOKEN_BUFFER_CAPACITY           = 64
----    EQU 0400                 1876  SCRATCH_BUFFER_CAPACITY         = 1024
----    EQU 0800                 1877  TOKVM_DEFAULT_MAX_STEPS_PER_LINE = 2048
----                             1878  
----                             1879  ; The fixed capacities above intentionally match the AmigaOS host harness so the
----                             1880  ; native VM and the CLI/report layer agree on how much source, token, and scratch
----                             1881  ; state can be exchanged without any additional negotiation structure.
----                             1882  
----                             1883  ; tokvm_run_68000 local frame layout.
----                             1884  ;
----                             1885  ; Call ABI:
----                             1886  ; - A0 / D0: source buffer pointer and source byte length
----                             1887  ; - A1 / D1: token buffer pointer and token capacity in records
----                             1888  ; - A2 / D2: scratch buffer pointer and scratch capacity in bytes
----                             1889  ; - A3 / D3: tokenizer bytecode pointer and program length in bytes
----                             1890  ;
----                             1891  ; Return ABI:
----                             1892  ; - D0: TK_STATUS_*
----                             1893  ; - D1: emitted token count
----                             1894  ; - D2: final source cursor
----                             1895  ; - D3: scratch bytes committed into lexemeScratch
----    EQU 0000                 1896  LOCAL_CURRENT_BYTE              = 0
----    EQU 0004                 1897  LOCAL_PENDING_KIND              = 4
----    EQU 0008                 1898  LOCAL_PENDING_START             = 8
----    EQU 000C                 1899  LOCAL_PENDING_END               = 12
----    EQU 0010                 1900  LOCAL_PENDING_LEX_LEN           = 16
----    EQU 0014                 1901  LOCAL_TEMP_U32                  = 20
----    EQU 0018                 1902  LOCAL_PROGRAM_COUNTER           = 24
----    EQU 001C                 1903  LOCAL_STEP_COUNT                = 28
----    EQU 0020                 1904  LOCAL_STEP_LIMIT                = 32
----    EQU 0024                 1905  LOCAL_SIZE                      = 36
