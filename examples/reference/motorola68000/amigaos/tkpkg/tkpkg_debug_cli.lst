----                             2513    ; [section code]
----                             2514  ; ---------------------------------------------------------------------------  ; [section code]
----                             2515  ; Scanner helpers.  ; [section code]
----                             2516  ;  ; [section code]
----                             2517  ; These are the native counterparts of the Rust tokenizer helper routines in  ; [section code]
----                             2518  ; tokenizer_runtime_utils.rs. Each helper advances D2 as the live source cursor,  ; [section code]
----                             2519  ; populates LOCAL_PENDING_* metadata, stages lexeme bytes into the scratch  ; [section code]
----                             2520  ; buffer, then commits a token record.  ; [section code]
----                             2521  ; ---------------------------------------------------------------------------  ; [section code]
----                             2522    ; [section code]
----                             2523  tokvmScanIdentifierToken  ; [section code]
----                             2524          ; Identifier scan is the native mirror of vm_scan_identifier_token():  ; [section code]
----                             2525          ; walk identifier-continue bytes, lowercase ASCII letters for the demo  ; [section code]
----                             2526          ; policy, then emit one identifier record backed by scratch bytes.  ; [section code]
10EC    25 42 00 08              2527          MOVE.L D2, LOCAL_PENDING_START(A2)  ; [section code]
10F0    42 AA 00 10              2528          CLR.L LOCAL_PENDING_LEX_LEN(A2)  ; [section code]
10F4    20 4E                    2529          MOVEA.L A6, A0  ; [section code]
10F6    D1 C3                    2530          ADDA.L D3, A0  ; [section code]
----                             2531    ; [section code]
----                             2532  tokvmScanIdentifierLoop  ; [section code]
----                             2533          ; D2 stays as the source cursor, A0 walks the next free scratch byte,  ; [section code]
----                             2534          ; and LOCAL_PENDING_LEX_LEN grows in lockstep so commit can later write  ; [section code]
----                             2535          ; both the source span and scratch payload length into the token record.  ; [section code]
