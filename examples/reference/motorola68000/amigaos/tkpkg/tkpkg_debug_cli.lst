1320    20 01                    2763          MOVE.L D1, D0  ; compute record_index * TOKEN_RECORD_SIZE without a MUL dependency  ; [section code]
1322    D0 80                    2764          ADD.L D0, D0  ; *2  ; [section code]
1324    20 40                    2765          MOVEA.L D0, A0  ; [section code]
1326    D0 80                    2766          ADD.L D0, D0  ; *4  ; [section code]
1328    D0 80                    2767          ADD.L D0, D0  ; *8  ; [section code]
132A    D0 80                    2768          ADD.L D0, D0  ; *16  ; [section code]
132C    D1 C0                    2769          ADDA.L D0, A0  ; *18  ; [section code]
132E    20 01                    2770          MOVE.L D1, D0  ; [section code]
1330    D0 80                    2771          ADD.L D0, D0  ; +2 => *20 byte stride  ; [section code]
1332    D1 C0                    2772          ADDA.L D0, A0  ; [section code]
1334    22 4D                    2773          MOVEA.L A5, A1  ; [section code]
