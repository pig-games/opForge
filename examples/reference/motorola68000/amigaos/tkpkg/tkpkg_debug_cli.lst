----                             3743  ; The emit* helpers encode the same little-endian jump-target format produced by  ; [section data]
----                             3744  ; Rust's default_family_tokenizer_vm_program_bytes(). Keep demoProgram and the  ; [section data]
----                             3745  ; DEMO_PC_* offsets together so the control-flow map stays readable.  ; [section data]
----                             3746    ; [section data]
----                             3747    ; [section data]
----                             3748    ; [section data]
----                             3749    ; [section data]
----                             3750  ; Default tokenizer VM loop for this native example.  ; [section data]
----                             3751  ; This intentionally mirrors crates/opforge-vm/src/builder.rs:  ; [section data]
----                             3752  ; - ReadChar  ; [section data]
----                             3753  ; - if EOL -> End  ; [section data]
----                             3754  ; - if whitespace -> Advance and loop  ; [section data]
----                             3755  ; - if '.' or symbol-leading punctuation -> ScanSymbol  ; [section data]
----                             3756  ; - if identifier-start -> ScanIdentifier  ; [section data]
----                             3757  ; - if digit -> ScanNumber  ; [section data]
----                             3758  ; - if quote -> ScanString  ; [section data]
----                             3759  ;  ; [section data]
----                             3760  ; The bytecode below is the readable assembler mirror of builder.rs  ; [section data]
----                             3761  ; default_family_tokenizer_vm_program_bytes(): read char, branch by class, then loop.  ; [section data]
----                             3762  demoProgram  ; [section data]
----                             3763  demoReadChar  ; [section data]
0278    01                       3764          .byte TK_OPCODE_READ_CHAR  ; [section data]
----                             3765          .block  ; [section data]
----                             3766          ; Macros keep the demo bytecode readable without obscuring the exact byte  ; [section data]
----                             3767          ; sequence that the Rust builder would emit.  ; [section data]
0279    08                       3768          .byte TK_OPCODE_JUMP_IF_EOL  ; [section data]
----                             3769          .block  ; [section data]
----                             3770          ; Keep jump targets readable in source while still emitting the same  ; [section data]
----                             3771          ; little-endian u32 layout as builder.rs and the Rust VM loader expect.  ; [section data]
027A    42                       3772          .byte (DEMO_PC_FINISH) & $ff  ; [section data]
027B    00                       3773          .byte ((DEMO_PC_FINISH) >> 8) & $ff  ; [section data]
027C    00                       3774          .byte ((DEMO_PC_FINISH) >> 16) & $ff  ; [section data]
027D    00                       3775          .byte ((DEMO_PC_FINISH) >> 24) & $ff  ; [section data]
----                             3776          .endblock  ; [section data]
----                             3777          .endblock  ; [section data]
----                             3778          .block  ; [section data]
