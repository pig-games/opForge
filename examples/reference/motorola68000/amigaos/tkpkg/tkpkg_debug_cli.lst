----                             5544  ; Thin AmigaOS CLI smoke wrapper for the package-backed tkpkg runtime.
----                             5545  ;
----                             5546  ; This slice exercises init, load_package, set_pipeline, tokenize_line, and
----                             5547  ; last_error without folding CLI/report concerns into the core runtime modules.
----                             5548  
----                             5549          .module main
----                             5550          .cpu 68020
