----                             1561  ; Default tokenizer VM loop for this native example.  ; [section data]
----                             1562  ; This intentionally mirrors crates/opforge-vm/src/builder.rs:  ; [section data]
----                             1563  ; - ReadChar  ; [section data]
----                             1564  ; - if EOL -> End  ; [section data]
----                             1565  ; - if whitespace -> Advance and loop  ; [section data]
----                             1566  ; - if '.' or symbol-leading punctuation -> ScanSymbol  ; [section data]
----                             1567  ; - if identifier-start -> ScanIdentifier  ; [section data]
----                             1568  ; - if digit -> ScanNumber  ; [section data]
----                             1569  ; - if quote -> ScanString  ; [section data]
----                             1570  ;  ; [section data]
----                             1571  ; The bytecode below is the readable assembler mirror of builder.rs  ; [section data]
----                             1572  ; default_family_tokenizer_vm_program_bytes(): read char, branch by class, then loop.  ; [section data]
----                             1573  demoProgram  ; [section data]
----                             1574  demoReadChar  ; [section data]
002B    01                       1575          .byte TK_OPCODE_READ_CHAR  ; [section data]
----                             1576          .block  ; [section data]
----                             1577          ; Macros keep the demo bytecode readable without obscuring the exact byte  ; [section data]
----                             1578          ; sequence that the Rust builder would emit.  ; [section data]
002C    08                       1579          .byte TK_OPCODE_JUMP_IF_EOL  ; [section data]
----                             1580          .block  ; [section data]
----                             1581          ; Keep jump targets readable in source while still emitting the same  ; [section data]
----                             1582          ; little-endian u32 layout as builder.rs and the Rust VM loader expect.  ; [section data]
