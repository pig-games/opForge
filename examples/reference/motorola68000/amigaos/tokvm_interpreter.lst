----                              105  
----                              106  ; The fixed capacities above intentionally match the AmigaOS host harness so the
----                              107  ; native VM and the CLI/report layer agree on how much source, token, and scratch
----                              108  ; state can be exchanged without any additional negotiation structure.
----                              109  
----                              110  ; tokvm_run_68000 local frame layout.
----                              111  ;
----                              112  ; Call ABI:
----                              113  ; - A0 / D0: source buffer pointer and source byte length
----                              114  ; - A1 / D1: token buffer pointer and token capacity in records
----                              115  ; - A2 / D2: scratch buffer pointer and scratch capacity in bytes
----                              116  ; - A3 / D3: tokenizer bytecode pointer and program length in bytes
----                              117  ;
----                              118  ; Return ABI:
----                              119  ; - D0: TK_STATUS_*
----                              120  ; - D1: emitted token count
----                              121  ; - D2: final source cursor
----                              122  ; - D3: scratch bytes committed into lexemeScratch
----    EQU 0000                  123  LOCAL_CURRENT_BYTE              = 0
----    EQU 0004                  124  LOCAL_PENDING_KIND              = 4
----    EQU 0008                  125  LOCAL_PENDING_START             = 8
----    EQU 000C                  126  LOCAL_PENDING_END               = 12
----    EQU 0010                  127  LOCAL_PENDING_LEX_LEN           = 16
----    EQU 0014                  128  LOCAL_TEMP_U32                  = 20
----    EQU 0018                  129  LOCAL_PROGRAM_COUNTER           = 24
----    EQU 001C                  130  LOCAL_STEP_COUNT                = 28
----    EQU 0020                  131  LOCAL_STEP_LIMIT                = 32
----    EQU 0024                  132  LOCAL_SIZE                      = 36
