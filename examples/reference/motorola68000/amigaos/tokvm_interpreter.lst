----                              795  tokvmScanNumberToken  ; [section code]
----                              796          ; Number scan accepts the same permissive body bytes as the Rust helper,  ; [section code]
----                              797          ; leaving base interpretation to downstream token consumers/report logic.  ; [section code]
05D0    25 42 00 08               798          MOVE.L D2, LOCAL_PENDING_START(A2)  ; [section code]
05D4    42 AA 00 10               799          CLR.L LOCAL_PENDING_LEX_LEN(A2)  ; [section code]
05D8    20 4E                     800          MOVEA.L A6, A0  ; [section code]
05DA    D1 C3                     801          ADDA.L D3, A0  ; [section code]
