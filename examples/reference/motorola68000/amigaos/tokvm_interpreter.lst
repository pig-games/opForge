066C    42 AA 00 10               859          CLR.L LOCAL_PENDING_LEX_LEN(A2)  ; [section code]
0670    70 00                     860          MOVEQ #0, D0  ; [section code]
0672    10 34 28 00               861          MOVE.B 0(A4, D2.L), D0  ; remember whether the string opened with ' or " so we can require the same closer  ; [section code]
0676    25 40 00 00               862          MOVE.L D0, LOCAL_CURRENT_BYTE(A2)  ; [section code]
067A    52 82                     863          ADDQ.L #1, D2  ; [section code]
067C    20 4E                     864          MOVEA.L A6, A0  ; [section code]
