05C4    25 42 00 0C               791          MOVE.L D2, LOCAL_PENDING_END(A2)  ; [section code]
05C8    4E B9 00 00 04 D4         792          JSR tokvmCommitPendingToken  ; [section code]
05CE    4E 75                     793          RTS  ; [section code]
