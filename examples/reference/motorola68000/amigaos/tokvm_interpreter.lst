----                             2898  ; Native AmigaOS 68020-baseline tokenizer VM executable.
----                             2899  ;
----                             2900  ; This root file is now a true composition module: it owns only the Amiga entry
----                             2901  ; path and pulls the CLI harness and tokenizer VM in through `.use`.
----                             2902  
----                             2903          .module main
----                             2904          .cpu 68020
----                             2905          .use tokvm.amigaos.cli_harness (SysBase, pr_CLI, pr_MsgPort)
----                             2906          .use tokvm.amigaos.cli_harness (FindTask, WaitPort, GetMsg, ReplyMsg, Forbid)
----                             2907          .use tokvm.amigaos.cli_harness (RETURN_WORKBENCH_UNSUPPORTED, tokvm_amigaos_cli_harness_run)
----                             2908          .use tokvm.amigaos.tokenizer_vm (abiMarker)
----                             2909  
----                             2910          .section entry, kind=code  ; [section entry]
----                             2911    ; [section entry]
----                             2912  ; ---------------------------------------------------------------------------  ; [section entry]
----                             2913  ; AmigaOS process entry.  ; [section entry]
----                             2914  ;  ; [section entry]
----                             2915  ; Workbench launches are rejected because this first native slice is a Shell  ; [section entry]
----                             2916  ; tool with a narrow CLI/file-I/O contract. Once CLI execution is confirmed, we  ; [section entry]
----                             2917  ; hand off to the imported tokvm.amigaos.cli_harness module.  ; [section entry]
----                             2918  ; ---------------------------------------------------------------------------  ; [section entry]
----                             2919    ; [section entry]
----                             2920  start  ; [section entry]
0000    48 E7 3F 3E              2921          MOVEM.L D2-D7/A2-A6, -(SP)  ; preserve callee-owned state across the CLI harness call  ; [section entry]
0004    42 82                    2922          CLR.L D2  ; no Workbench startup message is pending until GetMsg succeeds  ; [section entry]
----                             2923    ; [section entry]
0006    93 C9                    2924          SUBA.L A1, A1  ; Exec FindTask(NULL) => current process, same host contract as C/Rust launchers  ; [section entry]
0008    2C 78 00 04              2925          MOVEA.L SysBase.W, A6  ; Exec base for FindTask/WaitPort/GetMsg/ReplyMsg/Forbid  ; [section entry]
000C    4E AE FE DA              2926          JSR FindTask(A6)  ; [section entry]
----                             2927    ; [section entry]
0010    24 40                    2928          MOVEA.L D0, A2  ; [section entry]
0012    4A AA 00 AC              2929          TST.L pr_CLI(A2)  ; tokvm's first native slice only supports Shell launches, not Workbench icons  ; [section entry]
0016    66 00 00 1A              2930          BNE.W startCli  ; [section entry]
----                             2931    ; [section entry]
001A    41 EA 00 5C              2932          LEA pr_MsgPort(A2), A0  ; [section entry]
001E    4E AE FE 80              2933          JSR WaitPort(A6)  ; [section entry]
0022    41 EA 00 5C              2934          LEA pr_MsgPort(A2), A0  ; [section entry]
0026    4E AE FE 8C              2935          JSR GetMsg(A6)  ; [section entry]
002A    24 00                    2936          MOVE.L D0, D2  ; cache the startup message so we can ReplyMsg before returning  ; [section entry]
002C    7E 19                    2937          MOVEQ #RETURN_WORKBENCH_UNSUPPORTED, D7  ; host-visible status for unsupported Workbench activation  ; [section entry]
002E    60 00 00 0A              2938          BRA.W startReply  ; [section entry]
----                             2939    ; [section entry]
----                             2940  startCli  ; [section entry]
0032    4E B9 00 00 0D 70        2941          JSR tokvm_amigaos_cli_harness_run  ; hand off to the module that mirrors the Rust host/report bridge  ; [section entry]
0038    2E 00                    2942          MOVE.L D0, D7  ; keep the CLI/report status live through the reply/epilogue path  ; [section entry]
----                             2943    ; [section entry]
----                             2944  startReply  ; [section entry]
003A    4A 82                    2945          TST.L D2  ; only Workbench launches require a reply to the startup message  ; [section entry]
003C    67 00 00 0C              2946          BEQ.W startDone  ; [section entry]
0040    4E AE FF 7C              2947          JSR Forbid(A6)  ; [section entry]
0044    22 42                    2948          MOVEA.L D2, A1  ; [section entry]
0046    4E AE FE 86              2949          JSR ReplyMsg(A6)  ; [section entry]
----                             2950    ; [section entry]
----                             2951  startDone  ; [section entry]
004A    20 07                    2952          MOVE.L D7, D0  ; Amiga return register carries the harness/native VM outcome  ; [section entry]
004C    4C DF 7C FC              2953          MOVEM.L (SP)+, D2-D7/A2-A6  ; [section entry]
0050    4E 75                    2954          RTS  ; [section entry]
