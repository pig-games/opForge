05E0    20 03                     799          MOVE.L D3, D0  ; [section code]
05E2    D0 AA 00 10               800          ADD.L LOCAL_PENDING_LEX_LEN(A2), D0  ; [section code]
05E6    B0 86                     801          CMP.L D6, D0  ; [section code]
05E8    64 00 06 8E               802          BCC tokvmPendingLexemeOverflowFromScan  ; [section code]
05EC    10 FC 00 27               803          MOVE.B #39, (A0)+  ; [section code]
05F0    52 82                     804          ADDQ.L #1, D2  ; [section code]
05F2    52 AA 00 10               805          ADDQ.L #1, LOCAL_PENDING_LEX_LEN(A2)  ; [section code]
