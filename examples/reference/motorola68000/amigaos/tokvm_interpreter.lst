----                              104  
----                              105  ; The fixed capacities above intentionally match the AmigaOS host harness so the
----                              106  ; native VM and the CLI/report layer agree on how much source, token, and scratch
----                              107  ; state can be exchanged without any additional negotiation structure.
----                              108  
----                              109  ; tokvm_run_68000 local frame layout.
----                              110  ;
----                              111  ; Call ABI:
----                              112  ; - A0 / D0: source buffer pointer and source byte length
----                              113  ; - A1 / D1: token buffer pointer and token capacity in records
----                              114  ; - A2 / D2: scratch buffer pointer and scratch capacity in bytes
----                              115  ; - A3 / D3: tokenizer bytecode pointer and program length in bytes
----                              116  ;
----                              117  ; Return ABI:
----                              118  ; - D0: TK_STATUS_*
----                              119  ; - D1: emitted token count
----                              120  ; - D2: final source cursor
----                              121  ; - D3: scratch bytes committed into lexemeScratch
----    EQU 0000                  122  LOCAL_CURRENT_BYTE              = 0
----    EQU 0004                  123  LOCAL_PENDING_KIND              = 4
----    EQU 0008                  124  LOCAL_PENDING_START             = 8
----    EQU 000C                  125  LOCAL_PENDING_END               = 12
----    EQU 0010                  126  LOCAL_PENDING_LEX_LEN           = 16
----    EQU 0014                  127  LOCAL_TEMP_U32                  = 20
----    EQU 0018                  128  LOCAL_PROGRAM_COUNTER           = 24
----    EQU 001C                  129  LOCAL_STEP_COUNT                = 28
----    EQU 0020                  130  LOCAL_STEP_LIMIT                = 32
----    EQU 0024                  131  LOCAL_SIZE                      = 36
