----                             1697  ; This intentionally mirrors crates/opforge-vm/src/builder.rs:  ; [section data]
----                             1698  ; - ReadChar  ; [section data]
----                             1699  ; - if EOL -> End  ; [section data]
----                             1700  ; - if whitespace -> Advance and loop  ; [section data]
----                             1701  ; - if '.' or symbol-leading punctuation -> ScanSymbol  ; [section data]
----                             1702  ; - if identifier-start -> ScanIdentifier  ; [section data]
----                             1703  ; - if digit -> ScanNumber  ; [section data]
----                             1704  ; - if quote -> ScanString  ; [section data]
----                             1705  ;  ; [section data]
