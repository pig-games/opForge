0F4E    41 F9 00 00 01 10        2058          LEA outputPathBuffer, A0  ; open the report target first so later failure paths can still emit report text  ; [section code]
0F54    61 00 06 5A              2059          BSR.W amigaos_cli_fileio_open_output  ; [section code]
0F58    4A 80                    2060          TST.L D0  ; [section code]
0F5A    66 14                    2061          BNE.S tokvmHarnessOutputOpened  ; [section code]
0F5C    7E 18                    2062          MOVEQ #RETURN_OUTPUT_FAILURE, D7  ; [section code]
