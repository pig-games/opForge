0672    0C 00 00 74               862          CMPI.B #'t', D0  ; [section code]
0676    67 00 00 1A               863          BEQ tokvmStringEscapeTab  ; [section code]
067A    0C 00 00 78               864          CMPI.B #'x', D0  ; \xHH is decoded into one payload byte, just like the Rust helper  ; [section code]
067E    67 00 00 18               865          BEQ tokvmStringEscapeHex  ; [section code]
0682    60 00 00 54               866          BRA tokvmScanStringEmitDecoded  ; [section code]
