----                             1961  ; ---------------------------------------------------------------------------
----                             1962  ; AmigaOS Exec/DOS offsets used by the CLI harness layer.
----                             1963  ; ---------------------------------------------------------------------------
----                             1964  
----    EQU 0004                 1965  SysBase                         = 4
----                             1966  
----    EQU 00AC                 1967  pr_CLI                          = 172
----    EQU 005C                 1968  pr_MsgPort                      = 92
----                             1969  
----    EQU FFFFFDD8             1970  OpenLibrary                     = -552
----    EQU FFFFFE62             1971  CloseLibrary                    = -414
----    EQU FFFFFEDA             1972  FindTask                        = -294
----    EQU FFFFFE80             1973  WaitPort                        = -384
----    EQU FFFFFE8C             1974  GetMsg                          = -372
----    EQU FFFFFE86             1975  ReplyMsg                        = -378
----    EQU FFFFFF7C             1976  Forbid                          = -132
----                             1977  
----    EQU FFFFFFE2             1978  Open                            = -30
----    EQU FFFFFFDC             1979  Close                           = -36
----    EQU FFFFFFD6             1980  Read                            = -42
----    EQU FFFFFFD0             1981  Write                           = -48
----    EQU FFFFFFC4             1982  Output                          = -60
----    EQU FFFFFF7C             1983  IoErr                           = -132
----    EQU FFFFFDEA             1984  GetArgStr                       = -534
----                             1985  
----    EQU 03ED                 1986  MODE_OLDFILE                    = 1005
----    EQU 03EE                 1987  MODE_NEWFILE                    = 1006
----                             1988  
----                             1989  ; Process exit codes returned from the Amiga entry path.
----    EQU 0000                 1990  RETURN_OK                       = 0
----    EQU 0014                 1991  RETURN_USAGE                    = 20
----    EQU 0015                 1992  RETURN_FILE_FAILURE             = 21
----    EQU 0016                 1993  RETURN_INPUT_TOO_LARGE          = 22
----    EQU 0017                 1994  RETURN_VM_FAILURE               = 23
----    EQU 0018                 1995  RETURN_OUTPUT_FAILURE           = 24
----    EQU 0019                 1996  RETURN_WORKBENCH_UNSUPPORTED    = 25
----                             1997  
----                             1998  ; Negative harness statuses are report-visible host failures that occur before
----                             1999  ; or around VM execution.
----    EQU FFFFFF9C             2000  HARNESS_STATUS_USAGE            = -100
----    EQU FFFFFF9B             2001  HARNESS_STATUS_QUOTED_PATH      = -101
----    EQU FFFFFF9A             2002  HARNESS_STATUS_INPUT_OPEN       = -102
----    EQU FFFFFF99             2003  HARNESS_STATUS_INPUT_READ       = -103
----    EQU FFFFFF98             2004  HARNESS_STATUS_INPUT_TOO_LARGE  = -104
----    EQU FFFFFF97             2005  HARNESS_STATUS_OUTPUT_OPEN      = -105
----                             2006  
----    EQU 0100                 2007  PATH_BUFFER_CAPACITY            = 256
----                             2008  
----                             2009  ; globals is a tiny process-local host state block shared across the harness.
----                             2010  ; Offsets are intentionally fixed because A4 stays pinned to this base while the
----                             2011  ; report writer and DOS wrappers call each other.
----    EQU 0000                 2012  GLOBALS_DOS_BASE                = 0
----    EQU 0004                 2013  GLOBALS_STDOUT_HANDLE           = 4
----    EQU 0008                 2014  GLOBALS_LAST_IOERR              = 8
----    EQU 000C                 2015  GLOBALS_OUTPUT_HANDLE           = 12
----    EQU 0010                 2016  GLOBALS_SIZE                    = 16
----                             2017  
----                             2018          .section code, kind=code  ; [section code]
----                             2019    ; [section code]
----                             2020  ; ---------------------------------------------------------------------------  ; [section code]
----                             2021  ; Host-facing harness.  ; [section code]
----                             2022  ;  ; [section code]
----                             2023  ; This is the native equivalent of the Rust tokenizer bridge setup:  ; [section code]
----                             2024  ; 1. initialize DOS access  ; [section code]
----                             2025  ; 2. obtain and parse CLI arguments  ; [section code]
----                             2026  ; 3. read exactly one single-line source buffer plus a one-byte overflow probe  ; [section code]
----                             2027  ; 4. invoke tokvm_run_68000 with caller-owned buffers and demoProgram  ; [section code]
----                             2028  ; 5. render the OPFORGE-TOKVM 1 report from the native token buffer  ; [section code]
----                             2029  ; ---------------------------------------------------------------------------  ; [section code]
----                             2030    ; [section code]
----                             2031  tokvm_amigaos_cli_harness_run  ; [section code]
0F00    48 E7 3F 3E              2032          MOVEM.L D2-D7/A2-A6, -(SP)  ; [section code]
0F04    49 F9 00 00 00 00        2033          LEA globals, A4  ; shared host state block: DOS base, stdout, output handle, last IoErr  ; [section code]
0F0A    7E 00                    2034          MOVEQ #RETURN_OK, D7  ; optimistic Shell return until a host or VM failure overrides it  ; [section code]
----                             2035    ; [section code]
0F0C    61 00 06 0A              2036          BSR.W amigaos_cli_fileio_init  ; mirrors Rust-side host bootstrap: open DOS and discover stdout  ; [section code]
0F10    4A 80                    2037          TST.L D0  ; [section code]
0F12    66 00 01 92              2038          BNE.W tokvmHarnessCleanup  ; [section code]
----                             2039    ; [section code]
0F16    61 00 06 62              2040          BSR.W amigaos_cli_fileio_get_arg_str  ; DOS GetArgStr provides the raw Shell argument tail  ; [section code]
0F1A    61 00 01 AA              2041          BSR.W tokvm_amigaos_cli_harness_parse_args  ; native spec is intentionally fixed: <input-path> <output-path>  ; [section code]
0F1E    4A 80                    2042          TST.L D0  ; [section code]
0F20    67 00 00 2C              2043          BEQ.W tokvmHarnessArgsParsed  ; [section code]
0F24    7E 14                    2044          MOVEQ #RETURN_USAGE, D7  ; [section code]
0F26    22 2C 00 04              2045          MOVE.L GLOBALS_STDOUT_HANDLE(A4), D1  ; [section code]
0F2A    0C 80 FF FF FF 9B        2046          CMPI.L #HARNESS_STATUS_QUOTED_PATH, D0  ; [section code]
0F30    66 0E                    2047          BNE.S tokvmHarnessUsage  ; [section code]
0F32    41 F9 00 00 00 D8        2048          LEA quotedPathMessage, A0  ; [section code]
0F38    61 00 06 BA              2049          BSR.W amigaos_cli_fileio_write_cstr  ; [section code]
0F3C    60 00 01 68              2050          BRA.W tokvmHarnessCleanup  ; [section code]
