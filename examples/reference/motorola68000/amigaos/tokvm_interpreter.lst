0F62    41 F9 00 00 00 FF        2064          LEA outputOpenMessage, A0  ; [section code]
0F68    61 00 06 8A              2065          BSR.W amigaos_cli_fileio_write_cstr  ; [section code]
0F6C    60 00 01 38              2066          BRA.W tokvmHarnessCleanup  ; [section code]
----                             2067    ; [section code]
----                             2068  tokvmHarnessOutputOpened  ; [section code]
0F70    29 40 00 0C              2069          MOVE.L D0, GLOBALS_OUTPUT_HANDLE(A4)  ; [section code]
0F74    2C 00                    2070          MOVE.L D0, D6  ; keep the output handle live for report writes and final cleanup  ; [section code]
0F76    41 F9 00 00 00 10        2071          LEA inputPathBuffer, A0  ; [section code]
0F7C    61 00 06 10              2072          BSR.W amigaos_cli_fileio_open_input  ; [section code]
0F80    4A 80                    2073          TST.L D0  ; [section code]
0F82    66 18                    2074          BNE.S tokvmHarnessInputOpened  ; [section code]
0F84    7E 15                    2075          MOVEQ #RETURN_FILE_FAILURE, D7  ; [section code]
0F86    20 3C FF FF FF 9A        2076          MOVE.L #HARNESS_STATUS_INPUT_OPEN, D0  ; [section code]
0F8C    61 00 01 F6              2077          BSR.W tokvm_amigaos_cli_harness_write_failure_report  ; [section code]
0F90    4A 80                    2078          TST.L D0  ; [section code]
0F92    67 00 01 12              2079          BEQ.W tokvmHarnessCleanup  ; [section code]
0F96    7E 18                    2080          MOVEQ #RETURN_OUTPUT_FAILURE, D7  ; [section code]
0F98    60 00 01 0C              2081          BRA.W tokvmHarnessCleanup  ; [section code]
----                             2082    ; [section code]
----                             2083  tokvmHarnessInputOpened  ; [section code]
0F9C    2A 00                    2084          MOVE.L D0, D5  ; input handle lives only until the bounded single-line read completes  ; [section code]
0F9E    41 F9 00 00 02 10        2085          LEA sourceBuffer, A0  ; [section code]
0FA4    20 3C 00 00 04 00        2086          MOVE.L #SOURCE_BUFFER_CAPACITY, D0  ; tokvm native ABI takes a caller-owned contiguous source slice  ; [section code]
0FAA    22 05                    2087          MOVE.L D5, D1  ; [section code]
0FAC    61 00 06 24              2088          BSR.W amigaos_cli_fileio_read  ; [section code]
0FB0    B0 BC FF FF FF FF        2089          CMP.L #-1, D0  ; [section code]
0FB6    66 1E                    2090          BNE.S tokvmHarnessReadOk  ; [section code]
0FB8    22 05                    2091          MOVE.L D5, D1  ; [section code]
0FBA    61 00 06 8E              2092          BSR.W amigaos_cli_fileio_close  ; [section code]
0FBE    7E 15                    2093          MOVEQ #RETURN_FILE_FAILURE, D7  ; [section code]
0FC0    20 3C FF FF FF 99        2094          MOVE.L #HARNESS_STATUS_INPUT_READ, D0  ; [section code]
0FC6    61 00 01 BC              2095          BSR.W tokvm_amigaos_cli_harness_write_failure_report  ; [section code]
0FCA    4A 80                    2096          TST.L D0  ; [section code]
0FCC    67 00 00 D8              2097          BEQ.W tokvmHarnessCleanup  ; [section code]
0FD0    7E 18                    2098          MOVEQ #RETURN_OUTPUT_FAILURE, D7  ; [section code]
0FD2    60 00 00 D2              2099          BRA.W tokvmHarnessCleanup  ; [section code]
----                             2100    ; [section code]
----                             2101  tokvmHarnessReadOk  ; [section code]
0FD6    28 00                    2102          MOVE.L D0, D4  ; D4 becomes source byte length, matching tokvm_run_68000 input ABI  ; [section code]
0FD8    41 F9 00 00 0F 22        2103          LEA inputProbeByte, A0  ; [section code]
0FDE    70 01                    2104          MOVEQ #1, D0  ; one-byte overflow probe enforces the spec's bounded single-line input rule  ; [section code]
0FE0    22 05                    2105          MOVE.L D5, D1  ; [section code]
0FE2    61 00 05 EE              2106          BSR.W amigaos_cli_fileio_read  ; [section code]
0FE6    26 00                    2107          MOVE.L D0, D3  ; [section code]
0FE8    B0 BC FF FF FF FF        2108          CMP.L #-1, D0  ; [section code]
0FEE    66 1E                    2109          BNE.S tokvmHarnessProbeOk  ; [section code]
0FF0    22 05                    2110          MOVE.L D5, D1  ; [section code]
0FF2    61 00 06 56              2111          BSR.W amigaos_cli_fileio_close  ; [section code]
0FF6    7E 15                    2112          MOVEQ #RETURN_FILE_FAILURE, D7  ; [section code]
0FF8    20 3C FF FF FF 99        2113          MOVE.L #HARNESS_STATUS_INPUT_READ, D0  ; [section code]
0FFE    61 00 01 84              2114          BSR.W tokvm_amigaos_cli_harness_write_failure_report  ; [section code]
1002    4A 80                    2115          TST.L D0  ; [section code]
1004    67 00 00 A0              2116          BEQ.W tokvmHarnessCleanup  ; [section code]
1008    7E 18                    2117          MOVEQ #RETURN_OUTPUT_FAILURE, D7  ; [section code]
100A    60 00 00 9A              2118          BRA.W tokvmHarnessCleanup  ; [section code]
----                             2119    ; [section code]
----                             2120  tokvmHarnessProbeOk  ; [section code]
100E    22 05                    2121          MOVE.L D5, D1  ; [section code]
1010    61 00 06 38              2122          BSR.W amigaos_cli_fileio_close  ; [section code]
1014    4A 80                    2123          TST.L D0  ; [section code]
1016    67 18                    2124          BEQ.S tokvmHarnessProbeClosed  ; [section code]
1018    7E 15                    2125          MOVEQ #RETURN_FILE_FAILURE, D7  ; [section code]
101A    20 3C FF FF FF 99        2126          MOVE.L #HARNESS_STATUS_INPUT_READ, D0  ; [section code]
1020    61 00 01 62              2127          BSR.W tokvm_amigaos_cli_harness_write_failure_report  ; [section code]
1024    4A 80                    2128          TST.L D0  ; [section code]
1026    67 00 00 7E              2129          BEQ.W tokvmHarnessCleanup  ; [section code]
102A    7E 18                    2130          MOVEQ #RETURN_OUTPUT_FAILURE, D7  ; [section code]
102C    60 00 00 78              2131          BRA.W tokvmHarnessCleanup  ; [section code]
----                             2132    ; [section code]
----                             2133  tokvmHarnessProbeClosed  ; [section code]
1030    4A 83                    2134          TST.L D3  ; any extra byte means the caller exceeded SOURCE_BUFFER_CAPACITY  ; [section code]
1032    67 18                    2135          BEQ.S tokvmHarnessInvokeVm  ; [section code]
1034    7E 16                    2136          MOVEQ #RETURN_INPUT_TOO_LARGE, D7  ; [section code]
1036    20 3C FF FF FF 98        2137          MOVE.L #HARNESS_STATUS_INPUT_TOO_LARGE, D0  ; [section code]
103C    61 00 01 46              2138          BSR.W tokvm_amigaos_cli_harness_write_failure_report  ; [section code]
1040    4A 80                    2139          TST.L D0  ; [section code]
1042    67 00 00 62              2140          BEQ.W tokvmHarnessCleanup  ; [section code]
