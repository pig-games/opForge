04CE    4C DF 70 F0               654          MOVEM.L (SP)+, D4-D7/A4-A6  ; [section code]
04D2    4E 75                     655          RTS  ; [section code]
----                              656    ; [section code]
----                              657  ; ---------------------------------------------------------------------------  ; [section code]
----                              658  ; Native token record staging and commit.  ; [section code]
----                              659  ;  ; [section code]
----                              660  ; Each committed record is 20 bytes in tokenBuffer:  ; [section code]
----                              661  ; - word 0: token kind code  ; [section code]
----                              662  ; - long 4: 1-based start column  ; [section code]
----                              663  ; - long 8: 1-based end column  ; [section code]
----                              664  ; - long 12: lexemeScratch offset  ; [section code]
----                              665  ; - long 16: lexeme length in bytes  ; [section code]
----                              666  ;  ; [section code]
----                              667  ; This is the compact native surface that the asm tests decode back into the  ; [section code]
----                              668  ; OPFORGE-TOKVM 1 report format.  ; [section code]
----                              669  ; ---------------------------------------------------------------------------  ; [section code]
----                              670    ; [section code]
----                              671  tokvmCommitPendingToken  ; [section code]
04D4    B2 85                     672          CMP.L D5, D1  ; token_count < token_capacity  ; [section code]
04D6    64 00 00 56               673          BCC tokvmPendingTokenOverflow  ; [section code]
04DA    20 03                     674          MOVE.L D3, D0  ; scratch_used + pending_len must stay within scratch_capacity  ; [section code]
04DC    D0 AA 00 10               675          ADD.L LOCAL_PENDING_LEX_LEN(A2), D0  ; [section code]
04E0    B0 86                     676          CMP.L D6, D0  ; [section code]
04E2    62 00 00 52               677          BHI tokvmPendingLexemeOverflow  ; [section code]
04E6    20 01                     678          MOVE.L D1, D0  ; compute record_index * TOKEN_RECORD_SIZE without a MUL dependency  ; [section code]
04E8    D0 80                     679          ADD.L D0, D0  ; *2  ; [section code]
04EA    20 40                     680          MOVEA.L D0, A0  ; [section code]
04EC    D0 80                     681          ADD.L D0, D0  ; *4  ; [section code]
04EE    D0 80                     682          ADD.L D0, D0  ; *8  ; [section code]
04F0    D0 80                     683          ADD.L D0, D0  ; *16  ; [section code]
04F2    D1 C0                     684          ADDA.L D0, A0  ; *18  ; [section code]
04F4    20 01                     685          MOVE.L D1, D0  ; [section code]
04F6    D0 80                     686          ADD.L D0, D0  ; +2 => *20 byte stride  ; [section code]
04F8    D1 C0                     687          ADDA.L D0, A0  ; [section code]
04FA    22 4D                     688          MOVEA.L A5, A1  ; [section code]
04FC    D3 C8                     689          ADDA.L A0, A1  ; [section code]
04FE    32 AA 00 04               690          MOVE.W LOCAL_PENDING_KIND(A2), (A1)  ; field 0: token kind code  ; [section code]
0502    42 69 00 02               691          CLR.W 2(A1)  ; [section code]
0506    20 2A 00 08               692          MOVE.L LOCAL_PENDING_START(A2), D0  ; field 4: 1-based start column  ; [section code]
050A    52 80                     693          ADDQ.L #1, D0  ; [section code]
050C    23 40 00 04               694          MOVE.L D0, 4(A1)  ; [section code]
0510    20 2A 00 0C               695          MOVE.L LOCAL_PENDING_END(A2), D0  ; field 8: 1-based end column  ; [section code]
0514    52 80                     696          ADDQ.L #1, D0  ; [section code]
0516    23 40 00 08               697          MOVE.L D0, 8(A1)  ; [section code]
051A    23 43 00 0C               698          MOVE.L D3, 12(A1)  ; field 12: lexeme offset into scratch  ; [section code]
051E    23 6A 00 10 00 10         699          MOVE.L LOCAL_PENDING_LEX_LEN(A2), 16(A1)  ; field 16: lexeme length in bytes  ; [section code]
0524    52 81                     700          ADDQ.L #1, D1  ; [section code]
0526    D6 AA 00 10               701          ADD.L LOCAL_PENDING_LEX_LEN(A2), D3  ; [section code]
052A    70 00                     702          MOVEQ #TK_STATUS_SUCCESS, D0  ; [section code]
052C    4E 75                     703          RTS  ; [section code]
----                              704    ; [section code]
----                              705  ; Overflow exits report the start column of the token that could not be fully  ; [section code]
----                              706  ; materialized. This matches the Rust-side behavior of attributing capacity  ; [section code]
----                              707  ; failures to the token currently being scanned rather than the following byte.  ; [section code]
----                              708  tokvmPendingTokenOverflow  ; [section code]
052E    24 2A 00 08               709          MOVE.L LOCAL_PENDING_START(A2), D2  ; [section code]
0532    70 02                     710          MOVEQ #TK_STATUS_TOKEN_OVERFLOW, D0  ; [section code]
0534    4E 75                     711          RTS  ; [section code]
----                              712    ; [section code]
----                              713  tokvmPendingLexemeOverflow  ; [section code]
0536    24 2A 00 08               714          MOVE.L LOCAL_PENDING_START(A2), D2  ; [section code]
053A    70 03                     715          MOVEQ #TK_STATUS_LEXEME_OVERFLOW, D0  ; [section code]
053C    4E 75                     716          RTS  ; [section code]
----                              717    ; [section code]
----                              718  ; Stage a fixed lexeme literal from the static data table into scratch.  ; [section code]
----                              719  ; This is used for punctuation and operator tokens whose lexeme spelling is  ; [section code]
----                              720  ; known upfront and does not need to be copied from the source buffer.  ; [section code]
----                              721  tokvmStageFixedLexeme  ; [section code]
053E    25 40 00 10               722          MOVE.L D0, LOCAL_PENDING_LEX_LEN(A2)  ; fixed operator/punctuation lexeme length from the inline template string  ; [section code]
0542    20 03                     723          MOVE.L D3, D0  ; [section code]
0544    D0 AA 00 10               724          ADD.L LOCAL_PENDING_LEX_LEN(A2), D0  ; [section code]
0548    B0 86                     725          CMP.L D6, D0  ; [section code]
054A    62 00 FF EA               726          BHI tokvmPendingLexemeOverflow  ; [section code]
054E    22 4E                     727          MOVEA.L A6, A1  ; [section code]
0550    D3 C3                     728          ADDA.L D3, A1  ; [section code]
0552    20 2A 00 10               729          MOVE.L LOCAL_PENDING_LEX_LEN(A2), D0  ; [section code]
----                              730  tokvmStageFixedLexemeLoop  ; [section code]
0556    4A 80                     731          TST.L D0  ; [section code]
0558    67 00 00 0A               732          BEQ tokvmStageFixedLexemeDone  ; [section code]
055C    12 D8                     733          MOVE.B (A0)+, (A1)+  ; copy the canonical lexeme bytes that Rust would expose in PortableToken text/raw  ; [section code]
055E    53 80                     734          SUBQ.L #1, D0  ; [section code]
0560    60 00 FF F4               735          BRA tokvmStageFixedLexemeLoop  ; [section code]
----                              736    ; [section code]
----                              737  tokvmStageFixedLexemeDone  ; [section code]
0564    70 00                     738          MOVEQ #TK_STATUS_SUCCESS, D0  ; [section code]
0566    4E 75                     739          RTS  ; [section code]
----                              740    ; [section code]
----                              741  ; ---------------------------------------------------------------------------  ; [section code]
----                              742  ; Scanner helpers.  ; [section code]
----                              743  ;  ; [section code]
----                              744  ; These are the native counterparts of the Rust tokenizer helper routines in  ; [section code]
----                              745  ; tokenizer_runtime_utils.rs. Each helper advances D2 as the live source cursor,  ; [section code]
----                              746  ; populates LOCAL_PENDING_* metadata, stages lexeme bytes into the scratch  ; [section code]
----                              747  ; buffer, then commits a token record.  ; [section code]
----                              748  ; ---------------------------------------------------------------------------  ; [section code]
----                              749    ; [section code]
----                              750  tokvmScanIdentifierToken  ; [section code]
----                              751          ; Identifier scan is the native mirror of vm_scan_identifier_token():  ; [section code]
----                              752          ; walk identifier-continue bytes, lowercase ASCII letters for the demo  ; [section code]
----                              753          ; policy, then emit one identifier record backed by scratch bytes.  ; [section code]
0568    25 42 00 08               754          MOVE.L D2, LOCAL_PENDING_START(A2)  ; [section code]
056C    42 AA 00 10               755          CLR.L LOCAL_PENDING_LEX_LEN(A2)  ; [section code]
0570    20 4E                     756          MOVEA.L A6, A0  ; [section code]
0572    D1 C3                     757          ADDA.L D3, A0  ; [section code]
----                              758    ; [section code]
----                              759  tokvmScanIdentifierLoop  ; [section code]
----                              760          ; D2 stays as the source cursor, A0 walks the next free scratch byte,  ; [section code]
----                              761          ; and LOCAL_PENDING_LEX_LEN grows in lockstep so commit can later write  ; [section code]
----                              762          ; both the source span and scratch payload length into the token record.  ; [section code]
0574    B4 84                     763          CMP.L D4, D2  ; [section code]
0576    64 00 00 46               764          BCC tokvmScanIdentifierDone  ; [section code]
057A    70 00                     765          MOVEQ #0, D0  ; [section code]
057C    10 34 28 00               766          MOVE.B 0(A4, D2.L), D0  ; [section code]
0580    4E B9 00 00 0C 38         767          JSR tokvmIsIdentifierContinue  ; mirrors vm_matches_identifier_continue_class()  ; [section code]
0586    4A 80                     768          TST.L D0  ; [section code]
0588    67 00 00 34               769          BEQ tokvmScanIdentifierDone  ; [section code]
058C    20 03                     770          MOVE.L D3, D0  ; [section code]
058E    D0 AA 00 10               771          ADD.L LOCAL_PENDING_LEX_LEN(A2), D0  ; [section code]
0592    B0 86                     772          CMP.L D6, D0  ; [section code]
0594    64 00 06 52               773          BCC tokvmPendingLexemeOverflowFromScan  ; [section code]
0598    70 00                     774          MOVEQ #0, D0  ; [section code]
059A    10 34 28 00               775          MOVE.B 0(A4, D2.L), D0  ; [section code]
059E    0C 00 00 41               776          CMPI.B #'A', D0  ; [section code]
05A2    65 00 00 0E               777          BLO tokvmCopyIdentifierByte  ; [section code]
05A6    0C 00 00 5A               778          CMPI.B #'Z', D0  ; [section code]
05AA    62 00 00 06               779          BHI tokvmCopyIdentifierByte  ; [section code]
05AE    00 00 00 20               780          ORI.B #$20, D0  ; native demo bakes in ASCII-lower identifier normalization used by the Rust bridge tests  ; [section code]
----                              781  tokvmCopyIdentifierByte  ; [section code]
05B2    10 C0                     782          MOVE.B D0, (A0)+  ; [section code]
05B4    52 82                     783          ADDQ.L #1, D2  ; [section code]
05B6    52 AA 00 10               784          ADDQ.L #1, LOCAL_PENDING_LEX_LEN(A2)  ; [section code]
05BA    60 00 FF B8               785          BRA tokvmScanIdentifierLoop  ; [section code]
