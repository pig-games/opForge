----                             1823  ; AmigaOS Exec/DOS offsets used by the CLI harness layer.
----                             1824  ; ---------------------------------------------------------------------------
----                             1825  
----    EQU 0004                 1826  SysBase                         = 4
----                             1827  
----    EQU 00AC                 1828  pr_CLI                          = 172
----    EQU 005C                 1829  pr_MsgPort                      = 92
----                             1830  
----    EQU FFFFFDD8             1831  OpenLibrary                     = -552
----    EQU FFFFFE62             1832  CloseLibrary                    = -414
----    EQU FFFFFEDA             1833  FindTask                        = -294
----    EQU FFFFFE80             1834  WaitPort                        = -384
----    EQU FFFFFE8C             1835  GetMsg                          = -372
----    EQU FFFFFE86             1836  ReplyMsg                        = -378
----    EQU FFFFFF7C             1837  Forbid                          = -132
----                             1838  
----    EQU FFFFFFE2             1839  Open                            = -30
----    EQU FFFFFFDC             1840  Close                           = -36
----    EQU FFFFFFD6             1841  Read                            = -42
----    EQU FFFFFFD0             1842  Write                           = -48
----    EQU FFFFFFC4             1843  Output                          = -60
----    EQU FFFFFF7C             1844  IoErr                           = -132
----    EQU FFFFFDEA             1845  GetArgStr                       = -534
----                             1846  
----    EQU 03ED                 1847  MODE_OLDFILE                    = 1005
----    EQU 03EE                 1848  MODE_NEWFILE                    = 1006
----                             1849  
----                             1850  ; Process exit codes returned from the Amiga entry path.
----    EQU 0000                 1851  RETURN_OK                       = 0
----    EQU 0014                 1852  RETURN_USAGE                    = 20
----    EQU 0015                 1853  RETURN_FILE_FAILURE             = 21
----    EQU 0016                 1854  RETURN_INPUT_TOO_LARGE          = 22
----    EQU 0017                 1855  RETURN_VM_FAILURE               = 23
----    EQU 0018                 1856  RETURN_OUTPUT_FAILURE           = 24
----    EQU 0019                 1857  RETURN_WORKBENCH_UNSUPPORTED    = 25
----                             1858  
----                             1859  ; Negative harness statuses are report-visible host failures that occur before
----                             1860  ; or around VM execution.
----    EQU FFFFFF9C             1861  HARNESS_STATUS_USAGE            = -100
----    EQU FFFFFF9B             1862  HARNESS_STATUS_QUOTED_PATH      = -101
----    EQU FFFFFF9A             1863  HARNESS_STATUS_INPUT_OPEN       = -102
----    EQU FFFFFF99             1864  HARNESS_STATUS_INPUT_READ       = -103
----    EQU FFFFFF98             1865  HARNESS_STATUS_INPUT_TOO_LARGE  = -104
----    EQU FFFFFF97             1866  HARNESS_STATUS_OUTPUT_OPEN      = -105
----                             1867  
----    EQU 0100                 1868  PATH_BUFFER_CAPACITY            = 256
----                             1869  
----                             1870  ; globals is a tiny process-local host state block shared across the harness.
----                             1871  ; Offsets are intentionally fixed because A4 stays pinned to this base while the
----                             1872  ; report writer and DOS wrappers call each other.
----    EQU 0000                 1873  GLOBALS_DOS_BASE                = 0
----    EQU 0004                 1874  GLOBALS_STDOUT_HANDLE           = 4
----    EQU 0008                 1875  GLOBALS_LAST_IOERR              = 8
----    EQU 000C                 1876  GLOBALS_OUTPUT_HANDLE           = 12
----    EQU 0010                 1877  GLOBALS_SIZE                    = 16
----                             1878  
----                             1879          .section code, kind=code  ; [section code]
----                             1880    ; [section code]
----                             1881  ; ---------------------------------------------------------------------------  ; [section code]
----                             1882  ; Host-facing harness.  ; [section code]
----                             1883  ;  ; [section code]
----                             1884  ; This is the native equivalent of the Rust tokenizer bridge setup:  ; [section code]
----                             1885  ; 1. initialize DOS access  ; [section code]
----                             1886  ; 2. obtain and parse CLI arguments  ; [section code]
----                             1887  ; 3. read exactly one single-line source buffer plus a one-byte overflow probe  ; [section code]
----                             1888  ; 4. invoke tokvm_run_68000 with caller-owned buffers and demoProgram  ; [section code]
