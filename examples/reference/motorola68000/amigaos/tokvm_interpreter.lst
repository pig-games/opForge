063A    64 00 00 E0               846          BCC tokvmScanStringFailure  ; [section code]
063E    70 00                     847          MOVEQ #0, D0  ; [section code]
0640    10 34 28 00               848          MOVE.B 0(A4, D2.L), D0  ; [section code]
0644    B0 2A 00 00               849          CMP.B LOCAL_CURRENT_BYTE(A2), D0  ; [section code]
0648    67 00 00 BE               850          BEQ tokvmScanStringClose  ; [section code]
064C    0C 00 00 5C               851          CMPI.B #'\\', D0  ; decode the same escape surface exercised by vm_scan_string_token()  ; [section code]
0650    66 00 00 9E               852          BNE tokvmScanStringCopyLiteral  ; [section code]
0654    52 82                     853          ADDQ.L #1, D2  ; [section code]
0656    B4 84                     854          CMP.L D4, D2  ; [section code]
0658    64 00 FE 60               855          BCC tokvmVmFailureAtCursor  ; [section code]
065C    70 00                     856          MOVEQ #0, D0  ; [section code]
065E    10 34 28 00               857          MOVE.B 0(A4, D2.L), D0  ; [section code]
0662    0C 00 00 6E               858          CMPI.B #'n', D0  ; [section code]
0666    67 00 00 1E               859          BEQ tokvmStringEscapeNewline  ; [section code]
066A    0C 00 00 72               860          CMPI.B #'r', D0  ; [section code]
