061A    70 00                     829          MOVEQ #0, D0  ; [section code]
061C    10 34 28 00               830          MOVE.B 0(A4, D2.L), D0  ; [section code]
0620    0C 00 00 25               831          CMPI.B #'%', D0  ; [section code]
