0642    B0 86                     842          CMP.L D6, D0  ; [section code]
0644    64 00 06 32               843          BCC tokvmPendingLexemeOverflowFromScan  ; [section code]
0648    10 F4 28 00               844          MOVE.B 0(A4, D2.L), (A0)+  ; [section code]
064C    52 82                     845          ADDQ.L #1, D2  ; [section code]
064E    52 AA 00 10               846          ADDQ.L #1, LOCAL_PENDING_LEX_LEN(A2)  ; [section code]
0652    60 00 FF C0               847          BRA tokvmScanNumberLoop  ; [section code]
