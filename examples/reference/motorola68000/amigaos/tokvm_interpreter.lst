06B8    B4 84                     895          CMP.L D4, D2  ; [section code]
06BA    64 00 00 60               896          BCC tokvmScanStringFailure  ; [section code]
06BE    70 00                     897          MOVEQ #0, D0  ; [section code]
06C0    10 34 28 00               898          MOVE.B 0(A4, D2.L), D0  ; [section code]
