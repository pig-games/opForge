----                              855  tokvmScanStringToken  ; [section code]
----                              856          ; Strings keep their raw delimiter choice for closing rules, but only the  ; [section code]
----                              857          ; decoded payload bytes are staged into scratch and exposed in LEXHEX.  ; [section code]
