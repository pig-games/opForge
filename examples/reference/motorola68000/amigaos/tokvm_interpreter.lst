----                              806          ; interpret base markers just like the Rust runtime does.  ; [section code]
05DC    B4 84                     807          CMP.L D4, D2  ; [section code]
05DE    64 00 00 2E               808          BCC tokvmScanNumberDone  ; [section code]
05E2    70 00                     809          MOVEQ #0, D0  ; [section code]
05E4    10 34 28 00               810          MOVE.B 0(A4, D2.L), D0  ; [section code]
05E8    4E B9 00 00 0C A0         811          JSR tokvmIsNumberBody  ; same permissive number-body walk as vm_scan_number_token()  ; [section code]
05EE    4A 80                     812          TST.L D0  ; [section code]
05F0    67 00 00 1C               813          BEQ tokvmScanNumberDone  ; [section code]
05F4    20 03                     814          MOVE.L D3, D0  ; [section code]
05F6    D0 AA 00 10               815          ADD.L LOCAL_PENDING_LEX_LEN(A2), D0  ; [section code]
05FA    B0 86                     816          CMP.L D6, D0  ; [section code]
