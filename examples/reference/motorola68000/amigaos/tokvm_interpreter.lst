----                             2143    ; [section code]
----                             2144  tokvmHarnessInvokeVm  ; [section code]
----                             2145          ; Register ABI for tokvm_run_68000:  ; [section code]
----                             2146          ; A0/D0 source slice, A1/D1 token buffer+capacity, A2/D2 scratch buffer+capacity,  ; [section code]
----                             2147          ; A3/D3 demo bytecode pointer+length. This mirrors the native contract documented  ; [section code]
----                             2148          ; in tokvm_tokenizer_vm.asm and used by the Rust-side bridge tests.  ; [section code]
104C    20 3C 00 00 08 00        2149          MOVE.L #TOKVM_DEFAULT_MAX_STEPS_PER_LINE, D0  ; [section code]
1052    4E B9 00 00 00 00        2150          JSR tokvm_set_step_budget_68000  ; [section code]
1058    41 F9 00 00 02 10        2151          LEA sourceBuffer, A0  ; [section code]
105E    20 04                    2152          MOVE.L D4, D0  ; [section code]
1060    43 F9 00 00 06 10        2153          LEA tokenBuffer, A1  ; [section code]
1066    22 3C 00 00 00 40        2154          MOVE.L #TOKEN_BUFFER_CAPACITY, D1  ; [section code]
106C    45 F9 00 00 0B 10        2155          LEA lexemeScratch, A2  ; [section code]
1072    24 3C 00 00 04 00        2156          MOVE.L #SCRATCH_BUFFER_CAPACITY, D2  ; [section code]
1078    47 F9 00 00 00 2B        2157          LEA demoProgram, A3  ; [section code]
107E    26 39 00 00 00 9F        2158          MOVE.L demoProgramLen, D3  ; [section code]
1084    4E B9 00 00 00 46        2159          JSR tokvm_run_68000  ; [section code]
