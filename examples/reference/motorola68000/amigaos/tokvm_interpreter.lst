----                             1848  demoScanString  ; [section data]
0067    11                       1849          .byte TK_OPCODE_SCAN_STRING  ; [section data]
----                             1850          .block  ; [section data]
----                             1851          ; Macros keep the demo bytecode readable without obscuring the exact byte  ; [section data]
----                             1852          ; sequence that the Rust builder would emit.  ; [section data]
0068    07                       1853          .byte TK_OPCODE_JUMP  ; [section data]
----                             1854          .block  ; [section data]
----                             1855          ; Keep jump targets readable in source while still emitting the same  ; [section data]
----                             1856          ; little-endian u32 layout as builder.rs and the Rust VM loader expect.  ; [section data]
0069    00                       1857          .byte (DEMO_PC_READ_CHAR) & $ff  ; [section data]
006A    00                       1858          .byte ((DEMO_PC_READ_CHAR) >> 8) & $ff  ; [section data]
006B    00                       1859          .byte ((DEMO_PC_READ_CHAR) >> 16) & $ff  ; [section data]
006C    00                       1860          .byte ((DEMO_PC_READ_CHAR) >> 24) & $ff  ; [section data]
