108A    28 00                    2161          MOVE.L D0, D4  ; status  ; [section code]
108C    2A 01                    2162          MOVE.L D1, D5  ; emitted token count  ; [section code]
108E    2C 02                    2163          MOVE.L D2, D6  ; final source cursor / column end  ; [section code]
1090    4A 84                    2164          TST.L D4  ; [section code]
1092    67 02                    2165          BEQ.S tokvmHarnessWriteVmReport  ; [section code]
1094    7E 17                    2166          MOVEQ #RETURN_VM_FAILURE, D7  ; [section code]
