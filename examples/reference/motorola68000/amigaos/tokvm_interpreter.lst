----                              653  ; opcode/operand combinations that the native interpreter refuses to execute.  ; [section code]
----                              654  tokvmInvalidProgramAtCursor  ; [section code]
04D8    70 06                     655          MOVEQ #TK_STATUS_INVALID_PROGRAM, D0  ; [section code]
----                              656    ; [section code]
----                              657  tokvmReturn  ; [section code]
04DA    DF FC 00 00 00 24         658          ADDA.L #LOCAL_SIZE, SP  ; [section code]
04E0    4C DF 70 F0               659          MOVEM.L (SP)+, D4-D7/A4-A6  ; [section code]
04E4    4E 75                     660          RTS  ; [section code]
----                              661    ; [section code]
----                              662  ; ---------------------------------------------------------------------------  ; [section code]
----                              663  ; Native token record staging and commit.  ; [section code]
----                              664  ;  ; [section code]
----                              665  ; Each committed record is 20 bytes in tokenBuffer:  ; [section code]
----                              666  ; - word 0: token kind code  ; [section code]
----                              667  ; - long 4: 1-based start column  ; [section code]
----                              668  ; - long 8: 1-based end column  ; [section code]
----                              669  ; - long 12: lexemeScratch offset  ; [section code]
----                              670  ; - long 16: lexeme length in bytes  ; [section code]
----                              671  ;  ; [section code]
----                              672  ; This is the compact native surface that the asm tests decode back into the  ; [section code]
----                              673  ; OPFORGE-TOKVM 1 report format.  ; [section code]
----                              674  ; ---------------------------------------------------------------------------  ; [section code]
----                              675    ; [section code]
----                              676  tokvmCommitPendingToken  ; [section code]
04E6    B2 85                     677          CMP.L D5, D1  ; token_count < token_capacity  ; [section code]
04E8    64 00 00 56               678          BCC tokvmPendingTokenOverflow  ; [section code]
04EC    20 03                     679          MOVE.L D3, D0  ; scratch_used + pending_len must stay within scratch_capacity  ; [section code]
04EE    D0 AA 00 10               680          ADD.L LOCAL_PENDING_LEX_LEN(A2), D0  ; [section code]
04F2    B0 86                     681          CMP.L D6, D0  ; [section code]
04F4    62 00 00 52               682          BHI tokvmPendingLexemeOverflow  ; [section code]
04F8    20 01                     683          MOVE.L D1, D0  ; compute record_index * TOKEN_RECORD_SIZE without a MUL dependency  ; [section code]
04FA    D0 80                     684          ADD.L D0, D0  ; *2  ; [section code]
04FC    20 40                     685          MOVEA.L D0, A0  ; [section code]
04FE    D0 80                     686          ADD.L D0, D0  ; *4  ; [section code]
0500    D0 80                     687          ADD.L D0, D0  ; *8  ; [section code]
0502    D0 80                     688          ADD.L D0, D0  ; *16  ; [section code]
0504    D1 C0                     689          ADDA.L D0, A0  ; *18  ; [section code]
0506    20 01                     690          MOVE.L D1, D0  ; [section code]
0508    D0 80                     691          ADD.L D0, D0  ; +2 => *20 byte stride  ; [section code]
050A    D1 C0                     692          ADDA.L D0, A0  ; [section code]
050C    22 4D                     693          MOVEA.L A5, A1  ; [section code]
050E    D3 C8                     694          ADDA.L A0, A1  ; [section code]
0510    32 AA 00 04               695          MOVE.W LOCAL_PENDING_KIND(A2), (A1)  ; field 0: token kind code  ; [section code]
0514    42 69 00 02               696          CLR.W 2(A1)  ; [section code]
0518    20 2A 00 08               697          MOVE.L LOCAL_PENDING_START(A2), D0  ; field 4: 1-based start column  ; [section code]
051C    52 80                     698          ADDQ.L #1, D0  ; [section code]
051E    23 40 00 04               699          MOVE.L D0, 4(A1)  ; [section code]
0522    20 2A 00 0C               700          MOVE.L LOCAL_PENDING_END(A2), D0  ; field 8: 1-based end column  ; [section code]
0526    52 80                     701          ADDQ.L #1, D0  ; [section code]
0528    23 40 00 08               702          MOVE.L D0, 8(A1)  ; [section code]
052C    23 43 00 0C               703          MOVE.L D3, 12(A1)  ; field 12: lexeme offset into scratch  ; [section code]
0530    23 6A 00 10 00 10         704          MOVE.L LOCAL_PENDING_LEX_LEN(A2), 16(A1)  ; field 16: lexeme length in bytes  ; [section code]
0536    52 81                     705          ADDQ.L #1, D1  ; [section code]
0538    D6 AA 00 10               706          ADD.L LOCAL_PENDING_LEX_LEN(A2), D3  ; [section code]
053C    70 00                     707          MOVEQ #TK_STATUS_SUCCESS, D0  ; [section code]
053E    4E 75                     708          RTS  ; [section code]
----                              709    ; [section code]
----                              710  ; Overflow exits report the start column of the token that could not be fully  ; [section code]
----                              711  ; materialized. This matches the Rust-side behavior of attributing capacity  ; [section code]
----                              712  ; failures to the token currently being scanned rather than the following byte.  ; [section code]
----                              713  tokvmPendingTokenOverflow  ; [section code]
0540    24 2A 00 08               714          MOVE.L LOCAL_PENDING_START(A2), D2  ; [section code]
0544    70 02                     715          MOVEQ #TK_STATUS_TOKEN_OVERFLOW, D0  ; [section code]
0546    4E 75                     716          RTS  ; [section code]
----                              717    ; [section code]
----                              718  tokvmPendingLexemeOverflow  ; [section code]
0548    24 2A 00 08               719          MOVE.L LOCAL_PENDING_START(A2), D2  ; [section code]
054C    70 03                     720          MOVEQ #TK_STATUS_LEXEME_OVERFLOW, D0  ; [section code]
054E    4E 75                     721          RTS  ; [section code]
----                              722    ; [section code]
----                              723  ; Stage a fixed lexeme literal from the static data table into scratch.  ; [section code]
----                              724  ; This is used for punctuation and operator tokens whose lexeme spelling is  ; [section code]
----                              725  ; known upfront and does not need to be copied from the source buffer.  ; [section code]
----                              726  tokvmStageFixedLexeme  ; [section code]
0550    25 40 00 10               727          MOVE.L D0, LOCAL_PENDING_LEX_LEN(A2)  ; fixed operator/punctuation lexeme length from the inline template string  ; [section code]
0554    20 03                     728          MOVE.L D3, D0  ; [section code]
0556    D0 AA 00 10               729          ADD.L LOCAL_PENDING_LEX_LEN(A2), D0  ; [section code]
055A    B0 86                     730          CMP.L D6, D0  ; [section code]
055C    62 00 FF EA               731          BHI tokvmPendingLexemeOverflow  ; [section code]
0560    22 4E                     732          MOVEA.L A6, A1  ; [section code]
0562    D3 C3                     733          ADDA.L D3, A1  ; [section code]
0564    20 2A 00 10               734          MOVE.L LOCAL_PENDING_LEX_LEN(A2), D0  ; [section code]
----                              735  tokvmStageFixedLexemeLoop  ; [section code]
0568    4A 80                     736          TST.L D0  ; [section code]
056A    67 00 00 0A               737          BEQ tokvmStageFixedLexemeDone  ; [section code]
056E    12 D8                     738          MOVE.B (A0)+, (A1)+  ; copy the canonical lexeme bytes that Rust would expose in PortableToken text/raw  ; [section code]
0570    53 80                     739          SUBQ.L #1, D0  ; [section code]
0572    60 00 FF F4               740          BRA tokvmStageFixedLexemeLoop  ; [section code]
----                              741    ; [section code]
----                              742  tokvmStageFixedLexemeDone  ; [section code]
0576    70 00                     743          MOVEQ #TK_STATUS_SUCCESS, D0  ; [section code]
0578    4E 75                     744          RTS  ; [section code]
----                              745    ; [section code]
----                              746  ; ---------------------------------------------------------------------------  ; [section code]
----                              747  ; Scanner helpers.  ; [section code]
----                              748  ;  ; [section code]
----                              749  ; These are the native counterparts of the Rust tokenizer helper routines in  ; [section code]
----                              750  ; tokenizer_runtime_utils.rs. Each helper advances D2 as the live source cursor,  ; [section code]
----                              751  ; populates LOCAL_PENDING_* metadata, stages lexeme bytes into the scratch  ; [section code]
----                              752  ; buffer, then commits a token record.  ; [section code]
----                              753  ; ---------------------------------------------------------------------------  ; [section code]
----                              754    ; [section code]
----                              755  tokvmScanIdentifierToken  ; [section code]
----                              756          ; Identifier scan is the native mirror of vm_scan_identifier_token():  ; [section code]
----                              757          ; walk identifier-continue bytes, lowercase ASCII letters for the demo  ; [section code]
----                              758          ; policy, then emit one identifier record backed by scratch bytes.  ; [section code]
057A    25 42 00 08               759          MOVE.L D2, LOCAL_PENDING_START(A2)  ; [section code]
057E    42 AA 00 10               760          CLR.L LOCAL_PENDING_LEX_LEN(A2)  ; [section code]
0582    20 4E                     761          MOVEA.L A6, A0  ; [section code]
0584    D1 C3                     762          ADDA.L D3, A0  ; [section code]
----                              763    ; [section code]
----                              764  tokvmScanIdentifierLoop  ; [section code]
----                              765          ; D2 stays as the source cursor, A0 walks the next free scratch byte,  ; [section code]
----                              766          ; and LOCAL_PENDING_LEX_LEN grows in lockstep so commit can later write  ; [section code]
----                              767          ; both the source span and scratch payload length into the token record.  ; [section code]
0586    B4 84                     768          CMP.L D4, D2  ; [section code]
0588    64 00 00 46               769          BCC tokvmScanIdentifierDone  ; [section code]
058C    70 00                     770          MOVEQ #0, D0  ; [section code]
058E    10 34 28 00               771          MOVE.B 0(A4, D2.L), D0  ; [section code]
0592    4E B9 00 00 0C C8         772          JSR tokvmIsIdentifierContinue  ; mirrors vm_matches_identifier_continue_class()  ; [section code]
0598    4A 80                     773          TST.L D0  ; [section code]
059A    67 00 00 34               774          BEQ tokvmScanIdentifierDone  ; [section code]
059E    20 03                     775          MOVE.L D3, D0  ; [section code]
05A0    D0 AA 00 10               776          ADD.L LOCAL_PENDING_LEX_LEN(A2), D0  ; [section code]
05A4    B0 86                     777          CMP.L D6, D0  ; [section code]
05A6    64 00 06 D0               778          BCC tokvmPendingLexemeOverflowFromScan  ; [section code]
05AA    70 00                     779          MOVEQ #0, D0  ; [section code]
05AC    10 34 28 00               780          MOVE.B 0(A4, D2.L), D0  ; [section code]
05B0    0C 00 00 41               781          CMPI.B #'A', D0  ; [section code]
05B4    65 00 00 0E               782          BLO tokvmCopyIdentifierByte  ; [section code]
05B8    0C 00 00 5A               783          CMPI.B #'Z', D0  ; [section code]
05BC    62 00 00 06               784          BHI tokvmCopyIdentifierByte  ; [section code]
05C0    00 00 00 20               785          ORI.B #$20, D0  ; native demo bakes in ASCII-lower identifier normalization used by the Rust bridge tests  ; [section code]
----                              786  tokvmCopyIdentifierByte  ; [section code]
05C4    10 C0                     787          MOVE.B D0, (A0)+  ; [section code]
05C6    52 82                     788          ADDQ.L #1, D2  ; [section code]
05C8    52 AA 00 10               789          ADDQ.L #1, LOCAL_PENDING_LEX_LEN(A2)  ; [section code]
05CC    60 00 FF B8               790          BRA tokvmScanIdentifierLoop  ; [section code]
