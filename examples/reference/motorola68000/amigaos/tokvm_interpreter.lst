----                             3047  ; Native AmigaOS 68020-baseline tokenizer VM executable.
----                             3048  ;
----                             3049  ; This root file is now a true composition module: it owns only the Amiga entry
----                             3050  ; path and pulls the CLI harness and tokenizer VM in through `.use`.
----                             3051  
----                             3052          .module main
----                             3053          .cpu 68020
----                             3054          .use tokvm.amigaos.cli_harness (SysBase, pr_CLI, pr_MsgPort)
----                             3055          .use tokvm.amigaos.cli_harness (FindTask, WaitPort, GetMsg, ReplyMsg, Forbid)
----                             3056          .use tokvm.amigaos.cli_harness (RETURN_WORKBENCH_UNSUPPORTED, tokvm_amigaos_cli_harness_run)
----                             3057          .use tokvm.amigaos.tokenizer_vm (abiMarker)
----                             3058  
----                             3059          .section entry, kind=code  ; [section entry]
----                             3060    ; [section entry]
----                             3061  ; ---------------------------------------------------------------------------  ; [section entry]
----                             3062  ; AmigaOS process entry.  ; [section entry]
----                             3063  ;  ; [section entry]
----                             3064  ; Workbench launches are rejected because this first native slice is a Shell  ; [section entry]
----                             3065  ; tool with a narrow CLI/file-I/O contract. Once CLI execution is confirmed, we  ; [section entry]
----                             3066  ; hand off to the imported tokvm.amigaos.cli_harness module.  ; [section entry]
----                             3067  ; ---------------------------------------------------------------------------  ; [section entry]
----                             3068    ; [section entry]
----                             3069  start  ; [section entry]
0000    48 E7 3F 3E              3070          MOVEM.L D2-D7/A2-A6, -(SP)  ; preserve callee-owned state across the CLI harness call  ; [section entry]
0004    42 82                    3071          CLR.L D2  ; no Workbench startup message is pending until GetMsg succeeds  ; [section entry]
