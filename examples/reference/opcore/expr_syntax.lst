042C    A6 22                     242          ldx ZP_BASE + 2         ; load X
042E    A4 23                     243          ldy ZP_BASE + 3         ; load Y
0430    65 24                     244          adc ZP_BASE + 4         ; add with carry
0432    E5 25                     245          sbc ZP_BASE + 5         ; subtract with borrow
0434    25 26                     246          and ZP_BASE + 6         ; AND
0436    05 27                     247          ora ZP_BASE + 7         ; OR
0438    45 28                     248          eor ZP_BASE + 8         ; XOR
043A    E6 29                     249          inc ZP_BASE + 9         ; increment memory
043C    C6 2A                     250          dec ZP_BASE + 10        ; decrement memory
043E    24 2B                     251          bit ZP_BASE + 11        ; bit test
0440    06 2C                     252          asl ZP_BASE + 12        ; arithmetic shift left
0442    46 2D                     253          lsr ZP_BASE + 13        ; logical shift right
0444    26 2E                     254          rol ZP_BASE + 14        ; rotate left
0446    66 2F                     255          ror ZP_BASE + 15        ; rotate right
