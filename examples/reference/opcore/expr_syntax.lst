----                               99  ; Combining hi/lo bytes needs intermediate constants
----    EQU 0020                  100  TABLE_HI        .const  >TABLE
----    EQU 0000                  101  TABLE_LO        .const  <TABLE
----    EQU 2000                  102  TABLE_COMBINED  .const  (TABLE_HI << 8) | TABLE_LO  ; same as TABLE
----                              103  
0026    00 20                     104          .word TABLE_COMBINED   ; reconstructed from hi/lo
