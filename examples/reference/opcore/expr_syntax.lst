----                              406  
----                              407  ; ============================================================================
----                              408  ; PART 3: Expression edge cases and complex expressions
----                              409  ; ============================================================================
----                              410          .cpu 65c02
----    EQU 0800                  411          .org $0800
----                              412  
----                              413  ; Nested expressions
----    EQU 0015                  414  nested1         .const  ((1 + 2) * (3 + 4))     ; = 21
----    EQU 000C                  415  nested2         .const  (((1 << 2) | 8) & $0f)  ; = 12
----    EQU 000A                  416  nested3         .const  (5 > 3) ? ((2 + 3) * 2) : 0  ; = 10
----                              417  
----                              418  ; Chained operations
----    EQU 000F                  419  chain1          .const  1 + 2 + 3 + 4 + 5       ; = 15
----    EQU 003F                  420  chain2          .const  $ff & $0f | $30         ; = $3f
----    EQU 0008                  421  chain3          .const  1 << 2 << 1             ; = 8
----                              422  
----                              423  ; Labels referencing labels
----    EQU 0020                  424  derived1        .const  BASE * 2                ; = $20
----    EQU 0025                  425  derived2        .const  derived1 + OFFSET       ; = $25
----    EQU 00A5                  426  derived3        .const  derived2 | $80          ; = $a5
----                              427  
----                              428  ; Using expressions in instructions
0800    A9 15                     429          lda #nested1
0802    A9 0C                     430          lda #nested2
0804    A9 0A                     431          lda #nested3
0806    A9 0F                     432          lda #chain1
0808    A9 3F                     433          lda #chain2
080A    A9 20                     434          lda #derived1
080C    A9 25                     435          lda #derived2
----                              436  
----                              437  ; Address arithmetic with current location
----                              438  addr_base
080E    00                        439          .byte $+0 - addr_base   ; offset 0
080F    01                        440          .byte $+0 - addr_base   ; offset 1
0810    02                        441          .byte $+0 - addr_base   ; offset 2
0811    03                        442          .byte $+0 - addr_base   ; offset 3
----                              443  
----                              444  ; Expression results in data
0812    15 0C 0A                  445          .byte nested1, nested2, nested3
0815    0F 3F 08                  446          .byte chain1, chain2, chain3
0818    20 25 A5                  447          .byte derived1, derived2, derived3
----                              448  
