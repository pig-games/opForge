----                              210  ; ============================================================================
----                              211  ; 6502 IMMEDIATE MODE: LDA #imm
----                              212  ; ============================================================================
----                              213  m6502_imm
0400    A9 10                     214          lda #BASE               ; label
0402    A9 15                     215          lda #BASE + OFFSET      ; expression
0404    A9 10                     216          lda #>ABS_BASE          ; high byte
0406    A9 00                     217          lda #<ABS_BASE          ; low byte
0408    A9 07                     218          lda #MASK & $07         ; bitwise AND
040A    A9 1F                     219          lda #MASK | $10         ; bitwise OR
040C    A9 08                     220          lda #1 << 3             ; shift left
040E    A9 20                     221          lda #$80 >> 2           ; shift right
0410    A9 0F                     222          lda #10 + 5             ; addition
0412    A9 0C                     223          lda #20 - 8             ; subtraction
0414    A9 0C                     224          lda #3 * 4              ; multiplication
0416    A9 14                     225          lda #100 / 5            ; division
0418    A9 0F                     226          lda #(~$f0) & $ff       ; bitwise NOT masked to byte
041A    A9 FF                     227          lda #(-1) & $ff         ; negative masked to byte ($ff)
041C    A9 AA                     228          lda #(5 > 3) ? $aa : $55    ; ternary
