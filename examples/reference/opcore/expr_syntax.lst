003D    4C 4C 00                  119          jmp jump_target         ; forward reference
0040    4C 00 20                  120          jmp TABLE               ; label as address
0043    4C 50 12                  121          jmp PAGE + $50          ; expression as address
----                              122          
0046    20 4D 00                  123          jsr call_target        ; forward reference
0049    20 00 22                  124          jsr TABLE + $200       ; expression as address
