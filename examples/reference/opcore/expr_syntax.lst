0031    8D 10 20                  113          sta TABLE + $10         ; store with offset
----                              114          
0034    AD 00 20                  115          lda TABLE              ; load direct
0037    AD 80 12                  116          lda PAGE + $80         ; with expression
003A    8D 00 21                  117          sta TABLE + $100       ; store direct
