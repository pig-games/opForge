ADDR    BYTES                    LINE  SOURCE
------  -----------------------  ----  ------
----                                1  .module expr_syntax
----                                2  ; Expression syntax coverage for 64tass-style operators and literals
----                                3  ; Tests expressions and labels in addressing modes for 6502/65C02.
----                                4  
----                                5  ; ============================================================================
----                                6  ; PART 1: 65C02 expressions in addressing modes
----                                7  ; ============================================================================
----                                8          .cpu 65c02
----    EQU 0000                    9          .org 0000h
----                               10  
----                               11  ; --- Constants and labels for expression testing ---
----    EQU 0010                   12  BASE            .const  $10
----    EQU 0005                   13  OFFSET          .const  $05
----    EQU 000F                   14  MASK            .const  $0F
----    EQU 1200                   15  PAGE            .const  $1200
----    EQU 2000                   16  TABLE           .const  $2000
----                               17  
----                               18  ; Numeric literal formats
----    EQU 007B                   19  num_dec         .const  123
----    EQU 00A6                   20  num_hex         .const  0a6h
----    EQU 001F                   21  num_hex_pref    .const  $1f
----    EQU 000A                   22  num_bin         .const  1010b
----    EQU 000A                   23  num_bin_pref    .const  %1010       ; % prefix for binary
----    EQU 00F0                   24  num_bin_long    .const  %11110000   ; longer binary value
----    EQU 000F                   25  num_oct         .const  17o
----    EQU 000F                   26  num_oct_q       .const  17q
----                               27  
----                               28  ; Digit separators with underscore
----    EQU 0F4240                 29  num_sep_dec     .const  1_000_000   ; decimal with separators
----    EQU FF00                   30  num_sep_hex     .const  $FF_00      ; hex with separators
----    EQU 00F0                   31  num_sep_bin     .const  %1111_0000  ; binary with separators
----    EQU 00F0                   32  num_sep_suf     .const  1111_0000b  ; suffix binary with separators
----                               33  
----                               34  ; Unary operators
----    EQU 0012                   35  hi_byte         .const  >$1234
----    EQU 0034                   36  lo_byte         .const  <$1234
----    EQU 0001                   37  not_zero        .const  !0
----    EQU 0000                   38  not_one         .const  !1
----    EQU FFFFFF00               39  bit_not         .const  ~$00ff
----    EQU FFFFFFFF               40  neg_one         .const  -1
----                               41  
----                               42  ; Arithmetic and shifts
----    EQU 0008                   43  pow1            .const  2 ** 3
----    EQU 0051                   44  pow2            .const  3 ** 2 ** 2
----    EQU 0010                   45  shift_l         .const  1 << 4
----    EQU 000F                   46  shift_r         .const  $ff >> 4
----                               47  
----                               48  ; Comparisons
----    EQU 0001                   49  cmp_eq          .const  (3 == 3)
----    EQU 0001                   50  cmp_ne          .const  (3 != 4)
----    EQU 0001                   51  cmp_ne_alt      .const  (3 <> 4)
----    EQU 0001                   52  cmp_le          .const  (3 <= 4)
----    EQU 0001                   53  cmp_lt          .const  (3 < 4)
----    EQU 0001                   54  cmp_ge          .const  (4 >= 3)
----    EQU 0001                   55  cmp_gt          .const  (4 > 3)
----                               56  
----                               57  ; Bitwise and logical
----    EQU 0000                   58  bit_and         .const  ($f0 & $0f)
----    EQU 00FF                   59  bit_or          .const  ($f0 | $0f)
----    EQU 00FF                   60  bit_xor         .const  ($f0 ^ $0f)
----    EQU 0001                   61  log_and         .const  (2 && 3)
----    EQU 0001                   62  log_or          .const  (0 || 3)
----    EQU 0000                   63  log_xor         .const  (2 ^^ 3)
----                               64  
----                               65  ; Ternary
----    EQU 0002                   66  ternary1        .const  0 ? 1 : 2
----    EQU 0007                   67  ternary2        .const  5 ? 7 : 9
----    EQU 0005                   68  ternary3        .const  (0 || 1) ? (2 + 3) : (4 + 5)
----                               69  
----                               70  ; String constants
----    EQU 0041                   71  char_a          .const  'A'
----    EQU 4142                   72  char_ab         .const  'AB'
----                               73  
----                               74  ; ============================================================================
----                               75  ; 65C02 immediate expressions and emitted 16-bit expression values
----                               76  ; ============================================================================
----                               77  mos_imm
0000    A9 10                      78          lda #BASE             ; label
0002    A9 15                      79          lda #BASE + OFFSET    ; expression with labels
0004    A9 12                      80          lda #>PAGE            ; high byte operator
0006    A9 00                      81          lda #<PAGE            ; low byte operator
0008    A9 07                      82          lda #MASK & $07       ; bitwise AND
000A    A9 1F                      83          lda #MASK | $10       ; bitwise OR
000C    A9 08                      84          lda #1 << 3           ; shift left
000E    A9 20                      85          lda #$80 >> 2         ; shift right
0010    A9 0F                      86          lda #10 + 5           ; addition
0012    A9 0C                      87          lda #20 - 8           ; subtraction
0014    A9 0C                      88          lda #3 * 4            ; multiplication
0016    A9 14                      89          lda #100 / 5          ; division
0018    A9 0F                      90          lda #(~$f0) & $ff     ; bitwise NOT (result: $0f)
001A    A9 FF                      91          lda #(-1) & $ff       ; negative masked to byte (result: $ff)
001C    A9 AA                      92          lda #(5 > 3) ? $aa : $55  ; ternary
----                               93          
001E    00 20                      94          .word TABLE            ; 16-bit label
0020    34 12                      95          .word PAGE + $34       ; 16-bit expression
0022    0A 20                      96          .word TABLE + (OFFSET * 2)  ; complex expression
0024    34 12                      97          .word $1000 + $234     ; direct arithmetic
