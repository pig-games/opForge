219D    61                        166          .byte      'a'             ; ADD command
219E    00 01                     167          .word      0100h           ; Handler address
21A0    65                        168          .byte      'e'             ; EXAMINE command
21A1    42 01                     169          .word      0142h
21A3    70                        170          .byte      'p'             ; PRINT command
21A4    20 02                     171          .word      0220h
21A6    73                        172          .byte      's'             ; STEP command
21A7    34 03                     173          .word      0334h
21A9    78                        174          .byte      'x'             ; EXIT command
21AA    34 04                     175          .word      0434h
