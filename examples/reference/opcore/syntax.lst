----                              125  ; Operators and precedence (highest to lowest):
----                              126  ;   unary: + - ~ ! < >
----                              127  ;   power: **
----                              128  ;   * / %
----                              129  ;   + -
----                              130  ;   shifts: << >>
----                              131  ;   comparisons: == != <> < <= > >= (also =)
----                              132  ;   bitwise: & ^ |
----                              133  ;   logical: && ^^ ||
----                              134  ;   ternary: ?:
----                              135  PREC
2172    0F 00                     136          .word      (8+7)           ; Parenthesis have highest precedence
2174    FF FF                     137          .word      -1              ; unary plus/minus
2176    02                        138          .byte      >512            ; high byte
2177    00                        139          .byte      <512            ; low byte
2178    08 00                     140          .word      2 ** 3          ; power
217A    02 00                     141          .word      100 / 10 % 4    ; multiply/divide/mod
217C    09 00                     142          .word      2 + 8 - 1       ; add/subtract
217E    01 00                     143          .word      2 <= 3          ; comparisons
2180    03 00                     144          .word      23H & 0FH       ; bitwise AND
2182    F3 00                     145          .word      23H | 0FH ^ 0FFH; bitwise OR/XOR
2184    01 00                     146          .word      !0              ; logical NOT
2186    00 00                     147          .word      1 && 0          ; logical AND
2188    01 00                     148          .word      1 ^^ 0          ; logical XOR
218A    02 00                     149          .word      1 ? 2 : 3       ; ternary
