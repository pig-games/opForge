----                               99  ; The .word directive stores one or more 16 bit values.
20D1    03 02                     100  words1 .word      0203h           ; One word value in hex
20D3    B4 1A                     101  words2 .word      num4            ; One word value in decimal
20D5    55 AA                     102  words3 .word      1010101001010101B ; One word value in binary
20D7    02 00 03 00               103  words4 .word      02h, 03h        ; Two word values
20DB    02 00 03 00 FF 04         104  words5 .word      02h, 03, 04ffh  ; Three word values
----                              105  
----                              106  ; Note that .word stores the two octet values in 6502 little-endian order, so
----                              107  ; the following two declarations are equivalent:
20E1    34 12                     108          .word      01234h
20E3    34 12                     109          .byte      034h, 012h
