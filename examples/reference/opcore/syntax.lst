----                              272  
----                              273  ; Labels and conditionals
----                              274  ; Any of the conditional directives (.if/.elseif/.else/.endif) can have a label.
----                              275  ; This label will be included in the symbol table as long as the directive is
----                              276  ; processed.  It does not matter if the directive evaluates to TRUE.
----                              277  ; A label will not be included in the symbol table if the directive is nested
----                              278  ; within another .if block that is false because the nested directive is not
----                              279  ; evaluated in that case.
----                              280  IFLAB  .if TRUE                        ; label included
F012    4C 0A 1A                  281                  jmp 6666
----                              282  ELSELAB .else                           ; label included
----                              283                  tax
----                              284  NOLAB1         jmp 3333                ; labels ignored because they are nested in
----                              285  NOLAB2   .if YES                       ; the .else above that did not match
----                              286  NOLAB3         jmp 1111
----                              287  NOLAB4   .endif
----                              288  ENDLAB .endif                          ; label included

