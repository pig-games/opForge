----                              223  
----                              224  
----                              225  ; TRUE/FALSE values in conditionals
----                              226  ; Any non-zero value is TRUE, zero is FALSE.
----                              227          .if 0                           ; FALSE
----                              228                  adc #11h
----                              229          .elseif 4                       ; TRUE
1001    69 22                     230                  adc #22h
----                              231          .elseif 4-4                     ; skipped (previous branch matched)
