----                                1  .module syntax
----                                2  ; The assembler runs two passes over the source file.  The first pass builds
----                                3  ; the symbol table and the second emits the hex file and list file.
----                                4  ;
----                                5  ; Note that the assembler is case-insensitive for instructions, directives,
----                                6  ; register names, and labels.  The labels "label2" and "LABEL2" are the same,
----                                7  ; and an error would be thrown if both were defined.
----                                8          .cpu 65c02
----                                9   
----                               10  ; The .org directive sets the current address for assembly.  A file can
----                               11  ; contain more than one .org.  The assembler does not detect overlapping
----                               12  ; .org directives and will silently overwrite output in that case.
----    EQU 2000                   13          .org     RAMST + 02000h
----                               14  
----                               15  
----                               16  ; Column one must contain whitespace or a label or a comment start.
----                               17  ; Labels can be up to 32 characters and must start with an alpha.  
----                               18  ; Numbers and the underscore character are permitted in a label.
----                               19  ; Labels can end with a colon, but the colon is optional.
2000    7B                         20  LABEL1 .byte      123             ; labels can be on the same line as code
----                               21  LABEL2
2001    68                         22          pla                     ; or the label can be before the code
2002    48                         23  NOSPACE pha                     ; a space is not required after a label
----                               24  VeryVeryVeryLongLabel
2003    4C 61 62 65 6C 73 20 63 61 6E 20 62 65 20 75 70 20 74 6F 20 33 32 20 63 68 61 72 61 63 74 65 72 73 20 26 26 20 6D 75 73 74 20 73 74 61 72 74 20 77 69 74 68 20 61 6E 20 61 6C 70 68 61 2E    25      .byte  "Labels can be up to 32 characters && must start with an alpha."
----                               26  
----                               27  ; Expression operators are symbolic, so names like HIGH, LOW, AND, or OR can be
----                               28  ; used as labels if desired.
----                               29  
----                               30  ; The .const directive is used to define a constant value.  It does not emit
----                               31  ; any code.  The label colon is optional for .const, and the label must be
----                               32  ; followed by whitespace.
----    EQU 0000                   33  RAMST   .const     00000h          
----    EQU C000                   34  ROMST   .const     0c000h         
----                               35  
----                               36  ; Constants can be decimal, binary, hex, or octal.  Binary is indicated with a
----                               37  ; trailing 'b' hex with a trailing 'h', and octal with a trailing 'o' or 'q'
----                               38  ; character.  Decimal constants can have a trailing 'd' character, but it is
----                               39  ; not required.  All constants must start with a numeric character, so hex 
----                               40  ; values starting with A-F must have a leading zero.
----    EQU 0037                   41  num0    .const     55              ; Decimal constant
----    EQU 0037                   42  num1    .const     55D             ; Decimal constant with optional suffix
----    EQU 00A6                   43  num3    .const     0a6h            ; Hex with leading zero
----    EQU 1AB4                   44  num4    .const     1AB4H           ; Hex without leading zero
----    EQU 0065                   45  num5    .const     01100101b       ; Binary
----    EQU 02EF                   46  num6    .const     1357o           ; Octal with trailing 'o'
----    EQU 0209                   47  num7    .const     1011Q           ; Octal with trailing 'q'
----                               48  
----                               49  ; The .byte directive places one or more bytes of data in the output.
2041    05                         50  d1     .byte      5               ; single byte
2042    12 34 56 78                51  d2     .byte      12h,34h,56h,78h ; multiple bytes
2046    05 2A 0B                   52  d3     .byte      5, 02Ah, 1011B  ; Mixed decimal, hex, and binary
----                               53  
----                               54  ; The .byte directive can also be used with strings.  Each octet in the string
----                               55  ; generates one octet of output.  Strings and numeric constants can be mixed
----                               56  ; in a single directive.
2049    54                         57  str1   .byte      'T'             ; Single character constant
204A    57 65 6C 63 6F 6D 65       58  str2   .byte      "Welcome"       ; String constant
2051    72 65 64 67 72 65 65 6E    59  str3   .byte      "red","green"   ; Multiple strings
2059    03 72 65 64 04 62 6C 75 65    60  str4   .byte      3,"red",4,"blue"; Mixed strings and numerics
----                               61  
----                               62  ; Note that a single character string can also be used anywhere a numeric
----                               63  ; would be allowed.  It evaluates to the ASCII value of the single character.
2062    A9 41                      64          lda #65                 ; Move the letter 'A' into the accumulator.
2064    A9 41                      65          lda #041H               ; Move the letter 'A' into the accumulator.
2066    A9 41                      66          lda #'A'                ; Move the letter 'A' into the accumulator.
----                               67  
----                               68  ; A two character string can also be used anywhere a numeric would be allowed.
----                               69  ; It evaluates to the 16-bit value of ASCII value of the two characters, where
----                               70  ; the MSB is the first char and the LSB is the second.
2068    42 41                      71          .word 04142H            ; All of these evaluate to 4142H
206A    41 42                      72          .word 'AB'              ; All of these evaluate to 4142H
206C    41 42                      73          .word "AB"              ; All of these evaluate to 4142H
206E    42 41                      74          .word 'A'*256 | 'B'     ; All of these evaluate to 4142H
----                               75  
----                               76  
----                               77  ; Some common C-style string escapes are supported: CR, LF, tab, NULL, and
----                               78  ; hex value.  Hex escapes can use upper or lower case and must be 2 digits.
2070    0D 0A 09 2A 2B 00          79      .byte  "\r\n\t\x2a\x2B\0"
----                               80  
----                               81  ; The backslash can also be used to escape quotes or the backslash character
----                               82  ; itself.  Embedded quotes can also be handled by placing double quotes
----                               83  ; inside single quotes or single quotes inside double quotes.
2076    5C                         84      .byte  '\\'                    ; Backslash character.
2077    27                         85      .byte  '\''                    ; Single quote character.
2078    27                         86      .byte  "'"                     ; Same string using double quotes.
2079    41 20 22 71 75 6F 74 65 64 22 20 73 74 72 69 6E 67    87      .byte  "A \"quoted\" string"   ; Quotes within quotes.
208A    41 20 22 71 75 6F 74 65 64 22 20 73 74 72 69 6E 67    88      .byte  'A "quoted" string'     ; Same string using single quotes.
209B    54 68 69 73 20 69 73 6E 27 74 20 62 61 64    89      .byte  "This isn't bad"        ; Single quote in double quotes.
----                               90      
----                               91  ; The following .byte directives are all equivalent  
----    EQU 000D                   92  CR  .const 13
----    EQU 000A                   93  LF  .const '\n'
20A9    41 42 43 31 32 33 0D 0A    94      .byte  "ABC123\r\n"
20B1    41 42 43 31 32 33 0D 0A    95      .byte  "ABC123",CR,LF
20B9    41 42 43 31 32 33 0D 0A    96      .byte  "ABC123",13,10
20C1    41 42 43 31 32 33 0D 0A    97      .byte  'A','B','C','1','2','3','\r','\n'
20C9    41 42 43 31 32 33 0D 0A    98      .byte  "ABC",31h,32h,"3",'\r',LF
----                               99  
----                              100  ; The .word directive stores one or more 16 bit values.
20D1    03 02                     101  words1 .word      0203h           ; One word value in hex
20D3    B4 1A                     102  words2 .word      num4            ; One word value in decimal
20D5    55 AA                     103  words3 .word      1010101001010101B ; One word value in binary
20D7    02 00 03 00               104  words4 .word      02h, 03h        ; Two word values
20DB    02 00 03 00 FF 04         105  words5 .word      02h, 03, 04ffh  ; Three word values
----                              106  
----                              107  ; Note that .word stores the two octet values in 6502 little-endian order, so
----                              108  ; the following two declarations are equivalent:
20E1    34 12                     109          .word      01234h
20E3    34 12                     110          .byte      034h, 012h
----                              111  
----                              112  ; The .ds directive reserves space, but does not generate any output.  It
----                              113  ; simply advances the target address for the next code or data.
----    EQU 0020                  114  StrSize .const     32
20E5    +0080                     115  buffer .ds  StrSize * 4     ; Reserve space for 4 strings
----                              116  
----                              117  ; Expressions can be used in place of any numeric constant.
2165    00 0C                     118  t      .word      1024 * 3
2167    82 00                     119          .word 32 * 4 + 2
2169    5E 20                     120          .word str4 + 5
216B    05 21                     121          .word buffer + StrSize
216D    39                        122          .byte      7+7*7+7/(7+7-7)
216E    A9 61                     123          lda #'A' | 020H
2170    A9 41                     124          lda #'a' & 11011111b
----                              125  
----                              126  ; Operators and precedence (highest to lowest):
----                              127  ;   unary: + - ~ ! < >
----                              128  ;   power: **
----                              129  ;   * / %
----                              130  ;   + -
----                              131  ;   shifts: << >>
----                              132  ;   comparisons: == != <> < <= > >= (also =)
----                              133  ;   bitwise: & ^ |
----                              134  ;   logical: && ^^ ||
----                              135  ;   ternary: ?:
----                              136  PREC
2172    0F 00                     137          .word      (8+7)           ; Parenthesis have highest precedence
2174    FF FF                     138          .word      -1              ; unary plus/minus
2176    02                        139          .byte      >512            ; high byte
2177    00                        140          .byte      <512            ; low byte
2178    08 00                     141          .word      2 ** 3          ; power
217A    02 00                     142          .word      100 / 10 % 4    ; multiply/divide/mod
217C    09 00                     143          .word      2 + 8 - 1       ; add/subtract
217E    01 00                     144          .word      2 <= 3          ; comparisons
2180    03 00                     145          .word      23H & 0FH       ; bitwise AND
2182    F3 00                     146          .word      23H | 0FH ^ 0FFH; bitwise OR/XOR
2184    01 00                     147          .word      !0              ; logical NOT
2186    00 00                     148          .word      1 && 0          ; logical AND
2188    01 00                     149          .word      1 ^^ 0          ; logical XOR
218A    02 00                     150          .word      1 ? 2 : 3       ; ternary
----                              151  
----                              152  ; Logical operators treat any non-zero value as TRUE and return 1 (true) or 0 (false).
218C    01                        153          .byte      !0              ; TRUE
218D    00                        154          .byte      !1              ; FALSE
218E    01                        155          .byte      2 && 3          ; TRUE
218F    01                        156          .byte      0 || 4          ; TRUE
2190    00                        157          .byte      2 ^^ 3          ; FALSE
