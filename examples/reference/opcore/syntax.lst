----                                1  ; The assembler runs two passes over the source file.  The first pass builds
----                                2  ; the symbol table and the second emits the hex file and list file.
----                                3  ;
----                                4  ; Note that the assembler is case-insensitive for instructions, directives,
----                                5  ; register names, and labels.  The labels "label2" and "LABEL2" are the same,
----                                6  ; and an error would be thrown if both were defined.
----                                7          .cpu 65c02
----                                8   
----                                9  ; The .org directive sets the current address for assembly.  A file can
----                               10  ; contain more than one .org.  The assembler does not detect overlapping
----                               11  ; .org directives and will silently overwrite output in that case.
----    EQU 2000                   12          .org     RAMST + 02000h
----                               13  
----                               14  
----                               15  ; Column one must contain whitespace or a label or a comment start.
----                               16  ; Labels can be up to 32 characters and must start with an alpha.  
----                               17  ; Numbers and the underscore character are permitted in a label.
----                               18  ; Labels can end with a colon, but the colon is optional.
2000    7B                         19  LABEL1 .byte      123             ; labels can be on the same line as code
----                               20  LABEL2
2001    68                         21          pla                     ; or the label can be before the code
2002    48                         22  NOSPACE pha                     ; a space is not required after a label
----                               23  VeryVeryVeryLongLabel
2003    4C 61 62 65 6C 73 20 63 61 6E 20 62 65 20 75 70 20 74 6F 20 33 32 20 63 68 61 72 61 63 74 65 72 73 20 26 26 20 6D 75 73 74 20 73 74 61 72 74 20 77 69 74 68 20 61 6E 20 61 6C 70 68 61 2E    24      .byte  "Labels can be up to 32 characters && must start with an alpha."
----                               25  
----                               26  ; Expression operators are symbolic, so names like HIGH, LOW, AND, or OR can be
----                               27  ; used as labels if desired.
----                               28  
----                               29  ; The .const directive is used to define a constant value.  It does not emit
----                               30  ; any code.  The label colon is optional for .const, and the label must be
----                               31  ; followed by whitespace.
----    EQU 0000                   32  RAMST   .const     00000h          
----    EQU C000                   33  ROMST   .const     0c000h         
----                               34  
----                               35  ; Constants can be decimal, binary, hex, or octal.  Binary is indicated with a
----                               36  ; trailing 'b' hex with a trailing 'h', and octal with a trailing 'o' or 'q'
----                               37  ; character.  Decimal constants can have a trailing 'd' character, but it is
----                               38  ; not required.  All constants must start with a numeric character, so hex 
----                               39  ; values starting with A-F must have a leading zero.
----    EQU 0037                   40  num0    .const     55              ; Decimal constant
----    EQU 0037                   41  num1    .const     55D             ; Decimal constant with optional suffix
----    EQU 00A6                   42  num3    .const     0a6h            ; Hex with leading zero
----    EQU 1AB4                   43  num4    .const     1AB4H           ; Hex without leading zero
----    EQU 0065                   44  num5    .const     01100101b       ; Binary
----    EQU 02EF                   45  num6    .const     1357o           ; Octal with trailing 'o'
----    EQU 0209                   46  num7    .const     1011Q           ; Octal with trailing 'q'
----                               47  
----                               48  ; The .byte directive places one or more bytes of data in the output.
2041    05                         49  d1     .byte      5               ; single byte
2042    12 34 56 78                50  d2     .byte      12h,34h,56h,78h ; multiple bytes
2046    05 2A 0B                   51  d3     .byte      5, 02Ah, 1011B  ; Mixed decimal, hex, and binary
----                               52  
----                               53  ; The .byte directive can also be used with strings.  Each octet in the string
----                               54  ; generates one octet of output.  Strings and numeric constants can be mixed
----                               55  ; in a single directive.
2049    54                         56  str1   .byte      'T'             ; Single character constant
204A    57 65 6C 63 6F 6D 65       57  str2   .byte      "Welcome"       ; String constant
2051    72 65 64 67 72 65 65 6E    58  str3   .byte      "red","green"   ; Multiple strings
2059    03 72 65 64 04 62 6C 75 65    59  str4   .byte      3,"red",4,"blue"; Mixed strings and numerics
----                               60  
----                               61  ; Note that a single character string can also be used anywhere a numeric
----                               62  ; would be allowed.  It evaluates to the ASCII value of the single character.
2062    A9 41                      63          lda #65                 ; Move the letter 'A' into the accumulator.
2064    A9 41                      64          lda #041H               ; Move the letter 'A' into the accumulator.
2066    A9 41                      65          lda #'A'                ; Move the letter 'A' into the accumulator.
----                               66  
----                               67  ; A two character string can also be used anywhere a numeric would be allowed.
----                               68  ; It evaluates to the 16-bit value of ASCII value of the two characters, where
----                               69  ; the MSB is the first char and the LSB is the second.
2068    42 41                      70          .word 04142H            ; All of these evaluate to 4142H
206A    41 42                      71          .word 'AB'              ; All of these evaluate to 4142H
206C    41 42                      72          .word "AB"              ; All of these evaluate to 4142H
206E    42 41                      73          .word 'A'*256 | 'B'     ; All of these evaluate to 4142H
----                               74  
----                               75  
----                               76  ; Some common C-style string escapes are supported: CR, LF, tab, NULL, and
----                               77  ; hex value.  Hex escapes can use upper or lower case and must be 2 digits.
2070    0D 0A 09 2A 2B 00          78      .byte  "\r\n\t\x2a\x2B\0"
----                               79  
----                               80  ; The backslash can also be used to escape quotes or the backslash character
----                               81  ; itself.  Embedded quotes can also be handled by placing double quotes
----                               82  ; inside single quotes or single quotes inside double quotes.
2076    5C                         83      .byte  '\\'                    ; Backslash character.
2077    27                         84      .byte  '\''                    ; Single quote character.
2078    27                         85      .byte  "'"                     ; Same string using double quotes.
2079    41 20 22 71 75 6F 74 65 64 22 20 73 74 72 69 6E 67    86      .byte  "A \"quoted\" string"   ; Quotes within quotes.
208A    41 20 22 71 75 6F 74 65 64 22 20 73 74 72 69 6E 67    87      .byte  'A "quoted" string'     ; Same string using single quotes.
209B    54 68 69 73 20 69 73 6E 27 74 20 62 61 64    88      .byte  "This isn't bad"        ; Single quote in double quotes.
----                               89      
----                               90  ; The following .byte directives are all equivalent  
----    EQU 000D                   91  CR  .const 13
----    EQU 000A                   92  LF  .const '\n'
20A9    41 42 43 31 32 33 0D 0A    93      .byte  "ABC123\r\n"
20B1    41 42 43 31 32 33 0D 0A    94      .byte  "ABC123",CR,LF
20B9    41 42 43 31 32 33 0D 0A    95      .byte  "ABC123",13,10
20C1    41 42 43 31 32 33 0D 0A    96      .byte  'A','B','C','1','2','3','\r','\n'
20C9    41 42 43 31 32 33 0D 0A    97      .byte  "ABC",31h,32h,"3",'\r',LF
