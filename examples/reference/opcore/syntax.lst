----    EQU F000                  237                  .org 0f000h
----                              238          .if FALSE                       ; level 1 - skip
----                              239            .if 0 != 1                    ; level 2 - skip
----                              240  LABEL1         ora #03h                ; label and code skipped
----                              241                  jmp 45
----                              242            .elseif FALSE                 ; level 2 - skip
